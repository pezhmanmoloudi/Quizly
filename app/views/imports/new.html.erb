<% content_for :title, "Import Cards — #{@deck.name}" %>

<div class="container" style="padding-top: 2rem; padding-bottom: 3rem; max-width: 680px;">
  <div class="section-header">
    <h1>Import Cards</h1>
    <%= link_to "← #{@deck.name}", @deck, class: "section-header__link" %>
  </div>

  <% if flash[:alert] %>
    <div class="flash flash--alert" style="margin-bottom: 1rem;"><%= flash[:alert] %></div>
  <% end %>

  <div class="import-tabs"
       data-controller="import"
       data-import-active-tab-value="<%= @tab %>">

    <div class="import-tabs__nav" role="tablist">
      <button class="import-tab-btn"
              role="tab"
              data-import-target="tabBtn"
              data-tab="text"
              data-action="click->import#switchTab"
              aria-selected="<%= @tab == "text" %>">
        Text
      </button>
      <button class="import-tab-btn"
              role="tab"
              data-import-target="tabBtn"
              data-tab="csv"
              data-action="click->import#switchTab"
              aria-selected="<%= @tab == "csv" %>">
        CSV file
      </button>
    </div>

    <%# TEXT TAB %>
    <div class="import-panel"
         data-import-target="panel"
         data-tab="text"
         <%= "hidden" if @tab != "text" %>>

      <p class="import-panel__hint">
        Paste one card per line. Separate front and back with the delimiter you choose below.
        <strong>Default format (Quizlet-compatible):</strong> <code>front[TAB]back</code>
      </p>

      <%= form_with url: text_deck_import_path(@deck), method: :post do |f| %>
        <div class="form-group">
          <label class="form-label" for="text_import_textarea">Cards text</label>
          <%= text_area_tag :text, params[:text],
                id: "text_import_textarea",
                class: "form-control import-textarea",
                rows: 10,
                placeholder: "Hello\tHola\nGoodbye\tAdiós",
                data: {
                  import_target: "textarea",
                  action: "input->import#updatePreview"
                } %>
          <p class="import-panel__preview-count" data-import-target="preview"></p>
        </div>

        <div class="form-group">
          <label class="form-label" for="col_sep_select">Column separator</label>
          <%= select_tag :col_sep,
                options_for_select([
                  ["Tab (default)", "\t"],
                  ["Comma", ","],
                  ["Semicolon", ";"],
                  ["Pipe |", "|"]
                ], params[:col_sep] || "\t"),
                id: "col_sep_select",
                class: "form-control form-control--select" %>
        </div>

        <div class="form-actions">
          <%= f.submit "Import Cards", class: "btn btn--primary" %>
          <%= link_to "Cancel", @deck, class: "btn btn--secondary" %>
        </div>
      <% end %>
    </div>

    <%# CSV TAB %>
    <div class="import-panel"
         data-import-target="panel"
         data-tab="csv"
         <%= "hidden" if @tab != "csv" %>>

      <p class="import-panel__hint">
        Upload a <code>.csv</code> file with two columns. The first column is the front (term),
        the second is the back (definition). A header row is detected automatically —
        supported names: <code>front</code>/<code>back</code>, <code>term</code>/<code>definition</code>,
        <code>question</code>/<code>answer</code>.
      </p>

      <%= form_with url: csv_deck_import_path(@deck), method: :post do |f| %>
        <div class="form-group">
          <label class="form-label" for="csv_file_input">CSV file</label>
          <%= file_field_tag :file,
                id: "csv_file_input",
                accept: ".csv,text/csv",
                class: "form-control" %>
        </div>

        <div class="form-actions">
          <%= f.submit "Import CSV", class: "btn btn--primary" %>
          <%= link_to "Cancel", @deck, class: "btn btn--secondary" %>
        </div>
      <% end %>
    </div>

  </div>
</div>
