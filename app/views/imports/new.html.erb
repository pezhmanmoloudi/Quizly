<% content_for :title, t("imports.title", name: @deck.name) %>

<div class="container" style="padding-top: 2rem; padding-bottom: 3rem; max-width: 680px;">
  <div class="section-header">
    <h1><%= t("imports.title", name: @deck.name) %></h1>
    <%= link_to t("imports.back", name: @deck.name), @deck, class: "section-header__link" %>
  </div>

  <% if flash[:alert] %>
    <div class="flash flash--alert" style="margin-bottom: 1rem;"><%= flash[:alert] %></div>
  <% end %>

  <div class="import-tabs"
       data-controller="import"
       data-import-active-tab-value="<%= @tab %>"
       data-import-detected-one-value="<%= t("imports.cards_detected", count: 1) %>"
       data-import-detected-other-value="<%= t("imports.cards_detected.other") %>">

    <div class="import-tabs__nav" role="tablist">
      <button class="import-tab-btn"
              role="tab"
              data-import-target="tabBtn"
              data-tab="text"
              data-action="click->import#switchTab"
              aria-selected="<%= @tab == "text" %>">
        <%= t("imports.text_tab") %>
      </button>
      <button class="import-tab-btn"
              role="tab"
              data-import-target="tabBtn"
              data-tab="csv"
              data-action="click->import#switchTab"
              aria-selected="<%= @tab == "csv" %>">
        <%= t("imports.csv_tab") %>
      </button>
    </div>

    <%# TEXT TAB %>
    <div class="import-panel"
         data-import-target="panel"
         data-tab="text"
         <%= "hidden" if @tab != "text" %>>

      <p class="import-panel__hint">
        <%= t("imports.text_hint") %>
        <strong><%= t("imports.text_default_format") %></strong> <code><%= t("imports.text_format_example") %></code>
      </p>

      <%= form_with url: text_deck_import_path(@deck), method: :post do |f| %>
        <div class="form-group">
          <label class="form-label" for="text_import_textarea"><%= t("imports.text_label") %></label>
          <%= text_area_tag :text, params[:text],
                id: "text_import_textarea",
                class: "form-control import-textarea",
                rows: 10,
                placeholder: "Hello\tHola\nGoodbye\tAdiós",
                data: {
                  import_target: "textarea",
                  action: "input->import#updatePreview"
                } %>
          <p class="import-panel__preview-count" data-import-target="preview"></p>
        </div>

        <div class="form-group">
          <label class="form-label" for="col_sep_select"><%= t("imports.separator_label") %></label>
          <%= select_tag :col_sep,
                options_for_select([
                  [t("imports.tab_separator"), "\t"],
                  [t("imports.comma_separator"), ","],
                  [t("imports.semicolon_separator"), ";"],
                  [t("imports.pipe_separator"), "|"]
                ], params[:col_sep] || "\t"),
                id: "col_sep_select",
                class: "form-control form-control--select" %>
        </div>

        <div class="form-actions">
          <%= f.submit t("imports.submit"), class: "btn btn--primary" %>
          <%= link_to t("shared.cancel"), @deck, class: "btn btn--secondary" %>
        </div>
      <% end %>
    </div>

    <%# CSV TAB %>
    <div class="import-panel"
         data-import-target="panel"
         data-tab="csv"
         <%= "hidden" if @tab != "csv" %>>

      <p class="import-panel__hint"><%= t("imports.csv_hint_html").html_safe %></p>

      <%= form_with url: csv_deck_import_path(@deck), method: :post do |f| %>
        <div class="form-group">
          <label class="form-label" for="csv_file_input"><%= t("imports.csv_label") %></label>
          <%= file_field_tag :file,
                id: "csv_file_input",
                accept: ".csv,text/csv",
                class: "form-control" %>
        </div>

        <div class="form-actions">
          <%= f.submit t("imports.csv_submit"), class: "btn btn--primary" %>
          <%= link_to t("shared.cancel"), @deck, class: "btn btn--secondary" %>
        </div>
      <% end %>
    </div>

  </div>
</div>
