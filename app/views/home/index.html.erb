<% content_for :title, t("home.page_title") %>

<div class="home-page">

  <%# ── Hero ── %>
  <section class="home-hero">
    <div class="home-hero__inner">
      <span class="home-badge">
        <svg width="13" height="13" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/>
        </svg>
        <%= t("home.badge") %>
      </span>

      <h1 class="home-hero__headline"><%= t("home.hero_heading") %></h1>
      <p class="home-hero__sub"><%= t("home.hero_subtitle") %></p>

      <div class="home-hero__ctas">
        <%= link_to t("home.sign_up"), signup_path, class: "home-btn-primary" %>
        <%= link_to t("home.explore_link"), explore_path, class: "home-btn-outline" %>
      </div>
    </div>
  </section>

  <%# ── Stats strip ── %>
  <div class="home-stats">
    <div class="home-stats__item">
      <span class="home-stats__number home-stats__number--blue"><%= localized_number(5) %></span>
      <span class="home-stats__label"><%= t("home.stats.modes_label") %></span>
    </div>
    <div class="home-stats__sep" aria-hidden="true"></div>
    <div class="home-stats__item">
      <span class="home-stats__number home-stats__number--amber"><%= localized_number(@featured_decks.size) %></span>
      <span class="home-stats__label"><%= t("home.stats.decks_label") %></span>
    </div>
    <div class="home-stats__sep" aria-hidden="true"></div>
    <div class="home-stats__item">
      <span class="home-stats__number home-stats__number--teal"><%= localized_number(10) %></span>
      <span class="home-stats__label"><%= t("home.stats.languages_label") %></span>
    </div>
  </div>

  <%# ── Two-column content ── %>
  <div class="home-content">

    <%# Left: Popular decks %>
    <div class="home-panel">
      <div class="home-panel__overline"><%= t("home.popular_section_label") %></div>
      <h2 class="home-panel__title"><%= t("home.popular_section_title") %></h2>

      <% if @featured_decks.any? %>
        <div class="home-deck-list">
          <% @featured_decks.each do |deck| %>
            <%= link_to deck_path(deck), class: "home-deck-item", data: { turbo_frame: "_top" } do %>
              <div class="home-deck-item__info">
                <span class="home-deck-item__name"><%= deck.name %></span>
                <span class="home-deck-item__meta">
                  <%= deck.flashcards_count %> <%= t("home.stats.cards_label") %> · <%= deck.user.display_name %>
                </span>
              </div>
              <span class="home-deck-item__badge"><%= t("decks.show.public_badge") %></span>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="home-panel__empty"><%= t("home.no_decks") %></p>
      <% end %>

      <%= link_to t("home.see_all"), explore_path, class: "home-panel__see-all" %>
    </div>

    <%# Right: Study modes grid %>
    <div class="home-panel">
      <div class="home-panel__overline"><%= t("home.modes_section_label") %></div>
      <h2 class="home-panel__title"><%= t("home.modes_section_title") %></h2>

      <div class="home-modes-grid">
        <a href="<%= signup_path %>" class="home-mode-card">
          <svg class="home-mode-card__icon home-mode-card__icon--purple" width="28" height="28" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <rect x="2" y="4" width="16" height="12" rx="2"/>
            <line x1="10" y1="4" x2="10" y2="16"/>
          </svg>
          <span><%= t("home.modes.flashcards") %></span>
        </a>

        <a href="<%= signup_path %>" class="home-mode-card">
          <svg class="home-mode-card__icon home-mode-card__icon--blue" width="28" height="28" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path d="M10 3C6.7 3 4 5.7 4 9c0 2.4 1.4 4.5 3.4 5.5V17h5v-2.5C14.6 13.5 16 11.4 16 9c0-3.3-2.7-6-6-6z"/>
          </svg>
          <span><%= t("home.modes.learn") %></span>
        </a>

        <a href="<%= signup_path %>" class="home-mode-card">
          <svg class="home-mode-card__icon home-mode-card__icon--amber" width="28" height="28" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <rect x="3" y="3" width="14" height="14" rx="2"/>
            <path d="M7 7h6M7 10h6M7 13h3"/>
          </svg>
          <span><%= t("home.modes.test") %></span>
        </a>

        <a href="<%= signup_path %>" class="home-mode-card">
          <svg class="home-mode-card__icon home-mode-card__icon--green" width="28" height="28" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <rect x="2" y="2" width="7" height="7" rx="1.5"/>
            <rect x="11" y="2" width="7" height="7" rx="1.5"/>
            <rect x="2" y="11" width="7" height="7" rx="1.5"/>
            <rect x="11" y="11" width="7" height="7" rx="1.5"/>
          </svg>
          <span><%= t("home.modes.match") %></span>
        </a>
      </div>
    </div>

  </div>
</div>
