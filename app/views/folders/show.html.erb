<% content_for :title, @folder.name %>

<div class="container">
  <div class="page-header">
    <h1>
      <span id="folder-<%= @folder.id %>-name"><%= @folder.name %></span>
    </h1>

    <%# 3-dot options menu %>
    <div data-controller="create-menu"
         data-action="click@document->create-menu#closeIfOutside keydown.esc@document->create-menu#close"
         class="folder-options">
      <button class="btn-icon"
              data-create-menu-target="button"
              data-action="click->create-menu#toggle"
              aria-haspopup="true"
              aria-expanded="false"
              aria-label="<%= t("folders.show.options_aria") %>">
        <%= render "shared/icons/ellipsis_horizontal" %>
      </button>

      <div class="folder-options__menu"
           data-create-menu-target="menu"
           data-open="false"
           role="menu">

        <%= link_to rename_modal_folder_path(@folder),
              class: "folder-options__item",
              role: "menuitem",
              data: { turbo_frame: "modal", action: "click->create-menu#close" } do %>
          <%= t("folders.show.rename") %>
        <% end %>

        <%= link_to delete_modal_folder_path(@folder),
              class: "folder-options__item folder-options__item--danger",
              role: "menuitem",
              data: { turbo_frame: "modal", action: "click->create-menu#close" } do %>
          <%= t("folders.show.delete") %>
        <% end %>

      </div>
    </div>
  </div>

  <% if @decks.empty? %>
    <%= render "shared/empty_state",
          icon: "folder",
          title: t("folders.show.empty"),
          variant: :dashboard %>
  <% else %>
    <div id="folder-<%= @folder.id %>-decks" class="deck-grid">
      <% @decks.each do |deck| %>
        <%= render "folders/deck_in_folder", deck: deck, folder: @folder %>
      <% end %>
    </div>
  <% end %>
</div>
