<%= turbo_frame_tag "modal" do %>
  <div data-modal-target="dialog"
       class="modal-wrapper"
       role="dialog"
       aria-modal="true"
       aria-labelledby="manage-tags-title"
       hidden>
    <div class="modal-overlay" data-action="click->modal#closeOnBackdrop">
      <div class="modal-dialog manage-tags-modal">
        <div class="modal-dialog__header">
          <h2 id="manage-tags-title" class="modal-title">
            <%= t("folders.tags_modal.title") %>
          </h2>
          <button type="button" class="modal-icon-close"
                  data-action="click->modal#close"
                  aria-label="<%= t("shared.close") %>">
            <%= render "shared/icons/x_mark" %>
          </button>
        </div>

        <div class="manage-tags-modal__grid"
             data-controller="tag-picker">
          <div class="manage-tags-modal__col">
            <h3 class="manage-tags-modal__subtitle"><%= t("folders.tags_modal.add_label") %></h3>

            <% if @tag_error.present? %>
              <p class="form-error"><%= @tag_error %></p>
            <% end %>

            <%= form_with url: folder_tags_path(@folder), method: :post, class: "folder-tags-add" do %>
              <%= text_field_tag "folder_tag[name]", nil,
                    class: "form-control",
                    maxlength: 60,
                    placeholder: t("folders.tags_modal.name_placeholder"),
                    "aria-label": t("folders.tags_modal.name_placeholder"),
                    data: { tag_picker_target: "input", action: "input->modal#enableIfNotBlank input->tag-picker#refresh" } %>
              <button type="submit" class="btn btn--primary"
                      disabled data-modal-target="submitButton">
                <%= t("folders.tags_modal.add_button") %>
              </button>
            <% end %>

            <%= render "folders/recommended_tags", recommended: @recommended %>
          </div>

          <div class="manage-tags-modal__col">
            <h3 class="manage-tags-modal__subtitle">
              <%= t("folders.tags_modal.current_tags", count: @folder_tags.size) %>
            </h3>
            <%= render "folders/tags_list",
                  folder: @folder, folder_tags: @folder_tags, deck_counts: @deck_counts %>
          </div>
        </div>

        <div class="modal-actions modal-actions--end">
          <button type="button" class="btn btn--secondary"
                  data-action="click->modal#close">
            <%= t("folders.tags_modal.close") %>
          </button>
        </div>
      </div>
    </div>
  </div>
<% end %>
