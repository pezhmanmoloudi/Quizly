<% if @deck.errors.any? %>
  <%= turbo_stream.update "manage-access-modal-#{@deck.id}" do %>
    <%= render "decks/manage_access_modal_inner", deck: @deck %>
  <% end %>
<% else %>
  <%= turbo_stream.update "visibility-badge-#{@deck.id}" do %>
    <%= render "decks/visibility_badge_content", deck: @deck %>
  <% end %>
  <%= turbo_stream.replace "manage-access-modal-#{@deck.id}" do %>
    <%= render "decks/manage_access_modal", deck: @deck %>
  <% end %>
<% end %>
