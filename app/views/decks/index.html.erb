<% content_for :title, "My Decks" %>

<div class="container">
  <div class="page-header">
    <h1>My Decks</h1>
    <%= link_to "New Deck", new_deck_path, class: "btn btn--primary" %>
  </div>

  <% if @decks.empty? %>
    <p class="empty-state">No decks yet. Create your first deck to get started.</p>
  <% else %>
    <div class="deck-grid">
      <% @decks.each do |deck| %>
        <div class="deck-tile">
          <div class="deck-tile__body">
            <h3 class="deck-tile__name"><%= link_to deck.name, deck %></h3>
            <% if deck.description.present? %>
              <p class="deck-tile__description"><%= deck.description %></p>
            <% end %>
            <p class="deck-tile__meta"><%= deck.flashcards.count %> cards</p>
          </div>
          <div class="deck-tile__actions">
            <%= link_to "Edit",   edit_deck_path(deck), class: "btn btn--secondary btn--sm" %>
            <%= button_to "Delete", deck, method: :delete, class: "btn btn--danger btn--sm",
                data: { turbo_confirm: "Delete this deck?" } %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
