<% content_for :title, "My Decks" %>

<div class="container">
  <div class="page-header">
    <h1>My Decks</h1>
  </div>

  <div class="deck-index__toolbar">
    <%= form_with url: decks_path, method: :get,
                  data: { controller: "auto-submit" } do |f| %>
      <%= f.select :sort,
            [["Recent", "recent"], ["A–Z", "az"], ["Most Due", "most_due"]],
            { selected: @sort },
            { class: "form-select", data: { action: "change->auto-submit#submit" } } %>
    <% end %>
  </div>

  <div id="decks-index-section">
    <% if @pagy.count == 0 %>
      <%= render "shared/empty_state",
            icon: "rectangle_stack",
            title: "No decks yet",
            description: "Create your first deck to start studying.",
            variant: :dashboard %>
    <% else %>
      <div class="deck-grid">
        <% @decks.each do |deck| %>
          <%= render "decks/deck_card", deck: deck, due_counts: @due_counts, from_page: @pagy.page %>
        <% end %>
      </div>
      <%= render "shared/pagination", pagy: @pagy %>
    <% end %>
  </div>
</div>
