<% content_for :title, t("decks.index.title") %>

<div class="container">
  <div class="page-header">
    <h1><%= t("decks.index.title") %></h1>
  </div>

  <div class="deck-index__toolbar">
    <%= form_with url: decks_path, method: :get,
                  data: { controller: "auto-submit" } do |f| %>
      <%= f.select :sort,
            [[t("decks.index.sort_recent"), "recent"], [t("decks.index.sort_az"), "az"], [t("decks.index.sort_most_due"), "most_due"]],
            { selected: @sort },
            { class: "form-select", data: { action: "change->auto-submit#submit" } } %>
    <% end %>
  </div>

  <div id="decks-index-section">
    <% if @pagy.count == 0 %>
      <%= render "shared/empty_state",
            icon: "rectangle_stack",
            title: t("decks.index.empty_title"),
            description: t("decks.index.empty_description"),
            variant: :dashboard %>
    <% else %>
      <div class="deck-grid">
        <% @decks.each do |deck| %>
          <%= render "decks/deck_card", deck: deck, due_counts: @due_counts, from_page: @pagy.page %>
        <% end %>
      </div>
      <%= render "shared/pagination", pagy: @pagy %>
    <% end %>
  </div>

  <% if @saved_decks.any? %>
    <div id="saved-decks-section" class="deck-index__saved-section">
      <h2 class="deck-index__saved-title"><%= t("decks.index.saved_section_title") %></h2>
      <div class="deck-grid">
        <% @saved_decks.each do |deck| %>
          <%= render "decks/saved_deck_card", deck: deck %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
