<% content_for :title, "My Decks" %>

<div class="container">
  <div class="page-header">
    <h1>My Decks</h1>
  </div>

  <div id="decks-index-section">
    <% if @decks.empty? %>
      <%= render "shared/empty_state",
            icon: "rectangle_stack",
            title: "No decks yet",
            description: "Create your first deck to start studying.",
            cta_text: "Create Deck",
            cta_path: new_deck_path,
            variant: :dashboard %>
    <% else %>
      <div class="deck-grid">
        <% @decks.each do |deck| %>
          <%= render "decks/deck_card", deck: deck, due_counts: @due_counts %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
