<% content_for :title, "My Decks" %>

<div class="container">
  <div class="page-header">
    <h1>My Decks</h1>
  </div>

  <div id="decks-index-section">
    <% if @decks.empty? %>
      <p class="empty-state">No decks yet. Create your first deck to get started.</p>
    <% else %>
      <div class="deck-grid">
        <% @decks.each do |deck| %>
          <%= render "decks/deck_card", deck: deck, due_counts: @due_counts %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
