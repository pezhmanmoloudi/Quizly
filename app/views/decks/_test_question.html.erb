<div class="test-question">
  <div class="test-question__meta">
    <span class="test-question__type-badge test-question__type-badge--<%= question['type'] %>">
      <%= question['type'].humanize %>
    </span>
  </div>

  <div class="test-question__prompt">
    <p><%= question['prompt'] %></p>
  </div>

  <% if local_assigns[:feedback] %>
    <%# Feedback state after answering %>
    <div class="test-question__feedback test-question__feedback--<%= correct ? 'correct' : 'incorrect' %>">
      <% if correct %>
        <span class="test-question__feedback-icon">✓</span>
        <span class="test-question__feedback-label">Correct!</span>
      <% else %>
        <span class="test-question__feedback-icon">✗</span>
        <span class="test-question__feedback-label">Incorrect</span>
        <% if question['type'] == 'matching' %>
          <div class="test-question__matching-answer">
            <% JSON.parse(question['correct_answer']).each do |id, definition| %>
              <% term = question['options']['terms'].find { |t| t['id'] == id } %>
              <div class="test-question__matching-pair">
                <span class="test-question__matching-term"><%= term&.dig('text') %></span>
                <span class="test-question__matching-arrow">→</span>
                <span class="test-question__matching-def"><%= definition %></span>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="test-question__correct-answer">
            Correct answer: <strong><%= question['correct_answer'] %></strong>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="test-question__continue-wrap">
      <% if local_assigns[:finished] %>
        <%= link_to test_deck_path(test_session.deck),
              class: "btn btn--primary test-question__continue",
              data: { turbo_frame: "test_question", turbo_action: "replace",
                      "test-mode-target": "continueBtn" } do %>
          See Results →
        <% end %>
      <% else %>
        <%= link_to test_deck_path(test_session.deck),
              class: "btn btn--primary test-question__continue",
              data: { turbo_frame: "test_question",
                      "test-mode-target": "continueBtn" } do %>
          Continue →
        <% end %>
      <% end %>
      <p class="keyboard-hint" aria-hidden="true">Space or Enter to continue</p>
    </div>

  <% elsif question['type'] == 'multiple_choice' %>
    <%= form_with url: test_answers_path,
                  data: { turbo_frame: "test_question" } do |f| %>
      <div class="test-question__options">
        <% question['options'].each_with_index do |option, i| %>
          <button type="submit"
                  name="answer"
                  value="<%= option %>"
                  class="test-option">
            <span class="test-option__letter"><%= ('A'.ord + i).chr %></span>
            <span class="test-option__text"><%= option %></span>
          </button>
        <% end %>
      </div>
    <% end %>

  <% elsif question['type'] == 'true_false' %>
    <%= form_with url: test_answers_path,
                  data: { turbo_frame: "test_question" } do |f| %>
      <div class="test-question__tf-options">
        <button type="submit" name="answer" value="true"
                class="test-tf-btn test-tf-btn--true">
          ✓ True
        </button>
        <button type="submit" name="answer" value="false"
                class="test-tf-btn test-tf-btn--false">
          ✗ False
        </button>
      </div>
    <% end %>

  <% elsif question['type'] == 'written' %>
    <%= form_with url: test_answers_path,
                  data: { turbo_frame: "test_question",
                          controller: "test-mode-question",
                          "test-mode-question-target": "form" } do |f| %>
      <div class="test-question__written">
        <label class="test-question__written-label">Your answer</label>
        <div class="test-question__written-row">
          <%= f.text_field :answer,
                placeholder: "Type your answer…",
                autocomplete: "off",
                autocorrect: "off",
                spellcheck: "false",
                class: "test-question__written-input",
                autofocus: true,
                aria: { label: "Your answer" } %>
          <%= f.submit "Submit",
                class: "btn btn--primary test-question__submit-btn" %>
        </div>
        <p class="keyboard-hint" aria-hidden="true">Press Enter to submit</p>
      </div>
    <% end %>

  <% elsif question['type'] == 'matching' %>
    <div class="test-matching"
         data-controller="test-matching"
         data-test-matching-total-value="<%= question['options']['terms'].size %>">
      <div class="test-matching__grid">
        <div class="test-matching__column test-matching__column--terms">
          <% question['options']['terms'].each do |term| %>
            <button type="button"
                    class="test-matching__tile test-matching__tile--term"
                    data-test-matching-target="term"
                    data-id="<%= term['id'] %>"
                    data-action="click->test-matching#selectTerm">
              <%= term['text'] %>
            </button>
          <% end %>
        </div>
        <div class="test-matching__column test-matching__column--defs">
          <% question['options']['definitions'].each do |defn| %>
            <button type="button"
                    class="test-matching__tile test-matching__tile--def"
                    data-test-matching-target="definition"
                    data-id="<%= defn['id'] %>"
                    data-action="click->test-matching#selectDefinition">
              <%= defn['text'] %>
            </button>
          <% end %>
        </div>
      </div>

      <%= form_with url: test_answers_path,
                    data: { turbo_frame: "test_question" } do |f| %>
        <%= f.hidden_field :answer, value: "",
              data: { "test-matching-target": "answerInput" } %>
        <%= f.submit "Submit Matches",
              class: "btn btn--primary test-question__continue",
              disabled: true,
              data: { "test-matching-target": "submit" } %>
      <% end %>
    </div>
  <% end %>
</div>
