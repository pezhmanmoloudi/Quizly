<% remaining_decks = Current.user.decks.count %>
<% remaining_cards = Flashcard.joins(:deck).where(decks: { user_id: Current.user.id }).count %>

<%= turbo_stream.update "total-decks-count", remaining_decks %>
<%= turbo_stream.update "total-cards-count", remaining_cards %>

<% if remaining_decks == 0 %>
  <%= turbo_stream.update "decks-index-section" do %>
    <%= render "shared/empty_state",
          icon: "rectangle_stack",
          title: "No decks yet",
          description: "Create your first deck to start studying.",
          variant: :dashboard %>
  <% end %>
<% else %>
  <%= turbo_stream.remove dom_id(@deck) %>
<% end %>

<%= turbo_stream.remove "sidebar-deck-#{@deck.id}" %>

<%= turbo_stream.update "flash-messages" do %>
  <div class="flash flash--notice" data-controller="flash"><%= flash[:notice] %></div>
<% end %>
