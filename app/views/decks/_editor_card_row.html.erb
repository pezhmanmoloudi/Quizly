<% is_new = card.nil? || card.id.nil? %>
<% card_key = is_new ? "new" : card.id.to_s %>
<div id="<%= is_new ? "card-row-new" : dom_id(card) %>"
     class="card-row"
     data-controller="card-autosave"
     data-card-autosave-flashcard-id-value="<%= card&.id.to_s %>"
     data-card-autosave-create-url-value="<%= deck_flashcards_path(deck) %>"
     data-card-autosave-saving-label-value="<%= t('decks.card_row.saving') %>"
     data-card-autosave-saved-label-value="<%= t('decks.card_row.saved') %>"
     data-card-autosave-error-label-value="<%= t('decks.card_row.error') %>">

  <div class="card-row__header">
    <span class="card-row__number"></span>
    <span class="card-autosave-status" data-card-autosave-target="status"></span>
    <button type="button"
            class="card-row__delete"
            aria-label="<%= t('decks.card_row.remove') %>"
            data-action="click->card-autosave#deleteCard">
      <%= render "shared/icons/trash" %>
    </button>
  </div>

  <div class="card-row__panels">
    <%# ── Front (Term) panel ─────────────────────────────────────────── %>
    <div class="card-row__panel"
         data-controller="autocomplete"
         data-autocomplete-url-value="<%= flashcard_suggest_path %>"
         data-autocomplete-field-value="front"
         data-autocomplete-lang-value="<%= deck.term_language.to_s %>"
         data-autocomplete-delay-value="300">
      <span class="card-editor-panel__label"><%= t("decks.card_row.term_label") %></span>
      <textarea class="card-editor-field"
                placeholder="<%= t("decks.card_row.term_placeholder") %>"
                dir="<%= text_direction_for(deck.term_language) %>"
                data-card-autosave-target="front"
                data-autocomplete-target="input"
                data-action="input->card-autosave#schedule
                             input->autocomplete#search
                             keydown->autocomplete#handleKeydown
                             blur->autocomplete#handleBlur
                             focus->autocomplete#handleFocus"
                rows="3"><%= card&.front_content %></textarea>
      <%# Unique frame id per card row prevents Turbo updating the wrong panel %>
      <%= turbo_frame_tag "suggestions_front_#{card_key}",
            data: { autocomplete_target: "frame" },
            class: "ac-frame" %>
    </div>

    <%# ── Back (Definition) panel ────────────────────────────────────── %>
    <div class="card-row__panel"
         data-controller="autocomplete"
         data-autocomplete-url-value="<%= flashcard_suggest_path %>"
         data-autocomplete-field-value="back"
         data-autocomplete-lang-value="<%= deck.definition_language.to_s %>"
         data-autocomplete-delay-value="300">
      <span class="card-editor-panel__label"><%= t("decks.card_row.definition_label") %></span>
      <textarea class="card-editor-field"
                placeholder="<%= t("decks.card_row.definition_placeholder") %>"
                dir="<%= text_direction_for(deck.definition_language) %>"
                data-card-autosave-target="back"
                data-autocomplete-target="input"
                data-action="input->card-autosave#schedule
                             input->autocomplete#search
                             keydown->autocomplete#handleKeydown
                             blur->autocomplete#handleBlur
                             focus->autocomplete#handleFocus
                             keydown->card-autosave#handleTab"
                rows="3"><%= card&.back_content %></textarea>
      <%= turbo_frame_tag "suggestions_back_#{card_key}",
            data: { autocomplete_target: "frame" },
            class: "ac-frame" %>
    </div>

    <div class="card-row__image-panel" data-card-autosave-target="imagePanel">
      <span class="card-editor-panel__label"><%= t("decks.card_row.image") %></span>

      <input type="file" accept="image/*"
             data-card-autosave-target="imageInput"
             data-action="change->card-autosave#uploadImage"
             hidden>

      <button type="button"
              class="card-row__image-placeholder"
              aria-label="<%= t('decks.card_row.add_image') %>"
              data-card-autosave-target="imagePlaceholder"
              data-action="click->card-autosave#triggerImageUpload"
              <%= "hidden" if card&.image&.attached? %>>
      </button>

      <img src="<%= card&.image&.attached? ? rails_blob_path(card.image, disposition: "inline") : "" %>"
           class="card-row__image-preview"
           data-card-autosave-target="imagePreview"
           alt=""
           <%= "hidden" unless card&.image&.attached? %>>

      <button type="button"
              class="card-row__image-action"
              data-card-autosave-target="imageBtn"
              data-action="click->card-autosave#triggerImageUpload"
              <%= "hidden" if card&.image&.attached? %>>
        <%= t("decks.card_row.add_image") %>
      </button>

      <button type="button"
              class="card-row__image-action card-row__image-action--remove"
              data-card-autosave-target="imageRemoveBtn"
              data-action="click->card-autosave#removeImage"
              <%= "hidden" unless card&.image&.attached? %>>
        <%= t("decks.card_row.remove_image") %>
      </button>
    </div>
  </div>
</div>
