<% is_new = card.nil? || card.id.nil? %>
<div id="<%= is_new ? "card-row-new" : dom_id(card) %>"
     class="card-row"
     data-controller="card-autosave"
     data-card-autosave-flashcard-id-value="<%= card&.id.to_s %>"
     data-card-autosave-create-url-value="<%= deck_flashcards_path(deck) %>"
     data-card-autosave-saving-label-value="<%= t('decks.card_row.saving') %>"
     data-card-autosave-saved-label-value="<%= t('decks.card_row.saved') %>"
     data-card-autosave-error-label-value="<%= t('decks.card_row.error') %>">

  <div class="card-row__header">
    <span class="card-row__number"></span>
    <span class="card-autosave-status" data-card-autosave-target="status"></span>
    <button type="button"
            class="card-row__delete"
            aria-label="<%= t('decks.card_row.remove') %>"
            data-action="click->card-autosave#deleteCard">
      <%= render "shared/icons/trash" %>
    </button>
  </div>

  <div class="card-row__panels">
    <div class="card-row__panel">
      <span class="card-editor-panel__label"><%= t("decks.card_row.term_label") %></span>
      <textarea class="card-editor-field"
                placeholder="<%= t("decks.card_row.term_placeholder") %>"
                data-card-autosave-target="front"
                data-action="input->card-autosave#schedule"
                rows="3"><%= card&.front_content %></textarea>
      <%= render "shared/language_selector",
            languages:     Language::ALL_LANGUAGES,
            selected:      card&.front_language.to_s,
            input_name:    "front_language",
            placeholder:   t("decks.card_row.select_language"),
            autosubmit:    false,
            wrapper_class: "lang-dropdown--compact",
            input_data:    {
              "card-autosave-target": "frontLanguage",
              action: "change->card-autosave#schedule"
            } %>
    </div>

    <div class="card-row__panel">
      <span class="card-editor-panel__label"><%= t("decks.card_row.definition_label") %></span>
      <textarea class="card-editor-field"
                placeholder="<%= t("decks.card_row.definition_placeholder") %>"
                data-card-autosave-target="back"
                data-action="input->card-autosave#schedule keydown->card-autosave#handleTab"
                rows="3"><%= card&.back_content %></textarea>
      <%= render "shared/language_selector",
            languages:     Language::ALL_LANGUAGES,
            selected:      card&.back_language.to_s,
            input_name:    "back_language",
            placeholder:   t("decks.card_row.select_language"),
            autosubmit:    false,
            wrapper_class: "lang-dropdown--compact",
            input_data:    {
              "card-autosave-target": "backLanguage",
              action: "change->card-autosave#schedule"
            } %>
    </div>
  </div>
</div>
