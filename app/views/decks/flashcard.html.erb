<% content_for :title, "Flashcard: #{@deck.name}" %>

<div class="fb"
     data-controller="flashcard-browse"
     data-flashcard-browse-total-value="<%= @flashcards.size %>"
     data-flashcard-browse-mode-value="<%= @study_mode ? 'study' : 'browse' %>"
     data-flashcard-browse-progress-value="<%= @card_progresses_json || '[]' %>"
     data-action="keydown->flashcard-browse#handleKey"
     tabindex="-1"
     aria-label="Flashcard browse area">

  <div class="fb__top">
    <div class="fb__counter">
      <span data-flashcard-browse-target="currentDisplay">1</span>
      <span class="fb__counter-sep">/</span>
      <span data-flashcard-browse-target="totalDisplay"><%= @flashcards.size %></span>
    </div>
    <h1 class="fb__deck-name"><%= @deck.name %></h1>
    <div class="fb__top-end">
      <button class="fb__icon-btn"
              data-action="click->flashcard-browse#openOptions"
              aria-label="<%= t("study_modes.flashcard.options") %>">
        <%= render "shared/icons/cog" %>
      </button>
      <%= link_to t("study_modes.exit"), @deck, class: "fb__exit" %>
    </div>
  </div>

  <% if @study_mode && @card_progresses.present? %>
    <div class="fb__study-bar" data-flashcard-browse-target="studyBar">
      <span>
        <span class="fb__study-due" data-flashcard-browse-target="dueCount">0</span>
        <%= t("study_modes.flashcard.study_cards_due") %>
      </span>
      <%= link_to t("study_modes.flashcard.exit_study_mode"),
            flashcard_deck_path(@deck),
            class: "fb__study-exit" %>
    </div>
  <% end %>

  <% if @flashcards.empty? %>
    <%= render "shared/empty_state",
          icon: "rectangle_stack",
          title: t("study_modes.no_cards_title"),
          description: t("study_modes.flashcard.empty_description"),
          variant: :card_hint %>
  <% else %>
    <div class="fb__progress-track"
         data-flashcard-browse-target="progressTrack">
      <div class="fb__progress-fill"
           data-flashcard-browse-target="progressFill"
           style="width: <%= (1.0 / @flashcards.size * 100).round %>%"></div>
    </div>

    <div class="fb__stage">
      <% @flashcards.each_with_index do |card, index| %>
        <div class="flashcard-browse__slide"
             data-index="<%= index %>"
             data-flashcard-id="<%= card.id %>"
             data-front-lang="<%= card.front_language.presence || '' %>"
             data-back-lang="<%= card.back_language.presence || '' %>"
             data-flipped="false"
             <%= index > 0 ? "hidden" : "" %>
             <% if @card_progresses&.key?(card.id) %>
               data-starred="<%= @card_progresses[card.id].starred? %>"
               data-card-progress-id="<%= @card_progresses[card.id].id %>"
             <% end %>>

          <% if @card_progresses&.key?(card.id) %>
            <div class="fb__card-bar">
              <%= render "starred_cards/toggle", card_progress: @card_progresses[card.id] %>
            </div>
          <% end %>

          <div class="fb__card-wrap">
            <div class="flashcard-card"
                 data-action="click->flashcard-browse#flip">
              <div class="flashcard-card__inner">
                <div class="flashcard-card__face flashcard-card__face--front <%= 'flashcard-card__face--has-image' if card.image.attached? %>">
                  <% if card.image.attached? %>
                    <div class="flashcard-card__img-wrap">
                      <%= image_tag rails_blob_path(card.image, disposition: "inline"),
                            class: "flashcard-card__img", alt: "" %>
                    </div>
                    <div class="flashcard-card__text"><%= card.front_content %></div>
                  <% else %>
                    <%= card.front_content %>
                  <% end %>
                </div>
                <div class="flashcard-card__face flashcard-card__face--back">
                  <%= card.back_content %>
                </div>
              </div>
            </div>
            <button class="fb__flip-bar"
                    data-action="click->flashcard-browse#flip"
                    data-flashcard-browse-target="flipBar">
              <span class="fb__flip-hint-text"><%= t("study_modes.flashcard.click_to_flip") %></span>
            </button>
          </div>

        </div>
      <% end %>
    </div>

    <div class="fb__rating-bar" data-flashcard-browse-target="ratingBar" hidden>
      <p class="fb__rating-prompt"><%= t("study_modes.flashcard.study_rate_prompt") %></p>
      <div class="fb__rating-buttons">
        <button class="fb__rating-btn fb__rating-btn--again"
                data-action="click->flashcard-browse#gradeAgain">
          <%= t("study_modes.study.again") %>
        </button>
        <button class="fb__rating-btn fb__rating-btn--hard"
                data-action="click->flashcard-browse#gradeHard">
          <%= t("study_modes.study.hard") %>
        </button>
        <button class="fb__rating-btn fb__rating-btn--good"
                data-action="click->flashcard-browse#gradeGood">
          <%= t("study_modes.study.good") %>
        </button>
        <button class="fb__rating-btn fb__rating-btn--easy"
                data-action="click->flashcard-browse#gradeEasy">
          <%= t("study_modes.study.easy") %>
        </button>
      </div>
    </div>

    <div class="fb__study-complete" data-flashcard-browse-target="studyComplete" hidden>
      <p class="fb__study-complete-title"><%= t("study_modes.flashcard.study_session_complete") %></p>
      <p class="fb__study-complete-desc"><%= t("study_modes.study.summary_sub") %></p>
      <%= link_to t("study_modes.flashcard.restart"),
            flashcard_deck_path(@deck, mode: "study"),
            class: "btn btn--primary" %>
    </div>

    <div class="fb__nav">
      <button class="fb__nav-btn fb__nav-btn--prev"
              data-flashcard-browse-target="prevBtn"
              data-action="click->flashcard-browse#previous">
        <%= t("study_modes.flashcard.previous") %>
      </button>
      <div class="fb__nav-center">
        <button class="fb__icon-btn fb__icon-btn--circle fb__audio-btn"
                data-action="click->flashcard-browse#speak"
                data-flashcard-browse-target="audioBtn"
                aria-label="<%= t("study_modes.flashcard.play_audio") %>">
          <%= render "shared/icons/speaker_wave" %>
        </button>
        <button class="fb__flip-btn"
                data-action="click->flashcard-browse#flip"
                aria-label="<%= t("study_modes.flashcard.flip") %>">
          <%= t("study_modes.flashcard.flip") %>
        </button>
      </div>
      <button class="fb__nav-btn fb__nav-btn--next"
              data-flashcard-browse-target="nextBtn"
              data-action="click->flashcard-browse#next">
        <%= t("study_modes.flashcard.next") %>
      </button>
    </div>

    <p class="keyboard-hint" aria-hidden="true">
      <% if @study_mode %>
        <%= t("study_modes.flashcard.study_keyboard_hint") %>
      <% else %>
        <%= t("study_modes.flashcard.keyboard_hint") %>
      <% end %>
    </p>

    <% unless authenticated? %>
      <div class="guest-cta-banner">
        <span class="guest-cta-banner__text"><%= t("study_modes.flashcard.guest_cta") %></span>
        <div class="guest-cta-banner__actions">
          <%= link_to t("shared.sign_in"), login_path, class: "btn btn--primary btn--sm" %>
          <%= link_to t("shared.sign_up_free"), signup_path, class: "btn btn--secondary btn--sm" %>
        </div>
      </div>
    <% end %>
  <% end %>

  <div class="fb-options"
       data-flashcard-browse-target="optionsPanel"
       aria-hidden="true">
    <div class="fb-options__header">
      <h3 class="fb-options__title"><%= t("study_modes.flashcard.options") %></h3>
      <button class="fb-options__close"
              data-action="click->flashcard-browse#closeOptions"
              aria-label="Close">
        <%= render "shared/icons/x_mark" %>
      </button>
    </div>
    <div class="fb-options__body">

      <%# ── Study ── %>
      <p class="fb-options__section-label"><%= t("study_modes.flashcard.section_study") %></p>

      <% if @card_progresses.present? && !@study_mode %>
        <div class="fb-option-row" style="padding-bottom: 0.75rem;">
          <%= link_to t("study_modes.flashcard.enter_study_mode"),
                flashcard_deck_path(@deck, mode: "study"),
                class: "btn btn--primary btn--sm" %>
        </div>
      <% end %>

      <label class="fb-option-row">
        <div class="fb-option-row__info">
          <span class="fb-option-row__label"><%= t("study_modes.flashcard.track_progress") %></span>
          <span class="fb-option-row__desc"><%= t("study_modes.flashcard.track_progress_desc") %></span>
        </div>
        <input type="checkbox"
               class="fb-toggle"
               data-action="change->flashcard-browse#toggleTrackProgress"
               data-flashcard-browse-target="trackProgressToggle"
               data-setting="trackProgress"
               checked>
      </label>

      <% if @card_progresses.present? %>
        <label class="fb-option-row">
          <div class="fb-option-row__info">
            <span class="fb-option-row__label"><%= t("study_modes.flashcard.starred_only") %></span>
            <span class="fb-option-row__desc"><%= t("study_modes.flashcard.starred_only_desc") %></span>
          </div>
          <input type="checkbox"
                 class="fb-toggle"
                 data-action="change->flashcard-browse#toggleStarredOnly"
                 data-setting="starredOnly">
        </label>
      <% end %>

      <hr class="fb-options__divider">

      <%# ── Display ── %>
      <p class="fb-options__section-label"><%= t("study_modes.flashcard.section_display") %></p>

      <label class="fb-option-row">
        <div class="fb-option-row__info">
          <span class="fb-option-row__label"><%= t("study_modes.flashcard.shuffle_cards") %></span>
          <span class="fb-option-row__desc"><%= t("study_modes.flashcard.shuffle_cards_desc") %></span>
        </div>
        <input type="checkbox"
               class="fb-toggle"
               data-action="change->flashcard-browse#toggleShuffle"
               data-setting="shuffle">
      </label>

      <div class="fb-option-row fb-option-row--block">
        <div class="fb-option-row__info">
          <span class="fb-option-row__label"><%= t("study_modes.flashcard.start_side") %></span>
        </div>
        <div class="fb-radio-group">
          <label class="fb-radio-label">
            <input type="radio" name="start_side" value="front"
                   data-action="change->flashcard-browse#toggleStartSide"
                   checked>
            <span><%= t("study_modes.flashcard.start_front") %></span>
          </label>
          <label class="fb-radio-label">
            <input type="radio" name="start_side" value="back"
                   data-action="change->flashcard-browse#toggleStartSide">
            <span><%= t("study_modes.flashcard.start_back") %></span>
          </label>
        </div>
      </div>

      <label class="fb-option-row">
        <div class="fb-option-row__info">
          <span class="fb-option-row__label"><%= t("study_modes.flashcard.show_both_sides") %></span>
          <span class="fb-option-row__desc"><%= t("study_modes.flashcard.show_both_sides_desc") %></span>
        </div>
        <input type="checkbox"
               class="fb-toggle"
               data-action="change->flashcard-browse#toggleBothSides"
               data-setting="showBothSides">
      </label>

      <hr class="fb-options__divider">

      <%# ── Audio ── %>
      <p class="fb-options__section-label"><%= t("study_modes.flashcard.section_audio") %></p>

      <label class="fb-option-row">
        <div class="fb-option-row__info">
          <span class="fb-option-row__label"><%= t("study_modes.flashcard.auto_play_audio") %></span>
          <span class="fb-option-row__desc"><%= t("study_modes.flashcard.auto_play_audio_desc") %></span>
        </div>
        <input type="checkbox"
               class="fb-toggle"
               data-action="change->flashcard-browse#toggleAutoPlayAudio"
               data-setting="autoPlayAudio">
      </label>

      <label class="fb-option-row">
        <div class="fb-option-row__info">
          <span class="fb-option-row__label"><%= t("study_modes.flashcard.auto_play_after_flip") %></span>
          <span class="fb-option-row__desc"><%= t("study_modes.flashcard.auto_play_after_flip_desc") %></span>
        </div>
        <input type="checkbox"
               class="fb-toggle"
               data-action="change->flashcard-browse#toggleAutoPlayAfterFlip"
               data-setting="autoPlayAfterFlip">
      </label>

      <hr class="fb-options__divider">

      <%# ── Playback ── %>
      <p class="fb-options__section-label"><%= t("study_modes.flashcard.section_playback") %></p>

      <label class="fb-option-row">
        <div class="fb-option-row__info">
          <span class="fb-option-row__label"><%= t("study_modes.flashcard.auto_advance") %></span>
          <span class="fb-option-row__desc"><%= t("study_modes.flashcard.auto_advance_desc") %></span>
        </div>
        <input type="checkbox"
               class="fb-toggle"
               data-action="change->flashcard-browse#toggleAutoAdvance"
               data-setting="autoAdvance">
      </label>

      <div class="fb-option-row fb-option-row--block">
        <div class="fb-option-row__info">
          <span class="fb-option-row__label"><%= t("study_modes.flashcard.auto_advance_delay") %></span>
        </div>
        <select class="fb-select"
                data-action="change->flashcard-browse#setAutoAdvanceDelay"
                data-setting="autoAdvanceDelay">
          <option value="2000">2s</option>
          <option value="3000" selected>3s</option>
          <option value="5000">5s</option>
          <option value="8000">8s</option>
        </select>
      </div>

      <hr class="fb-options__divider">

      <%# ── Keyboard ── %>
      <div class="fb-shortcut-section-header">
        <p class="fb-options__section-label"><%= t("study_modes.flashcard.section_keyboard") %></p>
        <button class="fb-options__toggle-link"
                data-action="click->flashcard-browse#toggleShortcuts"
                data-flashcard-browse-target="shortcutsToggleBtn">
          <%= t("study_modes.flashcard.hide") %>
        </button>
      </div>
      <div data-flashcard-browse-target="shortcutsPanel">
        <div class="fb-shortcut-row">
          <span><%= t("study_modes.flashcard.key_previous") %></span>
          <kbd>←</kbd>
        </div>
        <div class="fb-shortcut-row">
          <span><%= t("study_modes.flashcard.key_next") %></span>
          <kbd>→</kbd>
        </div>
        <div class="fb-shortcut-row">
          <span><%= t("study_modes.flashcard.key_flip") %></span>
          <kbd>Space</kbd>
        </div>
        <div class="fb-shortcut-row">
          <span><%= t("study_modes.flashcard.key_star") %></span>
          <kbd>S</kbd>
        </div>
      </div>

      <hr class="fb-options__divider">

      <%= link_to t("study_modes.flashcard.restart"),
            flashcard_deck_path(@deck),
            class: "fb-options__restart-link" %>
    </div>
  </div>

  <div class="fb-options__overlay"
       data-flashcard-browse-target="optionsOverlay"
       data-action="click->flashcard-browse#closeOptions"
       hidden></div>

</div>
