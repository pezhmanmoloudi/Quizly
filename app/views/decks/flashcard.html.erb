<% content_for :title, "Flashcard: #{@deck.name}" %>

<div class="study-container"
     data-controller="flashcard-browse"
     data-flashcard-browse-total-value="<%= @flashcards.size %>">
  <div class="study-header">
    <h2><%= @deck.name %></h2>
    <%= link_to "← Exit", @deck, class: "study-exit" %>
  </div>

  <% if @flashcards.empty? %>
    <div class="study-empty">
      <p class="study-empty__message">No cards yet.</p>
      <p class="study-empty__sub">Add some cards to this deck to start browsing.</p>
      <%= link_to "Back to Deck", @deck, class: "btn btn--primary" %>
    </div>
  <% else %>
    <div class="flashcard"
         data-controller="flashcard"
         data-flashcard-flipped-class="is-flipped">

      <div class="flashcard-browse__progress">
        <span data-flashcard-browse-target="current">1</span> / <%= @flashcards.size %>
      </div>

      <% @flashcards.each_with_index do |card, index| %>
        <div class="flashcard-browse__slide" data-index="<%= index %>"
             <%= index > 0 ? "hidden" : "" %>>
          <div class="flashcard__front">
            <%= card.front_content %>
          </div>
          <div class="flashcard__back" hidden>
            <%= card.back_content %>
          </div>
        </div>
      <% end %>

      <div class="flashcard__actions">
        <button class="btn btn--secondary"
                data-action="click->flashcard#reveal"
                data-flashcard-target="showButton">
          Show Answer
        </button>
      </div>
    </div>

    <div class="flashcard-browse__nav">
      <button class="btn btn--secondary btn-with-icon"
              data-action="click->flashcard-browse#previous">
        ← Previous
      </button>
      <button class="btn btn--primary btn-with-icon"
              data-action="click->flashcard-browse#next">
        Next →
      </button>
    </div>
  <% end %>
</div>
