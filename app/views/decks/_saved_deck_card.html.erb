<div id="saved-deck-card-<%= deck.id %>" class="saved-deck-card-wrapper">
  <a class="deck-tile deck-tile--saved" href="<%= deck_path(deck) %>">
    <div class="deck-tile__header">
      <h3 class="deck-tile__name"><%= deck.name %></h3>
      <span class="deck-tile__saved-badge">
        <%= render "shared/icons/bookmark", css_class: "icon--xs" %>
        <%= t("explore.saved_badge") %>
      </span>
    </div>

    <div class="deck-tile__body">
      <% if deck.description.present? %>
        <p class="deck-tile__description"><%= deck.description %></p>
      <% end %>
      <div class="deck-tile__meta-row">
        <span class="deck-tile__meta"><%= t("decks.deck_card.count", count: deck.flashcards.size) %></span>
        <% if deck.language_code.present? %>
          <span class="deck-tile__lang-badge"><%= deck.language_code.upcase %></span>
        <% end %>
      </div>
      <% if deck.tag_list.any? %>
        <div class="deck-tile__tags">
          <% deck.tag_list.first(3).each do |tag| %>
            <span class="tag-badge"><%= tag %></span>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="deck-tile__footer">
      <span class="deck-tile__author"><%= t("explore.by") %> <%= deck.user.display_name %></span>
    </div>
  </a>

  <%= form_with url: unsave_deck_path(deck), method: :delete do %>
    <button type="submit" class="btn btn--outline btn--sm deck-tile__unsave-btn">
      <%= t("decks.action.unsave") %>
    </button>
  <% end %>
</div>
