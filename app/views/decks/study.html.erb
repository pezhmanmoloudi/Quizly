<% content_for :title, "Study: #{@deck.name}" %>

<div class="study-island"
     data-controller="study-mode"
     data-action="keydown->study-mode#handleKey"
     tabindex="-1"
     aria-label="Study session">

  <div class="study-island__header">
    <%= link_to t("study_modes.exit"), @deck, class: "study-island__exit",
          data: { study_mode_target: "exitLink" } %>

    <div class="study-island__title-block">
      <h2 class="study-island__title"><%= @deck.name %></h2>
      <p class="study-island__subtitle"><%= t("study_modes.study.subtitle") %></p>
    </div>

    <div class="study-island__stats">
      <div class="match-stat match-stat--timer">
        <div class="match-stat__badge">
          <svg class="match-stat__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="14" height="14" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm.75-13a.75.75 0 0 0-1.5 0v5c0 .414.336.75.75.75h4a.75.75 0 0 0 0-1.5h-3.25V5Z" clip-rule="evenodd"/>
          </svg>
          <span class="match-stat__value" data-study-mode-target="timer">00:00</span>
        </div>
        <span class="match-stat__label"><%= t("study_modes.time") %></span>
      </div>

      <% if @card_progress.present? && @cards_total.to_i > 0 %>
        <div class="match-stat match-stat--pairs">
          <div class="match-stat__badge">
            <svg class="match-stat__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="14" height="14" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm0-2a6 6 0 1 0 0-12 6 6 0 0 0 0 12Zm0-3a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" clip-rule="evenodd"/>
            </svg>
            <span class="match-stat__value"><%= @cards_done %> / <%= @cards_total %></span>
          </div>
          <span class="match-stat__label"><%= t("study_modes.study.done_label") %></span>
        </div>
      <% end %>

      <div class="match-stat match-stat--streak">
        <div class="match-stat__badge">
          <svg class="match-stat__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="14" height="14" aria-hidden="true">
            <path d="M12.395 2.553a1 1 0 0 0-1.45-.385c-.345.23-.614.558-.822.88-.214.33-.403.713-.57 1.116-.334.804-.614 1.768-.84 2.734a31.365 31.365 0 0 0-.613 3.58 2.64 2.64 0 0 1-.945-1.067c-.328-.68-.398-1.534-.398-2.654A1 1 0 0 0 5.05 6.05 6.981 6.981 0 0 0 3 11a7 7 0 1 0 11.95-4.95c-.592-.591-.98-.985-1.348-1.467-.363-.476-.724-1.063-1.207-2.03ZM12.12 15.12A3 3 0 0 1 7 13s.879.5 2.5.5c0-1 .5-4 1.25-4.5.5 1 .786 1.293 1.371 1.879A2.99 2.99 0 0 1 13 13a2.99 2.99 0 0 1-.879 2.121Z"/>
          </svg>
          <span class="match-stat__value" data-study-mode-target="streak"><%= @streak || 0 %></span>
        </div>
        <span class="match-stat__label"><%= t("study_modes.streak") %></span>
      </div>
    </div>
  </div>

  <div class="study-island__mode-bar">
    <%= link_to t("study_modes.study.all_cards_tab"), study_deck_path(@deck),
          class: "study-mode-tab #{"study-mode-tab--active" if @study_mode == "all"}" %>
    <%= link_to t("study_modes.study.starred_tab"), study_deck_path(@deck, mode: "starred"),
          class: "study-mode-tab #{"study-mode-tab--active" if @study_mode == "starred"}" %>
  </div>

  <% if @card_progress.present? && @cards_total.to_i > 0 %>
    <% progress_pct = (@cards_done.to_f / @cards_total * 100).round %>
    <div class="study-island__progress-wrap">
      <div class="study-island__progress">
        <div class="study-island__progress-fill" style="width: <%= progress_pct %>%"></div>
      </div>
      <span class="study-island__progress-label"><%= progress_pct %>%</span>
    </div>
  <% end %>

  <%= turbo_frame_tag "study_card" do %>
    <% if @card_progress.nil? %>
      <% if flash[:study_summary].present? %>
        <% summary = flash[:study_summary] %>
        <div class="study-empty">
          <div class="session-summary">
            <div class="session-summary__icon">🎉</div>
            <h3 class="session-summary__title"><%= t("study_modes.study.summary_title") %></h3>
            <div class="session-summary__stats">
              <div class="session-summary__stat">
                <span class="session-summary__value"><%= summary[:reviewed] || summary["reviewed"] %></span>
                <span class="session-summary__label"><%= t("study_modes.study.reviewed") %></span>
              </div>
              <div class="session-summary__stat">
                <% reviewed = summary[:reviewed] || summary["reviewed"] || 1 %>
                <% correct  = summary[:correct]  || summary["correct"]  || 0 %>
                <span class="session-summary__value"><%= ((correct.to_f / reviewed) * 100).round %>%</span>
                <span class="session-summary__label"><%= t("study_modes.study.accuracy") %></span>
              </div>
              <% elapsed = summary[:elapsed] || summary["elapsed"] %>
              <% if elapsed.present? %>
                <div class="session-summary__stat">
                  <span class="session-summary__value"><%= format_study_time(elapsed.to_i) %></span>
                  <span class="session-summary__label"><%= t("study_modes.study.time_spent") %></span>
                </div>
              <% end %>
            </div>
            <p class="session-summary__sub"><%= t("study_modes.study.summary_sub") %></p>
          </div>
        </div>
      <% else %>
        <%= render "shared/empty_state",
              icon: "academic_cap",
              title: t("study_modes.study.empty_title"),
              description: t("study_modes.study.empty_description"),
              variant: :default %>
      <% end %>
    <% else %>
      <div class="study-card"
           data-controller="flashcard"
           data-flashcard-flipped-class="is-flipped">

        <div class="study-card__content">
          <div class="study-card__front">
            <% flashcard = @card_progress.flashcard %>
            <% if flashcard.image.attached? %>
              <div class="study-card__img-wrap">
                <%= image_tag rails_blob_path(flashcard.image, disposition: "inline"),
                      class: "study-card__img", alt: "" %>
              </div>
            <% end %>
            <span class="<%= 'study-card__term' if flashcard.image.attached? %>"><%= flashcard.front_content %></span>
          </div>

          <div class="study-card__back" data-flashcard-target="back" hidden>
            <div class="study-card__divider"></div>
            <%= @card_progress.flashcard.back_content %>
          </div>
        </div>

        <div class="study-card__footer">
          <button class="study-reveal-btn"
                  data-flashcard-target="showButton"
                  data-study-mode-target="showButton"
                  data-action="click->flashcard#reveal"
                  aria-keyshortcuts="Space">
            <%= t("study_modes.study.show_answer") %>
            <kbd class="study-kbd">Space</kbd>
          </button>

          <%= form_with url: card_reviews_path,
                        data: { flashcard_target: "ratingForm" },
                        style: "display:none" do |f| %>
            <%= hidden_field_tag :card_progress_id, @card_progress.id %>
            <%= hidden_field_tag :study_mode, @study_mode %>
            <div class="rating-buttons">
              <%= f.submit t("study_modes.study.again"), name: :rating, value: "again",
                    class: "rating-btn rating-btn--again",
                    data: { study_mode_target: "againBtn", action: "click->study-mode#trackRating" },
                    aria: { keyshortcuts: "1" } %>
              <%= f.submit t("study_modes.study.hard"),  name: :rating, value: "hard",
                    class: "rating-btn rating-btn--hard",
                    data: { study_mode_target: "hardBtn", action: "click->study-mode#trackRating" },
                    aria: { keyshortcuts: "2" } %>
              <%= f.submit t("study_modes.study.good"),  name: :rating, value: "good",
                    class: "rating-btn rating-btn--good",
                    data: { study_mode_target: "goodBtn", action: "click->study-mode#trackRating" },
                    aria: { keyshortcuts: "3" } %>
              <%= f.submit t("study_modes.study.easy"),  name: :rating, value: "easy",
                    class: "rating-btn rating-btn--easy",
                    data: { study_mode_target: "easyBtn", action: "click->study-mode#trackRating" },
                    aria: { keyshortcuts: "4" } %>
            </div>
          <% end %>

          <div class="study-card__star-row" data-flashcard-target="ratingForm" style="display:none">
            <%= render "starred_cards/toggle", card_progress: @card_progress %>
          </div>

          <p class="keyboard-hint" aria-hidden="true"><%= t("study_modes.study.keyboard_hint") %></p>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
