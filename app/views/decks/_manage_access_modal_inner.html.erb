<div class="modal-overlay" data-action="click->modal#closeOnBackdrop">
  <div class="modal-dialog manage-access-modal">

    <div class="modal-dialog__header">
      <h2 id="manage-access-title-<%= deck.id %>" class="manage-access-modal__title">
        <%= t("decks.manage_access.title") %>
      </h2>
      <button type="button"
              class="modal-icon-close"
              data-action="click->modal#close"
              aria-label="<%= t("shared.close") %>">
        <%= render "shared/icons/x_mark" %>
      </button>
    </div>

    <%= form_with model: deck, url: update_visibility_deck_path(deck), method: :patch,
          data: { controller: "access-settings" } do |f| %>

      <div class="manage-access-modal__body">

        <% if deck.errors.any? %>
          <div class="form-errors"
               role="alert"
               data-controller="flash"
               data-flash-timeout-value="5000">
            <% deck.errors.full_messages.each do |msg| %>
              <p><%= msg %></p>
            <% end %>
          </div>
        <% end %>

        <div class="manage-access-modal__grid">

          <%# ── Row 1: Visible to ── %>
          <div class="manage-access-col"
               data-controller="select-dropdown"
               data-action="click@window->select-dropdown#closeIfOutside keydown@window->select-dropdown#onKeydown">
            <label class="manage-access-col__label" for="sel-visibility-<%= deck.id %>">
              <%= t("decks.manage_access.visible_to") %>
            </label>

            <%# Hidden native select — form submission + access_settings_controller target %>
            <%= f.select :visibility,
                  [
                    [t("decks.form.visibility_private"),  "private"],
                    [t("decks.form.visibility_unlisted"), "unlisted"],
                    [t("decks.form.visibility_public"),   "public"],
                  ],
                  {},
                  class: "select-dropdown__native",
                  data: {
                    "select-dropdown-target": "nativeSelect",
                    "access-settings-target": "visibilitySelect",
                    action: "change->access-settings#onVisibilityChange",
                    "desc-private":  t("decks.manage_access.private_desc"),
                    "desc-unlisted": t("decks.manage_access.unlisted_desc"),
                    "desc-public":   t("decks.manage_access.public_desc"),
                  } %>

            <button type="button"
                    id="sel-visibility-<%= deck.id %>"
                    class="select-dropdown__trigger"
                    aria-haspopup="listbox"
                    aria-expanded="false"
                    data-select-dropdown-target="trigger"
                    data-action="click->select-dropdown#toggle">
              <span data-select-dropdown-target="label">
                <%= t("decks.form.visibility_#{deck.visibility}") %>
              </span>
              <svg class="select-dropdown__chevron" xmlns="http://www.w3.org/2000/svg"
                   viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </button>

            <ul class="select-dropdown__menu"
                role="listbox"
                aria-labelledby="sel-visibility-<%= deck.id %>"
                data-select-dropdown-target="menu"
                data-open="false">
              <li role="none">
                <button type="button" class="select-dropdown__option" role="option"
                        data-value="private"
                        aria-selected="<%= deck.private? %>"
                        data-select-dropdown-target="option"
                        data-action="click->select-dropdown#select">
                  <%= t("decks.form.visibility_private") %>
                </button>
              </li>
              <li role="none">
                <button type="button" class="select-dropdown__option" role="option"
                        data-value="unlisted"
                        aria-selected="<%= deck.unlisted? %>"
                        data-select-dropdown-target="option"
                        data-action="click->select-dropdown#select">
                  <%= t("decks.form.visibility_unlisted") %>
                </button>
              </li>
              <li role="none">
                <button type="button" class="select-dropdown__option" role="option"
                        data-value="public"
                        aria-selected="<%= deck.public? %>"
                        data-select-dropdown-target="option"
                        data-action="click->select-dropdown#select">
                  <%= t("decks.form.visibility_public") %>
                </button>
              </li>
            </ul>

            <p class="manage-access-col__desc"
               data-access-settings-target="visibilityDesc">
              <%= t("decks.manage_access.#{deck.visibility}_desc") %>
            </p>
          </div>

          <%# ── Row 1: Editable by ── %>
          <div class="manage-access-col"
               data-controller="select-dropdown"
               data-action="click@window->select-dropdown#closeIfOutside keydown@window->select-dropdown#onKeydown">
            <label class="manage-access-col__label" for="sel-edit-<%= deck.id %>">
              <%= t("decks.manage_access.editable_by") %>
            </label>

            <%# Hidden native select — form submission + access_settings_controller target %>
            <%= f.select :edit_permission,
                  [
                    [t("decks.form.edit_permission_only_me"),              "only_me"],
                    [t("decks.form.edit_permission_people_with_password"), "people_with_password"],
                  ],
                  {},
                  class: "select-dropdown__native",
                  data: {
                    "select-dropdown-target": "nativeSelect",
                    "access-settings-target": "editSelect",
                    action: "change->access-settings#onEditPermissionChange",
                    "desc-only-me":              t("decks.manage_access.only_me_desc"),
                    "desc-people-with-password": t("decks.manage_access.people_with_password_desc"),
                  } %>

            <button type="button"
                    id="sel-edit-<%= deck.id %>"
                    class="select-dropdown__trigger"
                    aria-haspopup="listbox"
                    aria-expanded="false"
                    data-select-dropdown-target="trigger"
                    data-action="click->select-dropdown#toggle">
              <span data-select-dropdown-target="label">
                <%= deck.only_me? ?
                      t("decks.form.edit_permission_only_me") :
                      t("decks.form.edit_permission_people_with_password") %>
              </span>
              <svg class="select-dropdown__chevron" xmlns="http://www.w3.org/2000/svg"
                   viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </button>

            <ul class="select-dropdown__menu"
                role="listbox"
                aria-labelledby="sel-edit-<%= deck.id %>"
                data-select-dropdown-target="menu"
                data-open="false">
              <li role="none">
                <button type="button" class="select-dropdown__option" role="option"
                        data-value="only_me"
                        aria-selected="<%= deck.only_me? %>"
                        data-select-dropdown-target="option"
                        data-action="click->select-dropdown#select">
                  <%= t("decks.form.edit_permission_only_me") %>
                </button>
              </li>
              <li role="none">
                <button type="button" class="select-dropdown__option" role="option"
                        data-value="people_with_password"
                        aria-selected="<%= deck.people_with_password? %>"
                        data-select-dropdown-target="option"
                        data-action="click->select-dropdown#select">
                  <%= t("decks.form.edit_permission_people_with_password") %>
                </button>
              </li>
            </ul>

            <p class="manage-access-col__desc"
               data-access-settings-target="editDesc">
              <%= deck.only_me? ?
                    t("decks.manage_access.only_me_desc") :
                    t("decks.manage_access.people_with_password_desc") %>
            </p>
          </div>

          <%# ── Row 2: Share link ── %>
          <div class="manage-access-modal__share<%= deck.unlisted? ? '' : ' access-section--hidden' %>"
               data-access-settings-target="shareSection">
            <p class="manage-access-col__label"><%= t("decks.manage_access.share_heading") %></p>
            <div class="access-link-row"
                 data-controller="clip"
                 data-clip-copied-value="<%= t('decks.manage_access.copy_link_copied') %>">
              <input class="access-link-input"
                     type="text"
                     value="<%= deck_url(deck) %>"
                     readonly
                     id="share-link-<%= deck.id %>"
                     aria-label="<%= t("decks.manage_access.share_heading") %>"
                     data-clip-target="source">
              <button type="button"
                      class="access-link-copy"
                      data-action="click->clip#copy">
                <span data-clip-target="label"><%= t("decks.manage_access.copy_link") %></span>
              </button>
            </div>
            <p class="manage-access-col__desc"><%= t("decks.manage_access.share_hint") %></p>
          </div>

          <%# ── Row 2: Deck password ── %>
          <div class="manage-access-modal__password<%= deck.people_with_password? ? '' : ' access-section--hidden' %>"
               data-access-settings-target="passwordSection">
            <div data-controller="password-toggle">
              <label class="manage-access-col__label" for="deck_password">
                <%= t("decks.form.password_label") %>
              </label>
              <div class="field-with-toggle">
                <%= f.password_field :password,
                      class: "form-control",
                      placeholder: t("decks.form.password_placeholder"),
                      autocomplete: "new-password",
                      disabled: !deck.people_with_password?,
                      data: { "access-settings-target": "passwordInput",
                              "password-toggle-target": "field" } %>
                <button type="button"
                        class="auth-input__toggle"
                        data-action="password-toggle#toggle"
                        aria-label="<%= t("accounts.toggle_password") %>">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                       viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/>
                    <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/>
                  </svg>
                </button>
              </div>
              <p class="manage-access-col__desc"><%= t("decks.form.password_hint") %></p>
            </div>
          </div>

        </div>

      </div>

      <div class="manage-access-modal__actions">
        <%= f.submit t("shared.save"), class: "btn btn--primary btn--lg" %>
      </div>

    <% end %>
  </div>
</div>
