<% content_for :title, t("decks.cards.page_title", name: @deck.name) %>

<%= form_with url: update_cards_deck_path(@deck), method: :patch,
      multipart: true,
      class: "cards-editor-page",
      data: {
        controller: "card-editor",
        action: "submit->card-editor#handleSubmit",
        card_editor_error_term_value:          t("decks.cards.error_term", row: ""),
        card_editor_error_definition_value:    t("decks.cards.error_definition", row: ""),
        card_editor_error_language_value:      t("decks.cards.error_language", row: "", side: ""),
        card_editor_requires_language_value:   (!@imported).to_s
      } do %>

  <%= hidden_field_tag :requires_language, !@imported %>

  <header class="card-editor-header">
    <%= link_to deck_path(@deck), class: "card-editor-header__back",
          aria: { label: t("decks.cards.back_label", name: @deck.name) } do %>
      ← <span class="card-editor-header__deck-name"><%= @deck.name %></span>
    <% end %>
  </header>

  <div class="cards-editor-body">
    <div class="card-rows-list" data-card-editor-target="cardsList">
      <%# Existing persisted cards (editing mode) %>
      <% @existing.each_with_index do |card, i| %>
        <%= render "decks/card_row_template",
              card: card,
              imported: @imported,
              index: i %>
      <% end %>

      <%# Draft rows from import (not yet persisted) %>
      <% @draft_rows.each_with_index do |row, i| %>
        <%= render "decks/card_row_template",
              card: nil,
              front_content: row[:front_content],
              back_content:  row[:back_content],
              imported: true,
              index: @existing.length + i %>
      <% end %>

      <%# Blank rows when deck is new and no import %>
      <% if @existing.empty? && @draft_rows.empty? %>
        <%= render "decks/card_row_template", card: nil, imported: @imported, index: 0 %>
        <%= render "decks/card_row_template", card: nil, imported: @imported, index: 1 %>
      <% end %>
    </div>

    <div class="cards-editor-add">
      <button type="button" class="btn btn--outline btn-with-icon"
              data-action="click->card-editor#addCard">
        <%= render "shared/icons/plus" %> <%= t("decks.cards.add_card") %>
      </button>
    </div>
  </div>

  <div class="cards-editor-footer">
    <button type="submit" class="btn btn--primary"
            data-card-editor-target="saveButton">
      <%= t("decks.cards.save") %>
    </button>
  </div>

  <template data-card-editor-target="template">
    <%= render "decks/card_row_template",
          card: nil, imported: @imported, index: "NEW_INDEX" %>
  </template>
<% end %>
