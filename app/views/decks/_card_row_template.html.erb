<div class="card-row" data-card-editor-target="row">
  <div class="card-row__header">
    <span class="card-row__number">N</span>
    <button type="button" class="card-row__delete"
            data-action="click->card-editor#removeCard"
            aria-label="Remove card">
      <%= render "shared/icons/trash" %>
    </button>
  </div>
  <div class="card-row__panels">
    <div class="card-row__panel">
      <span class="card-editor-panel__label">Term</span>
      <textarea class="card-editor-field"
                name="deck[flashcards_attributes][NEW_INDEX][front_content]"
                placeholder="Enter term"
                rows="3"></textarea>
    </div>
    <div class="card-row__panel">
      <span class="card-editor-panel__label">Definition</span>
      <textarea class="card-editor-field"
                name="deck[flashcards_attributes][NEW_INDEX][back_content]"
                placeholder="Enter definition"
                rows="3"
                data-action="keydown->card-editor#handleDefinitionKeydown blur->card-editor#handleDefinitionBlur"></textarea>
    </div>
  </div>
</div>
