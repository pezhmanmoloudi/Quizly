<%= form_with model: deck, data: { controller: "access-settings" } do |f| %>
  <% if deck.errors.any? %>
    <div class="form-errors nd-split__errors">
      <% deck.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="nd-split__body">
    <div class="nd-split__left">
      <p class="nd-split__section-label"><%= t("decks.form.section_about") %></p>

      <div class="form-group">
        <%= f.label :name, t("decks.form.name_label") %>
        <%= f.text_field :name, class: "form-control" %>
      </div>

      <div class="form-group">
        <%= f.label :description, t("decks.form.description_label") %>
        <%= f.text_area :description, rows: 3, class: "form-control" %>
      </div>

      <div class="form-group">
        <%= f.label :language_code, t("decks.form.language_label") %>
        <%= f.text_field :language_code, class: "form-control", placeholder: t("decks.form.language_placeholder") %>
      </div>

      <div class="form-group">
        <%= f.label :tag_list, t("decks.form.tags_label") %>
        <%= f.text_field :tag_list, value: deck.tag_list.join(", "),
              class: "form-control",
              placeholder: t("decks.form.tags_placeholder") %>
        <p class="form-hint"><%= t("decks.form.tags_hint") %></p>
      </div>
    </div>

    <div class="nd-split__right">
      <p class="nd-split__section-label"><%= t("decks.form.section_access_control") %></p>

      <%# Section 1 — Visibility %>
      <div class="form-group" data-access-settings-target="visibilityGroup">
        <span class="form-label"><%= t("decks.form.visibility_section_label") %></span>
        <div class="visibility-toggle">
          <label class="visibility-option">
            <%= f.radio_button :visibility, "public", class: "visibility-radio",
                  data: { action: "change->access-settings#onVisibilityChange" } %>
            <span class="visibility-label">
              <%= render "shared/icons/globe", css_class: "icon--sm" %>
              <%= t("decks.form.visibility_public") %>
            </span>
          </label>
          <label class="visibility-option">
            <%= f.radio_button :visibility, "unlisted", class: "visibility-radio",
                  data: { action: "change->access-settings#onVisibilityChange" } %>
            <span class="visibility-label">
              <%= render "shared/icons/link", css_class: "icon--sm" %>
              <%= t("decks.form.visibility_unlisted") %>
            </span>
          </label>
          <label class="visibility-option">
            <%= f.radio_button :visibility, "private", class: "visibility-radio",
                  data: { action: "change->access-settings#onVisibilityChange" } %>
            <span class="visibility-label">
              <%= render "shared/icons/lock", css_class: "icon--sm" %>
              <%= t("decks.form.visibility_private") %>
            </span>
          </label>
        </div>
      </div>

      <%# Section 2 — Edit Permission %>
      <div class="form-group" data-access-settings-target="editGroup">
        <span class="form-label"><%= t("decks.form.edit_permission_label") %></span>
        <div class="visibility-toggle">
          <label class="visibility-option">
            <%= f.radio_button :edit_permission, "only_me", class: "visibility-radio",
                  data: { action: "change->access-settings#onEditPermissionChange",
                          "access-settings-target": "editPermissionRadio" } %>
            <span class="visibility-label"><%= t("decks.form.edit_permission_only_me") %></span>
          </label>
          <label class="visibility-option">
            <%= f.radio_button :edit_permission, "people_with_password", class: "visibility-radio",
                  data: { action: "change->access-settings#onEditPermissionChange",
                          "access-settings-target": "editPermissionRadio" } %>
            <span class="visibility-label"><%= t("decks.form.edit_permission_people_with_password") %></span>
          </label>
        </div>
      </div>

      <%# Section 3 — Password (shown when edit_permission is people_with_password) %>
      <div class="form-group" data-access-settings-target="passwordSection" style="display:none">
        <%= f.label :password, t("decks.form.password_label") %>
        <%= f.password_field :password,
              class: "form-control",
              placeholder: t("decks.form.password_placeholder"),
              autocomplete: "new-password",
              data: { "access-settings-target": "passwordInput" } %>
        <p class="form-hint"><%= t("decks.form.password_hint") %></p>
      </div>

      <div class="nd-split__actions">
        <%= f.submit class: "btn btn--primary" %>
      </div>
    </div>
  </div>
<% end %>
