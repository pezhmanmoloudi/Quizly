<%= form_with model: deck,
      data: { controller: "card-editor",
              "card-editor-error-term-value": t("card_editor.error_term"),
              "card-editor-error-definition-value": t("card_editor.error_definition") } do |f| %>

  <div class="deck-form-topbar">
    <h1 class="deck-form-topbar__title">
      <%= deck.new_record? ? t("decks.new.title") : t("decks.edit.title") %>
    </h1>
    <div class="deck-form-topbar__actions">
      <%= f.submit t("decks.form.save"), class: "btn btn--secondary" %>
      <%= f.submit t("decks.form.save_and_study"),
            name: "save_and_study",
            class: "btn btn--primary" %>
    </div>
  </div>

  <% if deck.errors.any? %>
    <div class="deck-form-errors">
      <% deck.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="deck-form-meta">
    <div class="form-group <%= 'form-group--error' if deck.errors[:name].any? %>">
      <%= f.text_field :name,
            class: "form-control deck-form-meta__title-field",
            placeholder: t("decks.form.name_label"),
            "aria-label": t("decks.form.name_label") %>
      <% if deck.errors[:name].any? %>
        <span class="form-field-error"><%= deck.errors[:name].first %></span>
      <% end %>
    </div>

    <div class="form-group">
      <%= f.text_area :description,
            rows: 2,
            class: "form-control deck-form-meta__desc-field",
            placeholder: t("decks.form.description_label"),
            "aria-label": t("decks.form.description_label") %>
    </div>

    <div class="deck-form-meta__footer">
      <div class="deck-visibility-select">
        <%= f.label :visibility, t("decks.form.visibility_label"),
              class: "deck-visibility-select__label" %>
        <%= f.select :visibility,
              [[t("decks.form.visibility_private"), "private"],
               [t("decks.form.visibility_public"), "public"]],
              {},
              { class: "deck-visibility-select__control" } %>
      </div>

      <% if deck.persisted? %>
        <%= link_to t("decks.show.import"),
              new_deck_import_path(deck),
              class: "btn btn--outline btn--sm btn-with-icon deck-form-meta__import-btn" %>
      <% end %>
    </div>
  </div>

  <div class="card-rows-list" data-card-editor-target="cardsList">
    <%= f.fields_for :flashcards do |ff| %>
      <%= render "card_row", ff: ff %>
    <% end %>
  </div>

  <template data-card-editor-target="template">
    <%= f.fields_for :flashcards, Flashcard.new, child_index: "NEW_INDEX" do |ff| %>
      <%= render "card_row", ff: ff %>
    <% end %>
  </template>

  <div class="deck-form-add">
    <button type="button" class="btn btn--outline btn-with-icon"
            data-action="click->card-editor#addCard">
      <%= render "shared/icons/plus" %> <%= t("decks.form.add_card") %>
    </button>
  </div>

  <div class="deck-form-footer">
    <%= f.submit t("decks.form.save"), class: "btn btn--secondary" %>
    <%= f.submit t("decks.form.save_and_study"),
          name: "save_and_study",
          class: "btn btn--primary" %>
  </div>

<% end %>
