<%= form_with model: deck, data: { controller: "deck-form",
                                        "deck-form-current-visibility-value": deck.visibility.to_s } do |f| %>
  <%= f.hidden_field :share_token %>
  <% if deck.errors.any? %>
    <div class="form-errors nd-split__errors">
      <% deck.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="nd-split__body">
    <div class="nd-split__left">
      <p class="nd-split__section-label"><%= t("decks.form.section_about") %></p>

      <div class="form-group">
        <%= f.label :name, t("decks.form.name_label") %>
        <%= f.text_field :name, class: "form-control" %>
      </div>

      <div class="form-group">
        <%= f.label :description, t("decks.form.description_label") %>
        <%= f.text_area :description, rows: 3, class: "form-control" %>
      </div>

      <div class="form-group">
        <%= f.label :language_code, t("decks.form.language_label") %>
        <%= f.text_field :language_code, class: "form-control", placeholder: t("decks.form.language_placeholder") %>
      </div>

      <div class="form-group">
        <%= f.label :tag_list, t("decks.form.tags_label") %>
        <%= f.text_field :tag_list, value: deck.tag_list.join(", "),
              class: "form-control",
              placeholder: t("decks.form.tags_placeholder") %>
        <p class="form-hint"><%= t("decks.form.tags_hint") %></p>
      </div>
    </div>

    <div class="nd-split__right">
      <p class="nd-split__section-label"><%= t("decks.form.section_access_control") %></p>

      <%# Section 1 — Visibility %>
      <div class="form-group" data-deck-form-target="visibilityGroup">
        <span class="form-label"><%= t("decks.form.visibility_section_label") %></span>
        <div class="visibility-toggle">
          <label class="visibility-option">
            <%= f.radio_button :visibility, "everyone", class: "visibility-radio",
                  data: { action: "change->deck-form#onVisibilityChange" } %>
            <span class="visibility-label">
              <%= render "shared/icons/globe", css_class: "icon--sm" %>
              <%= t("decks.form.visibility_everyone") %>
            </span>
          </label>
          <label class="visibility-option">
            <%= f.radio_button :visibility, "unlisted", class: "visibility-radio",
                  data: { action: "change->deck-form#onVisibilityChange" } %>
            <span class="visibility-label">
              <%= render "shared/icons/link", css_class: "icon--sm" %>
              <%= t("decks.form.visibility_unlisted") %>
            </span>
          </label>
          <label class="visibility-option">
            <%= f.radio_button :visibility, "password_protected", class: "visibility-radio",
                  data: { action: "change->deck-form#onVisibilityChange" } %>
            <span class="visibility-label">
              <%= render "shared/icons/lock", css_class: "icon--sm" %>
              <%= t("decks.form.visibility_password_protected") %>
            </span>
          </label>
          <label class="visibility-option">
            <%= f.radio_button :visibility, "private", class: "visibility-radio",
                  data: { action: "change->deck-form#onVisibilityChange" } %>
            <span class="visibility-label">
              <%= render "shared/icons/lock", css_class: "icon--sm" %>
              <%= t("decks.form.visibility_private") %>
            </span>
          </label>
        </div>
      </div>

      <%# Section 4 — Share panel (shown when unlisted) %>
      <div class="share-panel"
           data-deck-form-target="sharePanel"
           style="<%= deck.unlisted? ? '' : 'display:none' %>">
        <div class="share-panel__header">
          <%= render "shared/icons/link", css_class: "icon--sm share-panel__icon" %>
          <span class="share-panel__hint"><%= t("decks.form.unlisted_share_hint") %></span>
        </div>
        <div class="share-panel__link-row">
          <input type="text"
                 class="share-panel__input"
                 value="<%= deck.share_token.present? ? shared_deck_url(deck.share_token) : '' %>"
                 readonly
                 data-deck-form-target="shareLinkInput"
                 aria-label="<%= t("decks.show.share_link_label") %>">
          <button type="button"
                  class="btn btn--outline btn--sm btn-with-icon share-panel__copy-btn"
                  data-action="click->deck-form#copyShareLink"
                  data-copied-label="<%= t("decks.form.copy_link_copied") %>">
            <%= render "shared/icons/clipboard_check", css_class: "icon--sm" %>
            <span data-deck-form-target="copyLabel"><%= t("decks.form.copy_link") %></span>
          </button>
        </div>
        <% if deck.persisted? %>
          <div class="share-panel__rotate-row">
            <%= link_to t("decks.form.regenerate_link"),
                  rotate_share_token_deck_path(deck),
                  data: { turbo_method: "patch",
                          turbo_confirm: t("decks.form.regenerate_link_confirm") },
                  class: "share-panel__rotate-link" %>
          </div>
        <% end %>
      </div>

      <%# Visibility change warning (only relevant when editing an existing unlisted deck) %>
      <% if deck.persisted? && deck.unlisted? %>
        <p class="share-warning" data-deck-form-target="shareWarning" style="display:none">
          <%= t("decks.form.share_link_will_be_invalidated") %>
        </p>
      <% end %>

      <%# Section 2 — Edit Permission %>
      <div class="form-group" data-deck-form-target="editGroup">
        <span class="form-label"><%= t("decks.form.edit_permission_label") %></span>
        <div class="visibility-toggle">
          <label class="visibility-option">
            <%= f.radio_button :edit_permission, "owner_only", class: "visibility-radio",
                  data: { action: "change->deck-form#onEditPermissionChange",
                          "deck-form-target": "editPermissionRadio" } %>
            <span class="visibility-label"><%= t("decks.form.edit_permission_owner_only") %></span>
          </label>
          <label class="visibility-option">
            <%= f.radio_button :edit_permission, "password_users", class: "visibility-radio",
                  data: { action: "change->deck-form#onEditPermissionChange",
                          "deck-form-target": "editPermissionRadio" } %>
            <span class="visibility-label"><%= t("decks.form.edit_permission_password_users") %></span>
          </label>
        </div>
      </div>

      <%# Section 3 — Password (shown conditionally) %>
      <div class="form-group" data-deck-form-target="passwordSection" style="display:none">
        <%= f.label :access_password, t("decks.form.access_password_label") %>
        <%= f.password_field :access_password,
              class: "form-control",
              placeholder: t("decks.form.access_password_placeholder"),
              autocomplete: "new-password",
              data: { "deck-form-target": "passwordInput" } %>
        <p class="form-hint"><%= t("decks.form.access_password_hint") %></p>
      </div>

      <div class="nd-split__actions">
        <%= f.submit class: "btn btn--primary" %>
      </div>
    </div>
  </div>
<% end %>
