<% content_for :title, @deck.name %>

<div class="container">
  <div class="deck-detail-header" data-controller="inline-confirm">
    <div class="deck-detail-header__top">
      <h1 class="deck-detail-header__name"><%= @deck.name %></h1>
      <div class="deck-detail-header__actions" data-inline-confirm-target="actions">
        <% if @deck.user == Current.user %>
          <div class="deck-actions-menu"
               data-controller="dropdown"
               data-action="click@window->dropdown#closeIfOutside keydown.esc@window->dropdown#close">
            <button type="button"
                    class="deck-actions-menu__trigger"
                    data-dropdown-target="button"
                    data-action="click->dropdown#toggle"
                    aria-haspopup="true"
                    aria-expanded="false"
                    aria-label="<%= t('decks.show.more_actions') %>">
              <%= render "shared/icons/ellipsis_horizontal", css_class: "icon" %>
            </button>
            <div class="deck-actions-menu__dropdown" data-dropdown-target="menu" data-open="false" role="menu">
              <%= link_to edit_deck_path(@deck), class: "deck-actions-menu__item", role: "menuitem" do %>
                <%= render "shared/icons/pencil", css_class: "deck-actions-menu__item-icon" %>
                <span><%= t("decks.show.edit") %></span>
              <% end %>
              <button type="button"
                      class="deck-actions-menu__item deck-actions-menu__item--danger"
                      role="menuitem"
                      data-action="click->inline-confirm#confirmRemove click->dropdown#close">
                <%= render "shared/icons/trash", css_class: "deck-actions-menu__item-icon" %>
                <span><%= t("decks.show.delete") %></span>
              </button>
            </div>
          </div>
        <% elsif authenticated? %>
          <%= button_to fork_deck_path(@deck), method: :post, class: "btn btn--primary btn-with-icon" do %>
            <%= render "shared/icons/fork" %> <%= t("decks.show.fork") %>
          <% end %>
        <% end %>
      </div>
      <% if @deck.user == Current.user %>
        <%= render "shared/inline_confirm", message: t("decks.show.delete_confirm") %>
        <%= form_with url: deck_path(@deck), method: :delete,
              data: { "inline-confirm-target": "deleteForm" } do |f| %>
          <%= f.hidden_field :from_page, value: params[:from_page] || 1 %>
        <% end %>
      <% end %>
    </div>
    <% if @deck.description.present? %>
      <p class="deck-detail-header__description"><%= @deck.description %></p>
    <% end %>
    <div class="deck-detail-header__meta">
      <% if @deck.public? %>
        <span class="visibility-badge visibility-badge--public">
          <%= render "shared/icons/globe", css_class: "icon--sm" %> <%= t("decks.show.public_badge") %>
        </span>
      <% else %>
        <span class="visibility-badge visibility-badge--private">
          <%= render "shared/icons/lock", css_class: "icon--sm" %> <%= t("decks.show.private_badge") %>
        </span>
      <% end %>
      <% if @deck.language_code.present? %>
        <span class="language-badge"><%= @deck.language_code.upcase %></span>
      <% end %>
      <span class="deck-detail-header__date"><%= t("decks.show.created") %> <%= @deck.created_at.strftime("%b %-d, %Y") %></span>
      <% if @deck.forked_from.present? %>
        <span class="deck-detail-header__forked-from">
          <%= t("decks.show.forked_from") %> <%= link_to @deck.forked_from.name, deck_path(@deck.forked_from) %>
        </span>
      <% end %>
    </div>
  </div>

  <%# ── Embedded flashcard player (replaces study-mode-selector) ── %>
  <% if @all_flashcards.any? %>
    <div class="deck-preview-island"
         data-controller="flashcard-browse"
         data-flashcard-browse-total-value="<%= @all_flashcards.size %>"
         data-flashcard-browse-auto-focus-value="false"
         data-action="keydown->flashcard-browse#handleKey"
         tabindex="-1"
         aria-label="<%= t('decks.show.preview_aria') %>">

      <%= render "flashcard_player",
            flashcards: @all_flashcards,
            keyboard_hint: false %>

      <div class="deck-preview-island__modes">
        <span class="deck-preview-island__count">
          <%= t("decks.deck_card.count", count: @all_flashcards.size) %>
        </span>
        <%= link_to study_deck_path(@deck), class: "deck-preview-mode-btn" do %>
          <%= render "shared/icons/academic_cap" %>
          <span><%= t("decks.show.mode_study") %></span>
        <% end %>
        <% if authenticated? %>
          <%= link_to learn_deck_path(@deck), class: "deck-preview-mode-btn" do %>
            <%= render "shared/icons/rectangle_stack" %>
            <span><%= t("decks.show.mode_learn") %></span>
          <% end %>
          <%= link_to test_deck_path(@deck), class: "deck-preview-mode-btn" do %>
            <%= render "shared/icons/pencil" %>
            <span><%= t("decks.show.mode_test") %></span>
          <% end %>
        <% end %>
        <%= link_to match_deck_path(@deck), class: "deck-preview-mode-btn" do %>
          <%= render "shared/icons/bolt" %>
          <span><%= t("decks.show.mode_match") %></span>
        <% end %>
      </div>
    </div>
  <% elsif @deck.user == Current.user %>
    <div class="deck-preview-island deck-preview-island--empty">
      <%= render "shared/empty_state",
            icon: "rectangle_stack",
            title: t("decks.show.no_cards"),
            description: t("decks.show.empty_cta_description"),
            cta_text: t("decks.show.add_card"),
            cta_path: cards_deck_path(@deck),
            variant: :study %>
    </div>
  <% end %>

  <div class="cards-island">
    <div class="cards-island__header">
      <h2 class="cards-island__title"><%= t("decks.show.cards_section") %> (<%= @deck.flashcards.count %>)</h2>
      <div class="cards-island__controls">
        <% if @deck.user == Current.user %>
          <%= link_to cards_deck_path(@deck), class: "btn btn--secondary btn-with-icon btn--sm" do %>
            <%= render "shared/icons/plus" %> <%= t("decks.show.add_card") %>
          <% end %>
          <%= link_to new_deck_import_path(@deck), class: "btn btn--secondary btn-with-icon btn--sm" do %>
            <%= t("decks.show.import") %>
          <% end %>
        <% end %>
        <%= form_with url: deck_path(@deck), method: :get,
              data: { turbo_action: "replace" }, class: "items-per-page-form" do |f| %>
          <%= f.select :items,
                options_for_select([[5, 5], [10, 10], [15, 15], [20, 20], [30, 30]], @items_per_page),
                {},
                { class: "items-per-page-select",
                  onchange: "this.form.submit()",
                  title: t("decks.show.cards_per_page"),
                  "aria-label": t("decks.show.cards_per_page") } %>
        <% end %>
      </div>
    </div>

    <div class="cards-island__body">
      <% if @flashcards.empty? && @all_flashcards.any? %>
        <p class="cards-island__empty"><%= t("decks.show.no_cards") %></p>
      <% end %>
      <div class="cards-grid">
        <% @flashcards.each do |card| %>
          <div class="cards-grid__item" data-controller="<%= @deck.user == Current.user ? 'inline-confirm' : '' %>">
            <div class="cards-grid__front"><%= card.front_content %></div>
            <span class="cards-grid__sep">→</span>
            <div class="cards-grid__back"><%= card.back_content %></div>
            <% if @deck.user == Current.user %>
              <div class="cards-grid__actions" data-inline-confirm-target="actions">
                <span class="tooltip-wrap">
                  <%= link_to edit_flashcard_path(card),
                        class: "card-action-btn card-action-btn--edit",
                        aria: { label: t("decks.show.edit_card") } do %>
                    <%= render "shared/icons/pencil" %>
                  <% end %>
                  <span class="tooltip"><%= t("shared.edit") %></span>
                </span>
                <span class="tooltip-wrap">
                  <button type="button"
                          class="card-action-btn card-action-btn--delete"
                          aria-label="<%= t("decks.show.delete_card") %>"
                          data-action="click->inline-confirm#confirmRemove">
                    <%= render "shared/icons/trash" %>
                  </button>
                  <span class="tooltip"><%= t("shared.delete") %></span>
                </span>
              </div>
              <%= render "shared/inline_confirm", message: t("decks.show.delete_card_confirm") %>
              <%= form_with url: flashcard_path(card), method: :delete,
                    data: { "inline-confirm-target": "deleteForm" } do |f| %>
              <%= f.hidden_field :page,  value: @pagy.page %>
              <%= f.hidden_field :items, value: @items_per_page %>
            <% end %>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="cards-island__pagination">
        <%= render "shared/pagination", pagy: @pagy %>
      </div>
    </div>
  </div>

</div>
