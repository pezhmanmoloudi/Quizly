<% content_for :title, @deck.name %>

<div class="container">
  <div class="deck-detail-header">
    <div class="deck-detail-header__top">
      <h1 class="deck-detail-header__name"><%= @deck.name %></h1>
      <div class="deck-detail-header__actions">
        <%= link_to "Edit Deck", edit_deck_path(@deck), class: "btn btn--secondary" %>
      </div>
    </div>
    <div class="deck-detail-header__meta">
      <% if @deck.language_code.present? %>
        <span class="language-badge"><%= @deck.language_code.upcase %></span>
      <% end %>
      <span class="deck-detail-header__date">Created <%= @deck.created_at.strftime("%b %-d, %Y") %></span>
    </div>
    <% if @deck.description.present? %>
      <p class="deck-detail-header__description"><%= @deck.description %></p>
    <% end %>
  </div>

  <div class="section-header">
    <h2>Cards (<%= @deck.flashcards.count %>)</h2>
    <%= link_to "Add Card", new_deck_flashcard_path(@deck), class: "btn btn--secondary" %>
  </div>

  <% if @deck.flashcards.empty? %>
    <p class="empty-state">No flashcards yet.</p>
  <% else %>
    <div class="flashcard-list">
      <% @deck.flashcards.each do |card| %>
        <div class="flashcard-row">
          <div class="flashcard-row__content">
            <span class="flashcard-row__front"><%= card.front_content %></span>
            <span class="flashcard-row__sep">→</span>
            <span class="flashcard-row__back"><%= card.back_content %></span>
          </div>
          <div class="flashcard-row__actions">
            <%= link_to "Edit", edit_flashcard_path(card), class: "btn btn--sm btn--secondary" %>
            <%= button_to "Delete", flashcard_path(card), method: :delete, class: "btn btn--sm btn--danger",
                data: { turbo_confirm: "Delete this card?" } %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="back-link">
    <%= link_to "← All Decks", decks_path %>
  </div>
</div>
