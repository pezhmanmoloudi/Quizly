<% content_for :title, @deck.name %>

<div class="container">
  <% is_owner = @access.owner? %>
  <div class="deck-detail-header">
    <div class="deck-detail-header__top">
      <h1 class="deck-detail-header__name"><%= @deck.name %></h1>
      <div class="deck-detail-header__actions">
        <% if is_owner %>
          <%= link_to edit_deck_path(@deck), class: "btn btn--secondary btn-with-icon" do %>
            <%= render "shared/icons/pencil" %> <%= t("decks.show.edit") %>
          <% end %>
        <% end %>

        <%= render "decks/library_state", deck: @deck %>

        <% if policy(@deck).copy? %>
          <%= form_with url: copy_deck_path(@deck), method: :post do %>
            <button type="submit" class="btn btn--secondary btn-with-icon">
              <%= render "shared/icons/fork" %> <%= t("decks.action.copy") %>
            </button>
          <% end %>
        <% end %>

      </div>
    </div>
    <div class="deck-detail-header__meta">
      <% if is_owner %>
        <div data-controller="modal">
          <button type="button" class="visibility-badge-btn" data-action="click->modal#open">
            <span id="visibility-badge-<%= @deck.id %>">
              <%= render "decks/visibility_badge_content", deck: @deck %>
            </span>
          </button>
          <%= render "decks/manage_access_modal", deck: @deck %>
        </div>
      <% else %>
        <span id="visibility-badge-<%= @deck.id %>">
          <%= render "decks/visibility_badge_content", deck: @deck %>
        </span>
      <% end %>
      <% if @deck.language_code.present? %>
        <span class="language-badge"><%= @deck.language_code.upcase %></span>
      <% end %>
      <span class="deck-detail-header__date"><%= t("decks.show.created") %> <%= @deck.created_at.strftime("%b %-d, %Y") %></span>
    </div>
    <% if @deck.description.present? %>
      <p class="deck-detail-header__description"><%= @deck.description %></p>
    <% end %>

  </div>

  <div class="study-mode-selector">
    <%= link_to flashcard_deck_path(@deck), class: "study-mode-btn study-mode-btn--flashcards" do %>
      <%= render "shared/icons/play" %>
      <span><%= t("decks.show.mode_flashcard") %></span>
    <% end %>
    <%= link_to study_deck_path(@deck), class: "study-mode-btn study-mode-btn--study" do %>
      <%= render "shared/icons/academic_cap" %>
      <span><%= t("decks.show.mode_study") %></span>
    <% end %>
    <% if authenticated? %>
      <%= link_to learn_deck_path(@deck), class: "study-mode-btn study-mode-btn--learn" do %>
        <%= render "shared/icons/rectangle_stack" %>
        <span><%= t("decks.show.mode_learn") %></span>
      <% end %>
      <%= link_to test_deck_path(@deck), class: "study-mode-btn study-mode-btn--test" do %>
        <%= render "shared/icons/pencil" %>
        <span><%= t("decks.show.mode_test") %></span>
      <% end %>
    <% end %>
    <%= link_to match_deck_path(@deck), class: "study-mode-btn study-mode-btn--match" do %>
      <%= render "shared/icons/bolt" %>
      <span><%= t("decks.show.mode_match") %></span>
    <% end %>
  </div>

  <div class="cards-island">
    <div class="cards-island__header">
      <h2 class="cards-island__title">
        <%= t("decks.show.cards_section") %>
        <span class="cards-island__count" id="deck_<%= @deck.id %>_card_count"><%= @deck.flashcards.count %></span>
      </h2>
      <div class="cards-island__controls">
        <%= form_with url: deck_path(@deck), method: :get,
              data: { turbo_action: "replace" }, class: "items-per-page-form" do |f| %>
          <%= f.select :items,
                options_for_select([[5, 5], [10, 10], [15, 15], [20, 20], [30, 30]], @items_per_page),
                {},
                { class: "items-per-page-select",
                  onchange: "this.form.submit()",
                  title: t("decks.show.cards_per_page"),
                  "aria-label": t("decks.show.cards_per_page") } %>
        <% end %>
      </div>
    </div>

    <div class="cards-island__body">
      <div class="cards-grid">
          <% @flashcards.each do |card| %>
            <div id="<%= dom_id(card) %>" class="cards-grid__item">
              <div class="cards-grid__front"><%= card.front_content %></div>
              <span class="cards-grid__sep">→</span>
              <div class="cards-grid__back"><%= card.back_content %></div>
            </div>
          <% end %>
        </div>

        <div class="cards-island__pagination">
          <%= render "shared/pagination", pagy: @pagy %>
        </div>
    </div>
  </div>

</div>
