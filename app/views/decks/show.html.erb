<% content_for :title, @deck.name %>

<div class="container">
  <% can_edit   = @deck.can_edit?(Current.user) %>
  <% can_delete = @deck.can_delete?(Current.user) %>
  <div class="deck-detail-header" <% if can_delete %>data-controller="modal"<% end %>>
    <div class="deck-detail-header__top">
      <h1 class="deck-detail-header__name"><%= @deck.name %></h1>
      <div class="deck-detail-header__actions">
        <% if can_edit %>
          <%= link_to edit_deck_path(@deck), class: "btn btn--secondary btn-with-icon" do %>
            <%= render "shared/icons/pencil" %> <%= t("decks.show.edit") %>
          <% end %>
        <% end %>

        <%= render "decks/library_state", deck: @deck %>

        <% if can_delete %>
          <button type="button" class="btn btn--danger btn-with-icon"
                  data-action="click->modal#open">
            <%= render "shared/icons/trash" %> <%= t("decks.show.delete") %>
          </button>
        <% end %>
      </div>
    </div>
    <div class="deck-detail-header__meta">
      <% if @deck.public? %>
        <span class="visibility-badge visibility-badge--public">
          <%= render "shared/icons/globe", css_class: "icon--sm" %> <%= t("decks.show.public_badge") %>
        </span>
      <% elsif @deck.unlisted? %>
        <span class="visibility-badge visibility-badge--unlisted">
          <%= render "shared/icons/link", css_class: "icon--sm" %> <%= t("decks.show.unlisted_badge") %>
        </span>
      <% else %>
        <span class="visibility-badge visibility-badge--private">
          <%= render "shared/icons/lock", css_class: "icon--sm" %> <%= t("decks.show.private_badge") %>
        </span>
      <% end %>
      <% if @deck.language_code.present? %>
        <span class="language-badge"><%= @deck.language_code.upcase %></span>
      <% end %>
      <span class="deck-detail-header__date"><%= t("decks.show.created") %> <%= @deck.created_at.strftime("%b %-d, %Y") %></span>
    </div>
    <% if @deck.description.present? %>
      <p class="deck-detail-header__description"><%= @deck.description %></p>
    <% end %>

    <% if can_delete %>
      <% deck_modal_body = capture do %>
        <p><strong><%= @deck.name %></strong></p>
        <p><%= t("decks.show.delete_modal_card_count", count: @deck.flashcards_count) %></p>
        <p class="modal-warning"><%= t("decks.show.delete_modal_warning") %></p>
      <% end %>
      <%= render "shared/destructive_modal",
            modal_id: "delete-deck-modal",
            title: t("decks.show.delete_modal_title"),
            body_html: deck_modal_body,
            confirm_label: t("decks.show.delete_modal_confirm"),
            form_url: deck_path(@deck),
            form_method: :delete,
            hidden_fields: { from_page: params[:from_page] || 1 } %>
    <% end %>
  </div>

  <% if @locked %>
    <%= render "decks/locked_preview", deck: @deck, sample_flashcards: @sample_flashcards, locked_cards_count: @locked_cards_count %>
  <% else %>

  <div class="study-mode-selector">
    <%= link_to flashcard_deck_path(@deck), class: "study-mode-btn study-mode-btn--flashcards" do %>
      <%= render "shared/icons/play" %>
      <span><%= t("decks.show.mode_flashcard") %></span>
    <% end %>
    <%= link_to study_deck_path(@deck), class: "study-mode-btn study-mode-btn--study" do %>
      <%= render "shared/icons/academic_cap" %>
      <span><%= t("decks.show.mode_study") %></span>
    <% end %>
    <% if authenticated? %>
      <%= link_to learn_deck_path(@deck), class: "study-mode-btn study-mode-btn--learn" do %>
        <%= render "shared/icons/rectangle_stack" %>
        <span><%= t("decks.show.mode_learn") %></span>
      <% end %>
      <%= link_to test_deck_path(@deck), class: "study-mode-btn study-mode-btn--test" do %>
        <%= render "shared/icons/pencil" %>
        <span><%= t("decks.show.mode_test") %></span>
      <% end %>
    <% end %>
    <%= link_to match_deck_path(@deck), class: "study-mode-btn study-mode-btn--match" do %>
      <%= render "shared/icons/bolt" %>
      <span><%= t("decks.show.mode_match") %></span>
    <% end %>
  </div>

  <div class="cards-island">
    <div class="cards-island__header">
      <h2 class="cards-island__title">
        <%= t("decks.show.cards_section") %>
        <span class="cards-island__count" id="deck_<%= @deck.id %>_card_count"><%= @deck.flashcards.count %></span>
      </h2>
      <div class="cards-island__controls">
        <% if can_edit %>
          <%= link_to new_deck_flashcard_path(@deck), class: "btn btn--primary btn-with-icon btn--sm" do %>
            <%= render "shared/icons/plus" %> <%= t("decks.show.add_card") %>
          <% end %>
          <div data-controller="modal">
            <button type="button"
                    class="btn btn--outline btn-with-icon btn--sm"
                    data-action="click->modal#open">
              <%= render "shared/icons/arrow_down_tray" %> <%= t("decks.show.import") %>
            </button>
            <%= render "imports/modal", deck: @deck %>
          </div>
        <% end %>
        <%= form_with url: deck_path(@deck), method: :get,
              data: { turbo_action: "replace" }, class: "items-per-page-form" do |f| %>
          <%= f.select :items,
                options_for_select([[5, 5], [10, 10], [15, 15], [20, 20], [30, 30]], @items_per_page),
                {},
                { class: "items-per-page-select",
                  onchange: "this.form.submit()",
                  title: t("decks.show.cards_per_page"),
                  "aria-label": t("decks.show.cards_per_page") } %>
        <% end %>
      </div>
    </div>

    <div class="cards-island__body">
      <div class="cards-grid">
          <% @flashcards.each do |card| %>
            <div id="<%= dom_id(card) %>" class="cards-grid__item">
              <div class="cards-grid__front"><%= card.front_content %></div>
              <span class="cards-grid__sep">→</span>
              <div class="cards-grid__back"><%= card.back_content %></div>
              <% if can_edit %>
                <div class="cards-grid__actions">
                  <span class="tooltip-wrap">
                    <%= link_to edit_flashcard_path(card),
                          class: "card-action-btn card-action-btn--edit",
                          aria: { label: t("decks.show.edit_card") } do %>
                      <%= render "shared/icons/pencil" %>
                    <% end %>
                    <span class="tooltip"><%= t("shared.edit") %></span>
                  </span>
                  <span class="tooltip-wrap">
                    <button type="submit"
                            form="delete-card-<%= card.id %>"
                            class="card-action-btn card-action-btn--delete"
                            aria-label="<%= t("decks.show.delete_card") %>">
                      <%= render "shared/icons/trash" %>
                    </button>
                    <span class="tooltip"><%= t("shared.delete") %></span>
                  </span>
                </div>
                <%= form_with url: flashcard_path(card), method: :delete,
                      id: "delete-card-#{card.id}",
                      style: "display:none" do |f| %>
                  <%= f.hidden_field :page,  value: @pagy.page %>
                  <%= f.hidden_field :items, value: @items_per_page %>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>

        <div class="cards-island__pagination">
          <%= render "shared/pagination", pagy: @pagy %>
        </div>
    </div>
  </div>

  <% end %>
</div>
