<% due = local_assigns[:due_counts]&.fetch(deck.id, 0) || 0 %>
<% last_studied = local_assigns[:last_studied_dates]&.fetch(deck.id, nil) %>

<a id="<%= dom_id(deck) %>" class="deck-tile" href="<%= deck_path(deck, from_page: local_assigns[:from_page] || 1) %>">
  <div class="deck-tile__top-meta">
    <div class="deck-tile__author-info">
      <div class="deck-tile__avatar">
        <% if Current.user.show_avatar? %>
          <%= image_tag Current.user.avatar.variant(resize_to_fill: [32, 32]), alt: "" %>
        <% else %>
          <span class="deck-tile__avatar-initials"><%= Current.user.display_name.first&.upcase %></span>
        <% end %>
      </div>
      <span class="deck-tile__author-name"><%= Current.user.display_name %></span>
    </div>
  </div>

  <div class="deck-tile__visibility-group">
    <% if deck.draft? %>
      <span class="deck-tile__draft-badge"><%= t("decks.deck_card.draft") %></span>
    <% end %>
    <% if deck.password_protected? %>
      <% deck_unlocked = (Current.user&.id == deck.user_id) || Decks::AccessService.unlocked?(deck: deck, session: session) %>
      <span class="deck-tile__lock-icon <%= deck_unlocked ? 'deck-tile__lock-icon--open' : 'deck-tile__lock-icon--closed' %>">
        <% if deck_unlocked %>
          <%= render "shared/icons/lock_open", css_class: "deck-tile__badge-icon" %>
        <% else %>
          <%= render "shared/icons/lock", css_class: "deck-tile__badge-icon" %>
        <% end %>
      </span>
    <% end %>
    <span class="deck-tile__visibility-badge deck-tile__visibility-badge--<%= deck.visibility %>">
      <% if deck.private? %>
        <%= render "shared/icons/lock", css_class: "deck-tile__badge-icon" %>
      <% end %>
      <%= t("decks.show.#{deck.visibility}_badge") %>
    </span>
  </div>

  <div class="deck-tile__body">
    <h3 class="deck-tile__name"><%= deck.name %></h3>
    <% if deck.description.present? %>
      <p class="deck-tile__description"><%= deck.description %></p>
    <% end %>
    <% if deck.tag_list.any? %>
      <div class="deck-tile__tags">
        <% deck.tag_list.first(3).each do |tag| %>
          <span class="tag-badge">#<%= tag %></span>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="deck-tile__footer">
    <div class="deck-tile__stat">
      <%= render "shared/icons/rectangle_stack", css_class: "deck-tile__stat-icon" %>
      <div class="deck-tile__stat-content">
        <span class="deck-tile__stat-value"><%= deck.flashcards_count %></span>
        <span class="deck-tile__stat-label"><%= t("decks.deck_card.cards_label") %></span>
      </div>
    </div>
    <div class="deck-tile__stat">
      <%= render "shared/icons/clock", css_class: "deck-tile__stat-icon" %>
      <div class="deck-tile__stat-content">
        <span class="deck-tile__stat-value"><%= due %></span>
        <span class="deck-tile__stat-label"><%= t("decks.deck_card.due_label") %></span>
      </div>
    </div>
    <div class="deck-tile__stat">
      <%= render "shared/icons/calendar_days", css_class: "deck-tile__stat-icon" %>
      <div class="deck-tile__stat-content">
        <% if last_studied %>
          <span class="deck-tile__stat-value"><%= time_ago_in_words(last_studied) %></span>
        <% else %>
          <span class="deck-tile__stat-value deck-tile__stat-value--none">&mdash;</span>
        <% end %>
        <span class="deck-tile__stat-label"><%= t("decks.deck_card.studied_label") %></span>
      </div>
    </div>
  </div>
</a>
