<a id="<%= dom_id(deck) %>" class="deck-tile" href="<%= deck_path(deck, from_page: local_assigns[:from_page] || 1) %>">
  <div class="deck-tile__header">
    <h3 class="deck-tile__name">
      <%= deck.name %>
    </h3>
    <% due = local_assigns[:due_counts]&.fetch(deck.id, 0) || 0 %>
    <% if due > 0 %>
      <span class="due-badge" title="<%= t("decks.deck_card.due", count: due) %>">
        <%= due %>
      </span>
    <% end %>
    <% if local_assigns[:show_draft_badge] && deck.draft? %>
      <span class="draft-badge"><%= t("decks.deck_card.draft") %></span>
    <% end %>
  </div>

  <div class="deck-tile__body">
    <% if deck.description.present? %>
      <p class="deck-tile__description"><%= deck.description %></p>
    <% end %>
    <div class="deck-tile__meta-row">
      <span class="deck-tile__meta"><%= t("decks.deck_card.count", count: deck.flashcards.size) %></span>
      <% if deck.language_code.present? %>
        <span class="deck-tile__lang-badge"><%= deck.language_code.upcase %></span>
      <% end %>
    </div>
    <% if deck.tag_list.any? %>
      <div class="deck-tile__tags">
        <% deck.tag_list.first(3).each do |tag| %>
          <span class="tag-badge"><%= tag %></span>
        <% end %>
      </div>
    <% end %>
  </div>
</a>
