<div id="<%= dom_id(deck) %>" class="deck-tile" data-controller="inline-confirm">
  <div class="deck-tile__header">
    <h3 class="deck-tile__name">
      <%= link_to deck.name, deck_path(deck) %>
    </h3>
    <span class="deck-tile__date"><%= deck.created_at.strftime("%b %-d, %Y") %></span>
  </div>

  <div class="deck-tile__body">
    <% if deck.description.present? %>
      <p class="deck-tile__description"><%= deck.description %></p>
    <% end %>
    <p class="deck-tile__meta"><%= pluralize(deck.flashcards.size, "card") %></p>
  </div>

  <div class="deck-tile__footer" data-inline-confirm-target="actions">
    <%= link_to study_deck_path(deck), class: "btn btn--primary btn--sm btn-with-icon" do %>
      <%= render "shared/icons/play" %> Study
    <% end %>
    <%= link_to edit_deck_path(deck), class: "btn btn--secondary btn--sm btn-with-icon" do %>
      <%= render "shared/icons/pencil" %> Edit
    <% end %>
    <button type="button" class="btn btn--danger btn--sm btn-with-icon"
            data-action="click->inline-confirm#confirmRemove">
      <%= render "shared/icons/trash" %> Delete
    </button>
  </div>

  <%= render "shared/inline_confirm", message: "Are you sure you want to remove this deck?" %>

  <%= form_with url: deck_path(deck), method: :delete,
        data: { "inline-confirm-target": "deleteForm" } do %>
  <% end %>
</div>
