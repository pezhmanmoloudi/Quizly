<% due = local_assigns[:due_counts]&.fetch(deck.id, 0) || 0 %>
<% last_studied = local_assigns[:last_studied_dates]&.fetch(deck.id, nil) %>

<div id="<%= dom_id(deck) %>" class="deck-row">
  <div class="deck-row__identity">
    <h3 class="deck-row__title-link-wrap">
      <a class="deck-row__title-link" href="<%= deck_path(deck, from_page: local_assigns[:from_page] || 1) %>">
        <%= deck.name %>
      </a>
    </h3>
    <div class="deck-row__meta">
      <div class="deck-row__avatar">
        <% if Current.user.show_avatar? %>
          <%= image_tag Current.user.avatar.variant(resize_to_fill: [22, 22]), alt: "" %>
        <% else %>
          <span class="deck-row__avatar-initials"><%= Current.user.display_name.first&.upcase %></span>
        <% end %>
      </div>
      <span class="deck-row__author"><%= Current.user.display_name %></span>
      <span class="deck-row__meta-sep" aria-hidden="true">·</span>
      <span class="deck-row__time"><%= t("decks.deck_card.studied_time", time: localized_time_ago(deck.updated_at)) %></span>
    </div>
    <% if deck.tag_list.any? %>
      <div class="deck-row__tags">
        <% deck.tag_list.first(3).each do |tag| %>
          <span class="deck-row__tag">#<%= tag %></span>
        <% end %>
        <% if deck.tag_list.size > 3 %>
          <span class="deck-row__tag"><%= t("decks.deck_card.more_tags", count: deck.tag_list.size - 3) %></span>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="deck-row__col deck-row__col--cards">
    <%= render "shared/icons/rectangle_stack", css_class: "deck-row__col-icon deck-row__col-icon--cards" %>
    <span class="deck-row__col-value"><%= localized_number(deck.flashcards_count) %></span>
    <span class="deck-row__col-label"><%= t("decks.deck_card.cards_label") %></span>
  </div>

  <div class="deck-row__col deck-row__col--due">
    <%= render "shared/icons/clock", css_class: "deck-row__col-icon deck-row__col-icon--due" %>
    <span class="deck-row__col-value"><%= localized_number(due) %></span>
    <span class="deck-row__col-label"><%= t("decks.deck_card.due_label") %></span>
  </div>

  <div class="deck-row__col deck-row__col--studied">
    <%= render "shared/icons/calendar_days", css_class: "deck-row__col-icon deck-row__col-icon--studied" %>
    <% if last_studied %>
      <span class="deck-row__col-value"><%= localized_time_ago(last_studied) %></span>
    <% else %>
      <span class="deck-row__col-value deck-row__col-value--none">&mdash;</span>
    <% end %>
    <span class="deck-row__col-label"><%= t("decks.deck_card.studied_label") %></span>
  </div>

  <div class="deck-row__col deck-row__col--visibility">
    <% if deck.draft? %>
      <span class="deck-row__draft-badge">
        <%= render "shared/icons/pencil", css_class: "deck-row__badge-icon" %>
        <%= t("decks.deck_card.draft") %>
      </span>
    <% end %>
    <% if deck.password_protected? %>
      <% deck_unlocked = (Current.user&.id == deck.user_id) || Decks::AccessService.unlocked?(deck: deck, session: session) %>
      <span class="deck-row__lock-icon deck-row__lock-icon--<%= deck_unlocked ? 'open' : 'closed' %>">
        <%= render "shared/icons/#{deck_unlocked ? 'lock_open' : 'lock'}", css_class: "deck-row__badge-icon" %>
      </span>
    <% end %>
    <span class="deck-row__visibility-badge deck-row__visibility-badge--<%= deck.visibility %>">
      <% if deck.public? %>
        <%= render "shared/icons/globe", css_class: "deck-row__badge-icon" %>
      <% else %>
        <%= render "shared/icons/lock", css_class: "deck-row__badge-icon" %>
      <% end %>
      <%= t("decks.show.#{deck.visibility}_badge") %>
    </span>
  </div>

  <% if local_assigns[:folder] %>
    <div class="deck-row__col deck-row__col--actions"
         data-controller="create-menu"
         data-action="click@document->create-menu#closeIfOutside keydown.esc@document->create-menu#close">
      <button class="deck-row__col-menu-btn"
              data-create-menu-target="button"
              data-action="click->create-menu#toggle"
              aria-haspopup="true"
              aria-label="<%= t('folders.show.deck_options_aria') %>">
        <%= render "shared/icons/ellipsis_vertical", css_class: "deck-row__col-menu-icon" %>
      </button>
      <div data-create-menu-target="menu"
           data-open="false"
           class="deck-row__col-menu"
           role="menu">
        <%= button_to t("folders.show.remove_from_folder"),
              folder_deck_path(local_assigns[:folder]),
              method: :delete,
              params: { deck_id: deck.id },
              class: "deck-row__col-menu-item deck-row__col-menu-item--danger",
              role: "menuitem" %>
      </div>
    </div>
  <% end %>
</div>
