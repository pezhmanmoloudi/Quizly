<% content_for :title, "Match: #{@deck.name}" %>

<div class="study-container">
  <div class="study-header">
    <h2><%= @deck.name %></h2>
    <%= link_to "← Exit", @deck, class: "study-exit" %>
  </div>

  <% if @cards.empty? %>
    <%= render "shared/empty_state",
          icon: "bolt",
          title: "No cards yet",
          description: "Add some cards to this deck to play Match.",
          cta_text: "Back to Deck",
          cta_path: @deck,
          variant: :study %>
  <% else %>
    <div class="match-game"
         data-controller="match"
         data-match-total-value="<%= @cards.size %>">

      <div class="match-game__grid">
        <%# Render fronts and backs shuffled together %>
        <% tiles = @cards.flat_map { |c| [
          { id: c.id, side: "front", text: c.front_content },
          { id: c.id, side: "back",  text: c.back_content }
        ] }.shuffle %>
        <% tiles.each do |tile| %>
          <button class="match-tile"
                  data-action="click->match#select"
                  data-match-id="<%= tile[:id] %>"
                  data-match-side="<%= tile[:side] %>">
            <%= tile[:text] %>
          </button>
        <% end %>
      </div>

      <div class="match-game__complete" hidden data-match-target="complete">
        <p class="match-game__complete-msg">All matched!</p>
        <%= link_to "Play Again", match_deck_path(@deck), class: "btn btn--primary btn--sm" %>
        <%= link_to "Back to Deck", @deck, class: "btn btn--secondary btn--sm" %>
      </div>
    </div>

    <% unless authenticated? %>
      <div class="guest-cta-banner">
        <span class="guest-cta-banner__text">Sign in to save your scores and track improvement over time.</span>
        <div class="guest-cta-banner__actions">
          <%= link_to "Sign in", login_path, class: "btn btn--primary btn--sm" %>
          <%= link_to "Sign up free", signup_path, class: "btn btn--secondary btn--sm" %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
