<% content_for :title, "Match: #{@deck.name}" %>

<div class="study-container">
  <div class="study-header">
    <h2><%= @deck.name %></h2>
    <%= link_to t("study_modes.exit"), @deck, class: "study-exit" %>
  </div>

  <% if @cards.empty? %>
    <%= render "shared/empty_state",
          icon: "bolt",
          title: t("study_modes.no_cards_title"),
          description: t("study_modes.match.empty_description"),
          cta_text: t("study_modes.back_to_deck"),
          cta_path: @deck,
          variant: :study %>
  <% else %>
    <div class="match-game"
         data-controller="match"
         data-match-total-value="<%= @cards.size %>">

      <div class="match-game__grid">
        <% tiles = @cards.flat_map { |c| [
          { id: c.id, side: "front", text: c.front_content },
          { id: c.id, side: "back",  text: c.back_content }
        ] }.shuffle %>
        <% tiles.each do |tile| %>
          <button class="match-tile"
                  data-action="click->match#select"
                  data-match-id="<%= tile[:id] %>"
                  data-match-side="<%= tile[:side] %>">
            <%= tile[:text] %>
          </button>
        <% end %>
      </div>

      <div class="match-game__complete" hidden data-match-target="complete">
        <p class="match-game__complete-msg"><%= t("study_modes.match.completed") %></p>
        <%= link_to t("study_modes.match.play_again"), match_deck_path(@deck), class: "btn btn--primary btn--sm" %>
        <%= link_to t("study_modes.back_to_deck"), @deck, class: "btn btn--secondary btn--sm" %>
      </div>
    </div>

    <% unless authenticated? %>
      <div class="guest-cta-banner">
        <span class="guest-cta-banner__text"><%= t("study_modes.match.guest_cta") %></span>
        <div class="guest-cta-banner__actions">
          <%= link_to t("shared.sign_in"), login_path, class: "btn btn--primary btn--sm" %>
          <%= link_to t("shared.sign_up_free"), signup_path, class: "btn btn--secondary btn--sm" %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
