<% is_owner = local_assigns.fetch(:is_owner, false) %>
<% modal_label = is_owner ? t("decks.show.duplicate") : t("decks.show.fork") %>

<div id="fork-deck-modal"
     data-modal-target="dialog"
     class="modal-wrapper"
     role="dialog"
     aria-modal="true"
     aria-labelledby="fork-deck-modal-title"
     hidden>
  <div class="modal-overlay" data-action="click->modal#closeOnBackdrop">
    <div class="modal-dialog">
      <h2 id="fork-deck-modal-title" class="modal-title"><%= modal_label %></h2>

      <%= form_with url: fork_deck_path(deck), method: :post do %>
        <div class="form-group">
          <%= label_tag "fork_name", t("decks.form.name_label") %>
          <%= text_field_tag "deck[name]", deck.name,
                id: "fork_name",
                class: "form-control",
                required: true,
                maxlength: 100 %>
        </div>

        <div class="form-group">
          <%= label_tag "fork_visibility", t("decks.form.visibility_label") %>
          <%= select_tag "deck[visibility]",
                options_for_select([
                  [t("decks.form.visibility_private"),  "private"],
                  [t("decks.form.visibility_unlisted"), "unlisted"],
                  [t("decks.form.visibility_everyone"), "everyone"]
                ], "private"),
                id: "fork_visibility",
                class: "form-control" %>
        </div>

        <div class="modal-actions">
          <button type="button" class="btn btn--secondary"
                  data-action="click->modal#close">
            <%= t("shared.cancel") %>
          </button>
          <button type="submit" class="btn btn--primary"
                  data-turbo-submits-with="<%= t("decks.fork_modal.submitting") %>">
            <%= modal_label %>
          </button>
        </div>
      <% end %>
    </div>
  </div>
</div>
