<% is_owner = local_assigns.fetch(:is_owner, false) %>
<% modal_title = is_owner ? t("decks.fork_modal.title_duplicate") : t("decks.fork_modal.title_fork") %>
<% submit_label = is_owner ? t("decks.fork_modal.submit_duplicate") : t("decks.fork_modal.submit_fork") %>

<div id="fork-deck-modal"
     data-modal-target="dialog"
     class="modal-wrapper"
     role="dialog"
     aria-modal="true"
     aria-labelledby="fork-deck-modal-title"
     hidden>
  <div class="modal-overlay" data-action="click->modal#closeOnBackdrop">
    <div class="modal-dialog fork-modal">
      <h2 id="fork-deck-modal-title" class="modal-title"><%= modal_title %></h2>

      <% unless is_owner %>
        <div class="fork-modal__source">
          <span class="fork-modal__source-label"><%= t("decks.fork_modal.source_label") %></span>
          <span class="fork-modal__source-name"><%= deck.name %></span>
          <span class="fork-modal__source-meta">
            <%= t("explore.by") %> <%= deck.user.display_name %>
            <% if deck.flashcards.any? %>
              · <%= t("decks.deck_card.count", count: deck.flashcards.size) %>
            <% end %>
            <% if deck.language_code.present? %>
              · <%= deck.language_code.upcase %>
            <% end %>
          </span>
        </div>
      <% end %>

      <%= form_with url: fork_deck_path(deck), method: :post do %>
        <div class="form-group">
          <%= label_tag "fork_name", t("decks.fork_modal.name_label") %>
          <%= text_field_tag "deck[name]", deck.name,
                id: "fork_name",
                class: "form-control",
                required: true,
                maxlength: 100 %>
        </div>

        <fieldset class="fork-modal__visibility-fieldset">
          <legend class="fork-modal__visibility-legend"><%= t("decks.fork_modal.visibility_label") %></legend>
          <div class="fork-modal__visibility-options">
            <label class="fork-modal__visibility-option">
              <input type="radio" name="deck[visibility]" value="private" checked>
              <span class="fork-modal__visibility-card">
                <span class="fork-modal__visibility-icon">🔒</span>
                <span class="fork-modal__visibility-text">
                  <span class="fork-modal__visibility-name"><%= t("decks.form.visibility_private") %></span>
                  <span class="fork-modal__visibility-desc"><%= t("decks.fork_modal.visibility_private_desc") %></span>
                </span>
              </span>
            </label>
            <label class="fork-modal__visibility-option">
              <input type="radio" name="deck[visibility]" value="unlisted">
              <span class="fork-modal__visibility-card">
                <span class="fork-modal__visibility-icon">🔗</span>
                <span class="fork-modal__visibility-text">
                  <span class="fork-modal__visibility-name"><%= t("decks.form.visibility_unlisted") %></span>
                  <span class="fork-modal__visibility-desc"><%= t("decks.fork_modal.visibility_unlisted_desc") %></span>
                </span>
              </span>
            </label>
            <label class="fork-modal__visibility-option">
              <input type="radio" name="deck[visibility]" value="everyone">
              <span class="fork-modal__visibility-card">
                <span class="fork-modal__visibility-icon">🌐</span>
                <span class="fork-modal__visibility-text">
                  <span class="fork-modal__visibility-name"><%= t("decks.form.visibility_everyone") %></span>
                  <span class="fork-modal__visibility-desc"><%= t("decks.fork_modal.visibility_everyone_desc") %></span>
                </span>
              </span>
            </label>
          </div>
        </fieldset>

        <div class="modal-actions">
          <button type="button" class="btn btn--secondary"
                  data-action="click->modal#close">
            <%= t("shared.cancel") %>
          </button>
          <button type="submit" class="btn btn--primary"
                  data-turbo-submits-with="<%= t("decks.fork_modal.submitting_new") %>">
            <%= submit_label %>
          </button>
        </div>
      <% end %>
    </div>
  </div>
</div>
