<% content_for :title, t("passwords.new.title") %>

<div class="auth-split">
  <div class="auth-split__form">
    <%= link_to login_path, class: "auth-split__logo", dir: "ltr" do %>
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="28" height="28" rx="7" fill="currentColor" opacity="0.15"/>
        <text x="14" y="19" text-anchor="middle" font-size="14" font-weight="700" fill="currentColor">Q</text>
      </svg>
      Quizly
    <% end %>

    <h1 class="auth-split__heading"><%= t("passwords.new.heading") %></h1>
    <p class="auth-split__sub"><%= t("passwords.new.subheading") %></p>

    <%= form_with url: forgot_password_path do |f| %>
      <div class="form-group" data-controller="field-error">
        <%= f.label :email_address, t("passwords.new.email_label") %>
        <div class="auth-input">
          <svg class="auth-input__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/>
            <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/>
          </svg>
          <%= f.email_field :email_address, required: true, autofocus: true,
                autocomplete: "username", class: "form-control",
                placeholder: t("passwords.new.email_placeholder"),
                value: params[:email_address],
                data: { field_error_target: "input", action: "blur->field-error#validate input->field-error#clear" } %>
        </div>
        <span class="field-error" data-field-error-target="message" hidden aria-live="polite"></span>
      </div>

      <%= f.submit t("passwords.new.submit"), class: "btn btn--primary btn--block" %>
    <% end %>

    <p class="auth-split__footer">
      <%= link_to t("passwords.new.back"), login_path %>
    </p>
  </div>

  <%= render "auth_panel" %>
</div>
