<% content_for :title, "Forgot Password" %>

<div class="auth-container">
  <h1>Forgot your password?</h1>

  <%= form_with url: passwords_path do |f| %>
    <div class="form-group">
      <%= f.label :email_address, "Email" %>
      <%= f.email_field :email_address, required: true, autofocus: true,
            autocomplete: "username", class: "form-control",
            value: params[:email_address] %>
    </div>

    <%= f.submit "Send reset instructions", class: "btn btn--primary" %>
  <% end %>

  <p style="margin-top:1rem;font-size:0.875rem;">
    <%= link_to "Back to sign in", new_session_path %>
  </p>
</div>
