<!DOCTYPE html>
<html dir="<%= Language::RTL_LOCALES.include?(I18n.locale.to_s) ? "rtl" : "ltr" %>">
  <head>
    <title><%= [content_for(:title).presence, "Quizly"].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="color-scheme" content="light">

    <%= yield :head %>

    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.svg?v=3" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.svg?v=3">

    <script nonce="<%= content_security_policy_nonce %>">
      (function() {
        var stored = localStorage.getItem("color-theme");
        var t = (stored === "dark" || stored === "light")
          ? stored
          : (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.dataset.theme = t;
        document.querySelector('meta[name="color-scheme"]').content = t;
      })();
    </script>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= content_for(:body_class) %>" data-controller="theme">
    <% if authenticated? %>
      <div class="drawer"
           data-controller="sidebar"
           data-action="keydown.ctrl+k@window->sidebar#focusSearch keydown.meta+k@window->sidebar#focusSearch">

        <input id="app-drawer" type="checkbox" class="drawer-toggle"
               data-sidebar-target="toggle" />

        <div class="drawer-content">
        <main class="main-content">
          <div class="topbar">
            <%# Left: hamburger + brand %>
            <div class="topbar__left">
              <label for="app-drawer" class="topbar__menu-btn"
                     aria-label="<%= t("topbar.open_navigation") %>">
                <%= render "shared/icons/menu" %>
              </label>
              <%= link_to "Quizly", root_path, class: "topbar__brand", dir: "ltr" %>
            </div>

            <%# Center: global search (hidden on mobile) %>
            <div class="topbar__center">
              <%= form_with url: navbar_search_path, method: :get, class: "topbar__search" do |f| %>
                <div class="topbar__search-wrap">
                  <%= render "shared/icons/magnifying_glass", css_class: "topbar__search-icon" %>
                  <%= f.search_field :q,
                        value: params[:q],
                        placeholder: t("topbar.search_placeholder"),
                        class: "topbar__search-input",
                        data: { sidebar_target: "searchInput" },
                        aria: { label: t("topbar.search_aria") },
                        autocomplete: "off" %>
                  <kbd class="topbar__search-kbd">Ctrl K</kbd>
                </div>
              <% end %>
            </div>

            <%# Right: create action + avatar dropdown (always visible) %>
            <div class="topbar__right">
              <div class="topbar__create"
                   data-controller="create-menu"
                   data-action="click@document->create-menu#closeIfOutside keydown.esc@document->create-menu#close">

                <button class="topbar__create-btn header-action-btn"
                        data-create-menu-target="button"
                        data-action="click->create-menu#toggle"
                        data-tooltip="<%= t('topbar.create_menu_tooltip') %>"
                        aria-haspopup="true"
                        aria-expanded="false"
                        aria-label="<%= t('topbar.create_menu_aria') %>">
                  <%= render "shared/icons/plus", css_class: "topbar__create-icon" %>
                </button>

                <div class="create-menu__dropdown"
                     data-create-menu-target="menu"
                     data-open="false"
                     role="menu">

                  <%= link_to decks_path,
                        data: { turbo_method: :post },
                        class: "create-menu__item",
                        role: "menuitem" do %>
                    <%= render "shared/icons/rectangle_stack", css_class: "create-menu__item-icon" %>
                    <span><%= t("topbar.create.deck") %></span>
                  <% end %>

                  <%= link_to new_folder_path,
                        class: "create-menu__item",
                        role: "menuitem",
                        data: { turbo_frame: "modal", action: "click->create-menu#close" } do %>
                    <%= render "shared/icons/folder", css_class: "create-menu__item-icon" %>
                    <span><%= t("topbar.create.folder") %></span>
                  <% end %>

                </div>
              </div>

              <%# Notification center %>
              <%# Real-time subscription: badge updates pushed via after_create/update_commit on Notification %>
              <%= turbo_stream_from [Current.user, "notifications"] %>
              <div class="topbar__notif"
                   data-controller="notification-center"
                   data-action="click@document->notification-center#closeIfOutside keydown.esc@document->notification-center#close">

                <button class="topbar__notif-btn header-action-btn"
                        data-notification-center-target="button"
                        data-action="click->notification-center#toggle"
                        aria-expanded="false"
                        aria-controls="notification-dropdown"
                        aria-label="<%= t('notifications.bell_aria') %>">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
                       width="18" height="18" aria-hidden="true">
                    <path d="M4.214 3.227a.75.75 0 0 0-1.156-.956 8.97 8.97 0 0 0-1.856 3.826.75.75 0 0 0 1.466.316 7.47 7.47 0 0 1 1.546-3.186ZM16.942 2.271a.75.75 0 0 0-1.157.956 7.47 7.47 0 0 1 1.547 3.186.75.75 0 0 0 1.466-.316 8.971 8.971 0 0 0-1.856-3.826Z"/>
                    <path fill-rule="evenodd" d="M10 2a6 6 0 0 0-6 6c0 1.887-.454 3.665-1.257 5.234a.75.75 0 0 0 .515 1.076 32.94 32.94 0 0 0 3.256.508 3.5 3.5 0 0 0 6.972 0 32.933 32.933 0 0 0 3.256-.508.75.75 0 0 0 .515-1.076A11.448 11.448 0 0 1 16 8a6 6 0 0 0-6-6Zm0 14.5a2 2 0 0 1-1.95-1.557 33.54 33.54 0 0 0 3.9 0A2 2 0 0 1 10 16.5Z" clip-rule="evenodd"/>
                  </svg>
                  <%# Inline render eliminates the extra HTTP round-trip for badge count.
                      The broadcast_badge_update callback keeps this element live. %>
                  <span id="notification-badge-inner">
                    <%= render "notifications/badge_count",
                          unread_count: Current.user.notifications.unread.count %>
                  </span>
                </button>

                <div id="notification-dropdown"
                     class="notif-dropdown"
                     data-notification-center-target="menu"
                     data-open="false"
                     tabindex="-1">
                  <turbo-frame id="notification-list" src="<%= notifications_path %>" loading="lazy">
                    <div class="notif-dropdown__skeleton"></div>
                  </turbo-frame>
                </div>
              </div>

              <%= render "shared/account_dropdown" %>
            </div>
          </div>

          <div id="flash-messages">
            <% if flash[:notice] %>
              <div class="flash flash--notice" data-controller="flash"><%= flash[:notice] %></div>
            <% end %>
            <% if flash[:alert] %>
              <div class="flash flash--alert" data-controller="flash"><%= flash[:alert] %></div>
            <% end %>
          </div>

          <%= yield %>
        </main>
        </div>

        <div class="drawer-side">
          <label for="app-drawer" class="drawer-overlay"
                 aria-label="<%= t("topbar.close_navigation") %>"></label>
          <%= render "shared/sidebar" %>
        </div>

      </div>

      <div id="global-modal-host" data-controller="modal">
        <turbo-frame id="modal"
                     data-action="turbo:frame-load->modal#openFromFrame">
        </turbo-frame>
      </div>

    <% else %>
      <nav class="app-nav">
        <div class="app-nav__left">
          <%= link_to root_path, class: "app-nav__brand", dir: "ltr" do %>
            <span class="app-nav__brand-mark">Q</span><span class="app-nav__brand-text">uizly</span>
          <% end %>
        </div>
        <div class="app-nav__center">
          <%= link_to t("nav.explore"), explore_path, class: "app-nav__link" %>
        </div>
        <div class="app-nav__right">
          <%= link_to t("home.log_in"), login_path, class: "app-nav__link" %>
        </div>
      </nav>
      <div id="flash-messages">
        <% if flash[:notice] %>
          <div class="flash flash--notice" data-controller="flash"><%= flash[:notice] %></div>
        <% end %>
        <% if flash[:alert] %>
          <div class="flash flash--alert" data-controller="flash"><%= flash[:alert] %></div>
        <% end %>
      </div>
      <%= yield %>
    <% end %>
  </body>
</html>
