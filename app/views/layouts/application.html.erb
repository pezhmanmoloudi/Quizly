<!DOCTYPE html>
<html>
  <head>
    <title><%= [content_for(:title).presence, "Quizly"].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.svg?v=2" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.svg?v=2">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if authenticated? %>
      <div class="app-shell"
           data-controller="sidebar"
           data-action="keydown.ctrl+k@window->sidebar#focusSearch keydown.meta+k@window->sidebar#focusSearch">

        <%= render "shared/sidebar" %>

        <div class="sidebar__overlay" data-action="click->sidebar#closeMobile"></div>

        <main class="main-content">
          <div class="mobile-topbar">
            <button class="mobile-topbar__toggle"
                    data-action="click->sidebar#openMobile"
                    aria-label="Open navigation">
              <%= render "shared/icons/menu" %>
            </button>
            <%= link_to "Quizly", root_path, class: "mobile-topbar__brand" %>
          </div>

          <div id="flash-messages">
            <% if flash[:notice] %>
              <div class="flash flash--notice" data-controller="flash"><%= flash[:notice] %></div>
            <% end %>
            <% if flash[:alert] %>
              <div class="flash flash--alert" data-controller="flash"><%= flash[:alert] %></div>
            <% end %>
          </div>

          <%= yield %>
        </main>
      </div>

    <% else %>
      <nav class="app-nav">
        <div class="app-nav__left">
          <div class="app-nav__brand"><%= link_to "Quizly", root_path %></div>
        </div>
        <div class="app-nav__right">
          <%= link_to "Sign In", login_path,  class: "app-nav__link" %>
          <%= link_to "Sign Up", signup_path, class: "btn btn--primary btn--sm" %>
        </div>
      </nav>
      <div id="flash-messages">
        <% if flash[:notice] %>
          <div class="flash flash--notice" data-controller="flash"><%= flash[:notice] %></div>
        <% end %>
        <% if flash[:alert] %>
          <div class="flash flash--alert" data-controller="flash"><%= flash[:alert] %></div>
        <% end %>
      </div>
      <%= yield %>
    <% end %>
  </body>
</html>
