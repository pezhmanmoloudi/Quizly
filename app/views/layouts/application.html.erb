<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Quizly" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if authenticated? %>
      <nav class="app-nav">
        <div class="app-nav__left">
          <div class="app-nav__brand"><%= link_to "Quizly", root_path %></div>
          <div class="app-nav__links">
            <%= link_to "Dashboard", dashboard_path, class: "app-nav__link" %>
            <%= link_to "Decks",     decks_path,     class: "app-nav__link" %>
          </div>
        </div>
        <div class="app-nav__right">
          <div class="avatar-dropdown"
               data-controller="avatar-dropdown"
               data-action="click@document->avatar-dropdown#closeIfOutside keydown.esc@document->avatar-dropdown#close">

            <button class="avatar-dropdown__trigger"
                    data-avatar-dropdown-target="button"
                    data-action="click->avatar-dropdown#toggle"
                    aria-haspopup="true"
                    aria-expanded="false"
                    aria-label="<%= Current.user.email_address %> — account menu">
              <div class="user-avatar">
                <%= Current.user.display_name.first.upcase %>
              </div>
            </button>

            <div class="avatar-dropdown__menu"
                 data-avatar-dropdown-target="menu"
                 data-open="false"
                 role="menu">

              <div class="avatar-dropdown__header" role="presentation">
                <span class="avatar-dropdown__name"><%= Current.user.display_name %></span>
                <span class="avatar-dropdown__email"><%= Current.user.email_address %></span>
              </div>

              <div class="avatar-dropdown__items">
                <%= link_to "Account Settings", account_path,
                      class: "avatar-dropdown__item", role: "menuitem" %>
                <hr class="avatar-dropdown__divider">
                <%= button_to "Logout", logout_path, method: :delete,
                      class: "avatar-dropdown__item avatar-dropdown__item--danger",
                      role: "menuitem" %>
              </div>
            </div>
          </div>
        </div>
      </nav>
    <% else %>
      <nav class="app-nav">
        <div class="app-nav__left">
          <div class="app-nav__brand"><%= link_to "Quizly", root_path %></div>
        </div>
        <div class="app-nav__right">
          <%= link_to "Sign In", login_path,  class: "app-nav__link" %>
          <%= link_to "Sign Up", signup_path, class: "btn btn--primary btn--sm" %>
        </div>
      </nav>
    <% end %>
    <% if flash[:notice] %>
      <div class="flash flash--notice"><%= flash[:notice] %></div>
    <% end %>
    <% if flash[:alert] %>
      <div class="flash flash--alert"><%= flash[:alert] %></div>
    <% end %>
    <%= yield %>
  </body>
</html>
