<!DOCTYPE html>
<html dir="<%= Language::RTL_LOCALES.include?(I18n.locale.to_s) ? "rtl" : "ltr" %>">
  <head>
    <title><%= [content_for(:title).presence, "Quizly"].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.svg?v=2" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.svg?v=2">

    <script>
      (function() {
        var t = localStorage.getItem("color-theme");
        if (t === "dark" || t === "light") {
          document.documentElement.dataset.theme = t;
        } else {
          document.documentElement.dataset.theme =
            window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
      })();
    </script>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="theme">
    <% if authenticated? %>
      <div class="app-shell"
           data-controller="sidebar"
           data-action="keydown.ctrl+k@window->sidebar#focusSearch keydown.meta+k@window->sidebar#focusSearch">

        <%= render "shared/sidebar" %>

        <div class="sidebar__overlay" data-action="click->sidebar#closeMobile"></div>

        <main class="main-content">
          <div class="topbar">
            <%# Left: hamburger + brand (mobile only) %>
            <div class="topbar__left">
              <button class="topbar__menu-btn"
                      data-action="click->sidebar#openMobile"
                      aria-label="Open navigation">
                <%= render "shared/icons/menu" %>
              </button>
              <%= link_to "Quizly", root_path, class: "topbar__brand", dir: "ltr" %>
            </div>

            <%# Center: global search (hidden on mobile) %>
            <div class="topbar__center">
              <%= form_with url: explore_path, method: :get, class: "topbar__search" do |f| %>
                <div class="topbar__search-wrap">
                  <%= render "shared/icons/magnifying_glass", css_class: "topbar__search-icon" %>
                  <%= f.search_field :q,
                        placeholder: t("topbar.search_placeholder"),
                        class: "topbar__search-input",
                        data: { sidebar_target: "searchInput" },
                        aria: { label: t("topbar.search_aria") },
                        autocomplete: "off" %>
                  <kbd class="topbar__search-kbd">Ctrl K</kbd>
                </div>
              <% end %>
            </div>

            <%# Right: create action + avatar dropdown (always visible) %>
            <div class="topbar__right">
              <div class="topbar__create">
                <%= link_to new_deck_path,
                      class: "topbar__create-btn",
                      aria: { label: t("topbar.create_deck_aria") },
                      data: { tooltip: t("topbar.create_deck_tooltip") } do %>
                  <%= render "shared/icons/plus", css_class: "topbar__create-icon" %>
                <% end %>
              </div>

              <div class="avatar-dropdown"
                   data-controller="avatar-dropdown"
                   data-action="click@document->avatar-dropdown#closeIfOutside keydown.esc@document->avatar-dropdown#close">

                <button class="avatar-dropdown__trigger"
                        data-avatar-dropdown-target="button"
                        data-action="click->avatar-dropdown#toggle"
                        aria-haspopup="true"
                        aria-expanded="false"
                        aria-label="<%= Current.user.email_address %> — account menu">
                  <div class="user-avatar">
                    <% if Current.user.show_avatar? %>
                      <%= image_tag Current.user.avatar, alt: "" %>
                    <% else %>
                      <%= Current.user.display_name.first.upcase %>
                    <% end %>
                  </div>
                </button>

                <div class="avatar-dropdown__menu"
                     data-avatar-dropdown-target="menu"
                     data-open="false"
                     role="menu">
                  <div class="avatar-dropdown__header" role="presentation">
                    <div class="avatar-dropdown__header-inner">
                      <% if Current.user.show_avatar? %>
                        <%= image_tag Current.user.avatar,
                              class: "avatar-dropdown__avatar-img", alt: "" %>
                      <% else %>
                        <div class="user-avatar avatar-dropdown__avatar-placeholder">
                          <%= Current.user.display_name.first.upcase %>
                        </div>
                      <% end %>
                      <div>
                        <span class="avatar-dropdown__name"><%= Current.user.display_name %></span>
                        <span class="avatar-dropdown__email"><%= Current.user.email_address %></span>
                      </div>
                    </div>
                  </div>
                  <div class="avatar-dropdown__items">
                    <%= link_to account_path,
                          class: "avatar-dropdown__item", role: "menuitem" do %>
                      <%= render "shared/icons/cog", css_class: "avatar-dropdown__item-icon" %>
                      <span><%= t("menu.settings") %></span>
                    <% end %>

                    <%= link_to account_path(anchor: "language"),
                          class: "avatar-dropdown__item", role: "menuitem" do %>
                      <%= render "shared/icons/globe", css_class: "avatar-dropdown__item-icon" %>
                      <span><%= t("menu.language") %> · <%= Language::LANGUAGES[Current.user.locale] %></span>
                    <% end %>

                    <button class="avatar-dropdown__item" role="menuitem"
                            data-action="click->theme#toggle">
                      <%= render "shared/icons/moon", css_class: "avatar-dropdown__item-icon" %>
                      <span data-theme-target="label"
                            data-dark-label="<%= t("menu.dark_mode") %>"
                            data-light-label="<%= t("menu.light_mode") %>"><%= t("menu.dark_mode") %></span>
                    </button>

                    <hr class="avatar-dropdown__divider">

                    <%= button_to logout_path, method: :delete,
                          class: "avatar-dropdown__item avatar-dropdown__item--danger",
                          role: "menuitem" do %>
                      <%= render "shared/icons/arrow_right_on_rectangle",
                            css_class: "avatar-dropdown__item-icon" %>
                      <span><%= t("menu.log_out") %></span>
                    <% end %>
                  </div>
                </div>

              </div>
            </div>
          </div>

          <div id="flash-messages">
            <% if flash[:notice] %>
              <div class="flash flash--notice" data-controller="flash"><%= flash[:notice] %></div>
            <% end %>
            <% if flash[:alert] %>
              <div class="flash flash--alert" data-controller="flash"><%= flash[:alert] %></div>
            <% end %>
          </div>

          <%= yield %>
        </main>
      </div>

    <% else %>
      <nav class="app-nav">
        <div class="app-nav__left">
          <%= link_to root_path, class: "app-nav__brand", dir: "ltr" do %>
            <span class="app-nav__brand-mark">Q</span><span class="app-nav__brand-text">uizly</span>
          <% end %>
        </div>
        <div class="app-nav__center">
          <%= link_to t("nav.explore"), explore_path, class: "app-nav__link" %>
        </div>
        <div class="app-nav__right">
          <%= link_to t("home.log_in"), login_path, class: "app-nav__link" %>
        </div>
      </nav>
      <div id="flash-messages">
        <% if flash[:notice] %>
          <div class="flash flash--notice" data-controller="flash"><%= flash[:notice] %></div>
        <% end %>
        <% if flash[:alert] %>
          <div class="flash flash--alert" data-controller="flash"><%= flash[:alert] %></div>
        <% end %>
      </div>
      <%= yield %>
    <% end %>
  </body>
</html>
