<% content_for :title, "Learn: #{@deck.name}" %>

<div class="study-island"
     data-controller="learn-mode"
     data-action="keydown->learn-mode#handleKey"
     tabindex="-1"
     aria-label="Learn session">

  <div class="study-island__header">
    <%= link_to t("study_modes.exit"), @deck, class: "study-island__exit",
          data: { learn_mode_target: "exitLink" } %>

    <div class="study-island__title-block">
      <h2 class="study-island__title"><%= @deck.name %></h2>
      <p class="study-island__subtitle"><%= t("study_modes.learn.subtitle") %></p>
    </div>

    <div class="study-island__stats">
      <% if @learn_session.present? %>
        <div class="match-stat match-stat--timer">
          <div class="match-stat__badge">
            <svg class="match-stat__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="14" height="14" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm.75-13a.75.75 0 0 0-1.5 0v5c0 .414.336.75.75.75h4a.75.75 0 0 0 0-1.5h-3.25V5Z" clip-rule="evenodd"/>
            </svg>
            <span class="match-stat__value" data-learn-mode-target="timer">00:00</span>
          </div>
          <span class="match-stat__label"><%= t("study_modes.time") %></span>
        </div>
      <% end %>

      <% if @learn_session.present? %>
        <div class="match-stat match-stat--pairs">
          <div class="match-stat__badge">
            <svg class="match-stat__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="14" height="14" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm0-2a6 6 0 1 0 0-12 6 6 0 0 0 0 12Zm0-3a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" clip-rule="evenodd"/>
            </svg>
            <span id="learn_counter" class="match-stat__value">
              <%= @learn_session.cards_mastered %> / <%= @learn_session.cards_total %>
            </span>
          </div>
          <span class="match-stat__label"><%= t("study_modes.learn.mastered_label") %></span>
        </div>
      <% end %>

      <div class="match-stat match-stat--streak">
        <div class="match-stat__badge">
          <svg class="match-stat__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="14" height="14" aria-hidden="true">
            <path d="M12.395 2.553a1 1 0 0 0-1.45-.385c-.345.23-.614.558-.822.88-.214.33-.403.713-.57 1.116-.334.804-.614 1.768-.84 2.734a31.365 31.365 0 0 0-.613 3.58 2.64 2.64 0 0 1-.945-1.067c-.328-.68-.398-1.534-.398-2.654A1 1 0 0 0 5.05 6.05 6.981 6.981 0 0 0 3 11a7 7 0 1 0 11.95-4.95c-.592-.591-.98-.985-1.348-1.467-.363-.476-.724-1.063-1.207-2.03ZM12.12 15.12A3 3 0 0 1 7 13s.879.5 2.5.5c0-1 .5-4 1.25-4.5.5 1 .786 1.293 1.371 1.879A2.99 2.99 0 0 1 13 13a2.99 2.99 0 0 1-.879 2.121Z"/>
          </svg>
          <span class="match-stat__value" data-learn-mode-target="streak">0</span>
        </div>
        <span class="match-stat__label"><%= t("study_modes.streak") %></span>
      </div>
    </div>
  </div>

  <% if @learn_session.present? && @learn_session.cards_total > 0 %>
    <div id="learn_progress" class="study-island__progress-wrap">
      <div class="study-island__progress">
        <div class="study-island__progress-fill"
             style="width: <%= @learn_session.completion_pct %>%"></div>
      </div>
      <span class="study-island__progress-label"><%= @learn_session.completion_pct %>%</span>
    </div>
  <% end %>

  <%= turbo_frame_tag "learn_card" do %>
    <% if @learn_session.nil? || @deck.flashcards.empty? %>
      <%= render "shared/empty_state",
            icon: "academic_cap",
            title: t("study_modes.no_cards_title"),
            description: t("study_modes.learn.empty_description"),
            variant: :default %>

    <% elsif @current_item.nil? %>
      <div class="learn-summary">
        <div class="session-summary__icon">🎓</div>
        <h3 class="session-summary__title"><%= t("study_modes.learn.summary_title") %></h3>
        <div class="session-summary__stats">
          <div class="session-summary__stat">
            <span class="session-summary__value"><%= @learn_session.cards_total %></span>
            <span class="session-summary__label"><%= t("study_modes.learn.studied") %></span>
          </div>
          <div class="session-summary__stat">
            <span class="session-summary__value">
              <%= format_study_time(@learn_session.elapsed_seconds) %>
            </span>
            <span class="session-summary__label"><%= t("study_modes.learn.time_spent") %></span>
          </div>
        </div>
        <p class="session-summary__sub"><%= t("study_modes.learn.summary_sub") %></p>
        <div class="learn-summary__actions">
          <%= link_to t("study_modes.learn.study_again"), learn_deck_path(@deck), class: "btn btn--primary btn--sm",
                data: { turbo_action: "replace" } %>
        </div>
      </div>

    <% else %>
      <%= render "decks/learn_card", item: @current_item, learn_session: @learn_session %>
    <% end %>
  <% end %>
</div>
