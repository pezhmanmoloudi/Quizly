<% if @next_item.nil? %>
  <%# All cards mastered — replace card area AND update progress bar %>
  <%= turbo_stream.replace "learn_card" do %>
    <div class="learn-summary">
      <div class="session-summary__icon">🎓</div>
      <h3 class="session-summary__title">All cards mastered!</h3>
      <div class="session-summary__stats">
        <div class="session-summary__stat">
          <span class="session-summary__value"><%= @learn_session.cards_total %></span>
          <span class="session-summary__label">Cards studied</span>
        </div>
        <div class="session-summary__stat">
          <span class="session-summary__value">
            <%= format_study_time(@learn_session.elapsed_seconds) %>
          </span>
          <span class="session-summary__label">Time spent</span>
        </div>
      </div>
      <p class="session-summary__sub">Great work — every card is mastered.</p>
      <div class="learn-summary__actions">
        <%= link_to "Study Again", learn_deck_path(@learn_session.deck),
              class: "btn btn--primary btn--sm",
              data: { turbo_action: "replace" } %>
        <%= link_to "Back to Deck", @learn_session.deck, class: "btn btn--secondary btn--sm" %>
      </div>
    </div>
  <% end %>
<% else %>
  <%# Show feedback then allow Continue %>
  <%= turbo_stream.replace "learn_card" do %>
    <%= render "decks/learn_card",
          item: @item,
          learn_session: @learn_session,
          feedback: true,
          correct: @correct %>
  <% end %>
<% end %>
<%= turbo_stream.replace "learn_progress" do %>
  <div id="learn_progress" class="study-island__progress-wrap">
    <div class="study-island__progress">
      <div class="study-island__progress-fill"
           style="width: <%= @learn_session.completion_pct %>%"></div>
    </div>
    <span class="study-island__progress-label"><%= @learn_session.completion_pct %>%</span>
  </div>
<% end %>
<%= turbo_stream.replace "learn_counter" do %>
  <span id="learn_counter" class="study-island__counter">
    <%= @learn_session.cards_mastered %> / <%= @learn_session.cards_total %>
  </span>
<% end %>
