<% content_for :title, "Account Settings" %>

<div class="container">
  <div class="page-header">
    <h1>Account Settings</h1>
  </div>

  <div class="settings-layout"
       data-controller="settings-tabs"
       data-settings-tabs-initial-tab-value="<%= @active_section %>">

    <nav class="settings-sidebar" role="tablist" aria-label="Settings navigation">
      <button class="settings-tab"
              role="tab"
              data-settings-tabs-target="tab"
              data-tab="profile"
              data-action="click->settings-tabs#switch keydown->settings-tabs#navigate"
              aria-selected="false">
        Profile
      </button>
      <button class="settings-tab"
              role="tab"
              data-settings-tabs-target="tab"
              data-tab="email"
              data-action="click->settings-tabs#switch keydown->settings-tabs#navigate"
              aria-selected="false">
        Email
      </button>
      <button class="settings-tab"
              role="tab"
              data-settings-tabs-target="tab"
              data-tab="password"
              data-action="click->settings-tabs#switch keydown->settings-tabs#navigate"
              aria-selected="false">
        Password
      </button>
    </nav>

    <div class="settings-content">

      <%# Profile — visible by default (no hidden class) %>
      <section class="settings-section"
               data-settings-tabs-target="section"
               data-section="profile"
               aria-label="Profile">
        <h2>Profile</h2>

        <%# Avatar upload — its own controller so button_to Remove sits at sibling level %>
        <div class="profile-avatar-section" data-controller="avatar-preview">

          <%# Avatar display: photo (if visible) or initials circle %>
          <% if Current.user.show_avatar? %>
            <%= image_tag Current.user.avatar.variant(resize_to_fill: [80, 80]),
                  class: "profile-avatar-img",
                  alt: "Profile photo",
                  data: { "avatar-preview-target": "image" } %>
          <% else %>
            <div class="user-avatar profile-avatar-placeholder"
                 data-avatar-preview-target="placeholder">
              <%= Current.user.display_name.first.upcase %>
            </div>
            <%= image_tag "data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=",
                  class: "profile-avatar-img",
                  alt: "Profile photo",
                  hidden: true,
                  data: { "avatar-preview-target": "image" } %>
          <% end %>

          <div class="profile-avatar-actions">
            <%# Upload form (auto-submits on file pick) %>
            <%= form_with url: account_path, method: :patch, multipart: true do |av| %>
              <%= av.hidden_field :section, value: "profile" %>
              <label for="avatar-file-input" class="btn btn--secondary btn--sm">
                <%= Current.user.avatar.attached? ? "Change photo" : "Add photo" %>
              </label>
              <%= av.file_field :avatar,
                    id: "avatar-file-input",
                    accept: "image/jpeg,image/png,image/gif,image/webp",
                    class: "profile-avatar-input",
                    data: {
                      "avatar-preview-target": "input",
                      action: "change->avatar-preview#change"
                    } %>
            <% end %>

            <% if Current.user.avatar.attached? %>
              <%= button_to "Remove photo", avatar_account_path, method: :delete,
                    class: "btn btn--danger btn--sm",
                    form: { data: { turbo_confirm: "Remove your profile photo?" } } %>
            <% end %>

            <%# Inline validation error from Stimulus %>
            <p class="profile-avatar-error form-hint"
               data-avatar-preview-target="error"
               hidden></p>

            <%# Photo rules hint %>
            <p class="form-hint profile-avatar-rules">
              <%= User::AVATAR_FORMAT_HINT %> &middot;
              Max <%= User::AVATAR_MAX_MB %>MB &middot;
              <%= User::AVATAR_MIN_PX %>&times;<%= User::AVATAR_MIN_PX %>px minimum
            </p>
          </div>
        </div>

        <%= form_with url: account_path, method: :patch do |f| %>
          <%= f.hidden_field :section, value: "profile" %>

          <div class="form-group">
            <%= f.label :display_name, "Display name" %>
            <%= f.text_field :display_name,
                  value: Current.user[:display_name],
                  placeholder: Current.user.display_name,
                  class: "form-control",
                  maxlength: 50 %>
            <small class="form-hint">Leave blank to use your email username (<%= Current.user.email_address.split("@").first %>)</small>
          </div>

          <% if Current.user.avatar.attached? %>
            <div class="form-group profile-toggle-row">
              <%= f.label :show_avatar, class: "profile-toggle-label" do %>
                <%= f.check_box :show_avatar,
                      checked: Current.user.show_avatar,
                      class: "profile-toggle-checkbox" %>
                <span>Show profile photo</span>
                <small class="form-hint">When off, your initials are shown instead</small>
              <% end %>
            </div>
          <% end %>

          <div class="settings-profile-info">
            <div class="settings-profile-row">
              <span class="settings-profile-label">Email address</span>
              <span class="settings-profile-value"><%= Current.user.email_address %></span>
            </div>
            <div class="settings-profile-row">
              <span class="settings-profile-label">Member since</span>
              <span class="settings-profile-value"><%= Current.user.created_at.strftime("%B %Y") %></span>
            </div>
          </div>

          <%= f.submit "Save changes", class: "btn btn--primary" %>
        <% end %>
      </section>

      <%# Email — hidden until tab activated %>
      <section class="settings-section settings-section--hidden"
               data-settings-tabs-target="section"
               data-section="email"
               aria-label="Email settings">
        <h2>Change Email</h2>
        <%= form_with url: account_path, method: :patch do |f| %>
          <%= f.hidden_field :section, value: "email" %>
          <div class="form-group">
            <%= f.label :email_address, "New email address" %>
            <%= f.email_field :email_address, value: Current.user.email_address,
                  required: true, autocomplete: "username", class: "form-control" %>
          </div>
          <div class="form-group">
            <%= f.label :current_password, "Current password" %>
            <%= f.password_field :current_password, required: true,
                  autocomplete: "current-password", class: "form-control" %>
          </div>
          <%= f.submit "Update email", class: "btn btn--primary" %>
        <% end %>
      </section>

      <%# Password — hidden until tab activated %>
      <section class="settings-section settings-section--hidden"
               data-settings-tabs-target="section"
               data-section="password"
               aria-label="Password settings">
        <h2>Change Password</h2>
        <%= form_with url: account_path, method: :patch do |f| %>
          <%= f.hidden_field :section, value: "password" %>
          <div class="form-group">
            <%= f.label :current_password, "Current password" %>
            <%= f.password_field :current_password, required: true,
                  autocomplete: "current-password", class: "form-control" %>
          </div>
          <div class="form-group">
            <%= f.label :password, "New password" %>
            <%= f.password_field :password, required: true,
                  autocomplete: "new-password", minlength: 8, maxlength: 72,
                  class: "form-control" %>
            <small class="form-hint">Minimum 8 characters</small>
          </div>
          <div class="form-group">
            <%= f.label :password_confirmation, "Confirm new password" %>
            <%= f.password_field :password_confirmation, required: true,
                  autocomplete: "new-password", maxlength: 72, class: "form-control" %>
          </div>
          <%= f.submit "Update password", class: "btn btn--primary" %>
        <% end %>
      </section>

    </div>
  </div>

</div>
