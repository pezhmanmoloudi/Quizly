<% content_for :title, t("accounts.title") %>

<div class="container">
  <div class="page-header">
    <h1><%= t("accounts.title") %></h1>
  </div>

  <%# Personal information %>
  <p class="settings-section-label"><%= t("accounts.personal_info") %></p>
  <div class="settings-info-card">

    <%# Profile picture %>
    <div class="settings-avatar-section" data-controller="avatar-preview modal">
      <p class="settings-avatar-section__heading"><%= t("accounts.profile_picture_heading") %></p>
      <div class="settings-avatar-row">

        <%# Current avatar (large) %>
        <div id="avatar-current-display" class="settings-avatar-current">
          <% if Current.user.avatar.attached? && Current.user.avatar.blob.persisted? %>
            <%= image_tag Current.user.avatar, class: "profile-avatar-img", alt: t("accounts.profile_photo_alt") %>
          <% else %>
            <div class="user-avatar profile-avatar-placeholder">
              <%= Current.user.display_name.first.upcase %>
            </div>
          <% end %>
        </div>

        <%# Predefined avatar grid + upload button %>
        <div class="settings-avatar-grid">
          <% [
            { bg: "#f87171", emoji: "🐧" },
            { bg: "#a78bfa", emoji: "🦁" },
            { bg: "#34d399", emoji: "🐼" },
            { bg: "#fb923c", emoji: "🐸" },
            { bg: "#60a5fa", emoji: "🦊" },
            { bg: "#f472b6", emoji: "🐨" },
            { bg: "#4ade80", emoji: "🦅" },
            { bg: "#facc15", emoji: "🐯" },
            { bg: "#f43f5e", emoji: "🦋" },
            { bg: "#38bdf8", emoji: "🐬" },
            { bg: "#c084fc", emoji: "🦜" },
            { bg: "#2dd4bf", emoji: "🐻" },
            { bg: "#fb7185", emoji: "🦄" },
            { bg: "#a3e635", emoji: "🐙" },
            { bg: "#fbbf24", emoji: "🦒" },
            { bg: "#818cf8", emoji: "🐳" },
            { bg: "#34d399", emoji: "🦚" },
            { bg: "#f97316", emoji: "🐺" },
            { bg: "#e879f9", emoji: "🦝" },
            { bg: "#6ee7b7", emoji: "🐮" },
            { bg: "#fcd34d", emoji: "🦉" },
          ].each do |av| %>
            <button type="button"
                    class="settings-avatar-option"
                    style="background-color: <%= av[:bg] %>;"
                    aria-label="<%= t("accounts.select_avatar") %>"
                    data-action="click->avatar-preview#selectPreset"
                    data-avatar-preview-emoji-param="<%= av[:emoji] %>"
                    data-avatar-preview-bg-param="<%= av[:bg] %>">
              <%= av[:emoji] %>
            </button>
          <% end %>

          <%# Upload button %>
          <%= form_with url: account_path, method: :patch, multipart: true do |av| %>
            <%= av.hidden_field :section, value: "profile" %>
            <label for="avatar-file-input"
                   class="settings-avatar-option settings-avatar-option--add"
                   title="<%= t("accounts.upload_photo_title") %>">+</label>
            <%= av.file_field :avatar,
                  id: "avatar-file-input",
                  accept: "image/jpeg,image/png,image/webp",
                  class: "profile-avatar-input",
                  data: {
                    "avatar-preview-target": "input",
                    action: "change->avatar-preview#change"
                  } %>
          <% end %>
        </div>

      </div>

      <% if Current.user.errors[:avatar].any? %>
        <p class="profile-avatar-error"><%= Current.user.errors[:avatar].to_sentence %></p>
      <% end %>

      <%# Remove confirmation modal %>
      <% if Current.user.avatar.attached? && Current.user.avatar.blob.persisted? %>
        <div id="avatar-remove-controls">
          <button type="button" class="btn btn--danger btn--sm"
                  style="margin-top: 0.5rem;"
                  data-action="click->modal#open">
            <%= t("accounts.remove_photo") %>
          </button>
          <% avatar_modal_body = capture do %>
            <p class="modal-warning"><%= t("accounts.remove_photo_modal_warning") %></p>
          <% end %>
          <%= render "shared/destructive_modal",
                modal_id: "remove-avatar-modal",
                title: t("accounts.remove_photo_modal_title"),
                body_html: avatar_modal_body,
                confirm_label: t("accounts.remove_photo_modal_confirm"),
                form_url: avatar_account_path,
                form_method: :delete %>
        </div>
      <% end %>
    </div>

    <%# Username row %>
    <div class="settings-info-row" data-controller="settings-row-edit">
      <div class="settings-info-row__left">
        <div data-settings-row-edit-target="display">
          <div class="settings-info-row__label"><%= t("accounts.username_label") %></div>
          <div class="settings-info-row__value"><%= Current.user.display_name %></div>
        </div>

        <div data-settings-row-edit-target="form" hidden>
          <%= form_with url: account_path, method: :patch do |f| %>
            <%= f.hidden_field :section, value: "profile" %>
            <div class="settings-inline-edit">
              <div data-controller="field-error">
                <%= f.text_field :display_name,
                      value: Current.user[:display_name],
                      placeholder: Current.user.display_name,
                      class: "form-control",
                      maxlength: 50,
                      data: { field_error_target: "input", action: "blur->field-error#validate input->field-error#clear" } %>
                <small class="form-hint"><%= t("accounts.username_hint_html", email: Current.user.email_address.split("@").first) %></small>
                <span class="field-error" data-field-error-target="message"
                      <% if Current.user.errors[:display_name].any? %>data-server-error="true"<% else %>hidden<% end %>
                      aria-live="polite"><%= Current.user.errors[:display_name].first %></span>
              </div>
              <div class="settings-inline-edit-actions">
                <%= f.submit t("shared.save"), class: "btn btn--primary btn--sm" %>
                <button type="button" class="btn btn--secondary btn--sm"
                        data-action="settings-row-edit#cancel"><%= t("shared.cancel") %></button>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="settings-info-row__right" data-settings-row-edit-target="editBtn">
        <button type="button" class="settings-edit-link"
                data-action="settings-row-edit#edit"><%= t("shared.edit") %></button>
      </div>
    </div>

    <%# Email row %>
    <div class="settings-info-row" data-controller="settings-row-edit">
      <div class="settings-info-row__left">
        <div data-settings-row-edit-target="display">
          <div class="settings-info-row__label"><%= t("accounts.email_label") %></div>
          <div class="settings-info-row__value"><%= Current.user.email_address %></div>
        </div>

        <div data-settings-row-edit-target="form" hidden>
          <%= form_with url: account_path, method: :patch do |f| %>
            <%= f.hidden_field :section, value: "email" %>
            <div class="settings-inline-edit">
              <div data-controller="field-error">
                <%= f.email_field :email_address,
                      value: Current.user.email_address,
                      required: true,
                      autocomplete: "username",
                      class: "form-control",
                      data: { field_error_target: "input", action: "blur->field-error#validate input->field-error#clear" } %>
                <span class="field-error" data-field-error-target="message"
                      <% if Current.user.errors[:email_address].any? %>data-server-error="true"<% else %>hidden<% end %>
                      aria-live="polite"><%= Current.user.errors[:email_address].first %></span>
              </div>
              <div data-controller="field-error">
                <%= f.password_field :current_password,
                      required: true,
                      placeholder: t("accounts.current_password_placeholder"),
                      autocomplete: "current-password",
                      class: "form-control",
                      data: { field_error_target: "input", action: "blur->field-error#validate input->field-error#clear" } %>
                <span class="field-error" data-field-error-target="message"
                      <% if Current.user.errors[:current_password].any? %>data-server-error="true"<% else %>hidden<% end %>
                      aria-live="polite"><%= Current.user.errors[:current_password].first %></span>
              </div>
              <div class="settings-inline-edit-actions">
                <%= f.submit t("shared.save"), class: "btn btn--primary btn--sm" %>
                <button type="button" class="btn btn--secondary btn--sm"
                        data-action="settings-row-edit#cancel"><%= t("shared.cancel") %></button>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="settings-info-row__right" data-settings-row-edit-target="editBtn">
        <button type="button" class="settings-edit-link"
                data-action="settings-row-edit#edit"><%= t("shared.edit") %></button>
      </div>
    </div>

    <%# Account type row %>
    <div class="settings-info-row">
      <div class="settings-info-row__label"><%= t("accounts.account_type_label") %></div>
      <div class="settings-info-row__right">
        <div class="theme-dropdown"
             data-controller="account-type"
             data-action="click@document->account-type#closeIfOutside keydown.esc@document->account-type#close">
          <button class="theme-dropdown__trigger" type="button"
                  data-action="click->account-type#toggle"
                  aria-haspopup="true">
            <span><%= t("accounts.account_type_student") %></span>
            <%= render "shared/icons/chevron_down", css_class: "theme-dropdown__chevron" %>
          </button>
          <div class="theme-dropdown__menu" data-account-type-target="menu" data-open="false" role="menu">
            <button class="theme-dropdown__item is-active" type="button" role="menuitem" tabindex="-1">
              <%= t("accounts.account_type_student") %>
            </button>
            <button class="theme-dropdown__item" type="button" role="menuitem" tabindex="-1">
              <%= t("accounts.account_type_teacher") %>
            </button>
          </div>
        </div>
      </div>
    </div>

  </div>

  <%# Password change — accessible via a subtle card below %>
  <p class="settings-section-label"><%= t("accounts.change_password") %></p>
  <details class="settings-info-card">
    <summary class="settings-card__summary">
      <%= t("accounts.change_password") %>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
      </svg>
    </summary>
    <div class="settings-card__body">
      <%= form_with url: account_path, method: :patch do |f| %>
        <%= f.hidden_field :section, value: "password" %>
        <div style="margin-top: 1rem; display: flex; flex-direction: column; gap: 0.75rem;">
          <div class="form-group" data-controller="password-toggle field-error">
            <%= f.label :current_password, t("accounts.current_password_placeholder"), style: "font-size:0.875rem;" %>
            <div class="field-with-toggle">
              <%= f.password_field :current_password, required: true,
                    autocomplete: "current-password", class: "form-control",
                    data: { password_toggle_target: "field", field_error_target: "input",
                            action: "blur->field-error#validate input->field-error#clear" } %>
              <button type="button" class="auth-input__toggle"
                      data-action="password-toggle#toggle"
                      aria-label="<%= t("accounts.toggle_password") %>">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/>
                  <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/>
                </svg>
              </button>
            </div>
            <span class="field-error" data-field-error-target="message"
                  <% if Current.user.errors[:current_password].any? %>data-server-error="true"<% else %>hidden<% end %>
                  aria-live="polite"><%= Current.user.errors[:current_password].first %></span>
          </div>
          <div class="form-group" data-controller="password-toggle field-error">
            <%= f.label :password, t("accounts.new_password_label"), style: "font-size:0.875rem;" %>
            <div class="field-with-toggle">
              <%= f.password_field :password, required: true,
                    autocomplete: "new-password", minlength: 8, maxlength: 72, class: "form-control",
                    data: { password_toggle_target: "field", field_error_target: "input",
                            action: "blur->field-error#validate input->field-error#clear" } %>
              <button type="button" class="auth-input__toggle"
                      data-action="password-toggle#toggle"
                      aria-label="<%= t("accounts.toggle_password") %>">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/>
                  <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/>
                </svg>
              </button>
            </div>
            <small class="form-hint"><%= t("accounts.password_min_hint") %></small>
            <span class="field-error" data-field-error-target="message"
                  <% if Current.user.errors[:password].any? %>data-server-error="true"<% else %>hidden<% end %>
                  aria-live="polite"><%= Current.user.errors[:password].first %></span>
          </div>
          <div class="form-group" data-controller="password-toggle field-error">
            <%= f.label :password_confirmation, t("accounts.confirm_password_label"), style: "font-size:0.875rem;" %>
            <div class="field-with-toggle">
              <%= f.password_field :password_confirmation, required: true,
                    autocomplete: "new-password", maxlength: 72, class: "form-control",
                    data: { password_toggle_target: "field", field_error_target: "input",
                            action: "blur->field-error#validate input->field-error#clear" } %>
              <button type="button" class="auth-input__toggle"
                      data-action="password-toggle#toggle"
                      aria-label="<%= t("accounts.toggle_password") %>">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/>
                  <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/>
                </svg>
              </button>
            </div>
            <span class="field-error" data-field-error-target="message"
                  <% if Current.user.errors[:password_confirmation].any? %>data-server-error="true"<% else %>hidden<% end %>
                  aria-live="polite"><%= Current.user.errors[:password_confirmation].first %></span>
          </div>
          <%= f.submit t("accounts.update_password"), class: "btn btn--primary btn--sm" %>
        </div>
      <% end %>
    </div>
  </details>

  <%# Notifications %>
  <p class="settings-section-label" id="notifications"><%= t("accounts.notifications_section") %></p>
  <div class="settings-info-card">

    <% pref = Current.user.notification_preference || Current.user.build_notification_preference %>

    <%= form_with url: account_path, method: :patch do |f| %>
      <%= f.hidden_field :section, value: "notifications" %>

      <%# In-App Notifications section %>
      <details class="notif-accordion" open>
        <summary class="notif-accordion__summary">
          <%= t("accounts.notif_in_app_heading") %>
          <%= render "shared/icons/chevron_down", css_class: "notif-accordion__chevron" %>
        </summary>
        <div class="notif-accordion__body">

          <%# Someone follows me %>
          <div class="settings-info-row">
            <div class="settings-info-row__label" style="font-weight: 400; color: var(--color-text-secondary);">
              <%= t("accounts.notif_in_app_follows") %>
            </div>
            <div class="settings-info-row__right">
              <label class="notif-channel-btn" aria-label="<%= t("accounts.notif_in_app_follows") %>">
                <%= hidden_field_tag "notification_preference[in_app_follows]", "0" %>
                <%= check_box_tag "notification_preference[in_app_follows]", "1",
                      pref.in_app_follows?, class: "sr-only" %>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="14" height="14" aria-hidden="true">
                  <path d="M10 9a3 3 0 100-6 3 3 0 000 6zM6 8a2 2 0 11-4 0 2 2 0 014 0zM1.49 15.326a.78.78 0 01-.358-.442 3 3 0 014.308-3.516 6.484 6.484 0 00-1.905 3.959c-.023.222-.014.442.025.654a4.97 4.97 0 01-2.07-.655zM16.44 15.98a4.97 4.97 0 002.07-.654.78.78 0 00.357-.442 3 3 0 00-4.308-3.517 6.484 6.484 0 011.907 3.96 2.32 2.32 0 01-.026.654zM18 8a2 2 0 11-4 0 2 2 0 014 0zM5.304 16.19a.844.844 0 01-.277-.71 5 5 0 019.947 0 .843.843 0 01-.277.71A6.975 6.975 0 0110 18a6.974 6.974 0 01-4.696-1.81z"/>
                </svg>
              </label>
            </div>
          </div>

          <%# Activity from people I follow %>
          <div class="settings-info-row">
            <div class="settings-info-row__label" style="font-weight: 400; color: var(--color-text-secondary);">
              <%= t("accounts.notif_in_app_following_activity") %>
            </div>
            <div class="settings-info-row__right">
              <label class="notif-channel-btn" aria-label="<%= t("accounts.notif_in_app_following_activity") %>">
                <%= hidden_field_tag "notification_preference[in_app_following_activity]", "0" %>
                <%= check_box_tag "notification_preference[in_app_following_activity]", "1",
                      pref.in_app_following_activity?, class: "sr-only" %>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="14" height="14" aria-hidden="true">
                  <path d="M10 12.5a2.5 2.5 0 100-5 2.5 2.5 0 000 5z"/>
                  <path fill-rule="evenodd" d="M.664 10.59a1.651 1.651 0 010-1.186A10.004 10.004 0 0110 3c4.257 0 7.893 2.66 9.336 6.41.147.381.146.804 0 1.186A10.004 10.004 0 0110 17c-4.257 0-7.893-2.66-9.336-6.41z" clip-rule="evenodd"/>
                </svg>
              </label>
            </div>
          </div>

          <%# Badge & streak — in-app is always on, so no toggle, just informational %>
          <div class="settings-info-row">
            <div class="settings-info-row__label" style="font-weight: 400; color: var(--color-text-secondary);">
              <%= t("accounts.notif_streaks_badges") %>
            </div>
            <div class="settings-info-row__right">
              <span class="notif-always-on"><%= t("accounts.notif_always_on") %></span>
            </div>
          </div>

        </div>
      </details>

      <%# Email Notifications section %>
      <details class="notif-accordion">
        <summary class="notif-accordion__summary">
          <%= t("accounts.notif_email_heading") %>
          <%= render "shared/icons/chevron_down", css_class: "notif-accordion__chevron" %>
        </summary>
        <div class="notif-accordion__body">

          <%# Someone follows me (email) %>
          <div class="settings-info-row">
            <div class="settings-info-row__label" style="font-weight: 400; color: var(--color-text-secondary);">
              <%= t("accounts.notif_email_follows") %>
            </div>
            <div class="settings-info-row__right">
              <label class="notif-channel-btn" aria-label="<%= t("accounts.notif_email_label") %>">
                <%= hidden_field_tag "notification_preference[email_follows]", "0" %>
                <%= check_box_tag "notification_preference[email_follows]", "1",
                      pref.email_follows?, class: "sr-only" %>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="14" height="14" aria-hidden="true">
                  <path d="M3 4a2 2 0 00-2 2v1.161l8.441 4.221a1.25 1.25 0 001.118 0L19 7.162V6a2 2 0 00-2-2H3z"/>
                  <path d="M19 8.839l-7.77 3.885a2.75 2.75 0 01-2.46 0L1 8.839V14a2 2 0 002 2h14a2 2 0 002-2V8.839z"/>
                </svg>
              </label>
            </div>
          </div>

          <%# Activity from people I follow (email) %>
          <div class="settings-info-row">
            <div class="settings-info-row__label" style="font-weight: 400; color: var(--color-text-secondary);">
              <%= t("accounts.notif_email_following_activity") %>
            </div>
            <div class="settings-info-row__right">
              <label class="notif-channel-btn" aria-label="<%= t("accounts.notif_email_label") %>">
                <%= hidden_field_tag "notification_preference[email_following_activity]", "0" %>
                <%= check_box_tag "notification_preference[email_following_activity]", "1",
                      pref.email_following_activity?, class: "sr-only" %>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="14" height="14" aria-hidden="true">
                  <path d="M3 4a2 2 0 00-2 2v1.161l8.441 4.221a1.25 1.25 0 001.118 0L19 7.162V6a2 2 0 00-2-2H3z"/>
                  <path d="M19 8.839l-7.77 3.885a2.75 2.75 0 01-2.46 0L1 8.839V14a2 2 0 002 2h14a2 2 0 002-2V8.839z"/>
                </svg>
              </label>
            </div>
          </div>

          <%# Streaks and badges (email) %>
          <div class="settings-info-row">
            <div class="settings-info-row__label" style="font-weight: 400; color: var(--color-text-secondary);">
              <%= t("accounts.notif_streaks_badges_email") %>
            </div>
            <div class="settings-info-row__right">
              <label class="notif-channel-btn" aria-label="<%= t("accounts.notif_email_label") %>">
                <%= hidden_field_tag "notification_preference[email_streaks_badges]", "0" %>
                <%= check_box_tag "notification_preference[email_streaks_badges]", "1",
                      pref.email_streaks_badges?, class: "sr-only" %>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="14" height="14" aria-hidden="true">
                  <path d="M3 4a2 2 0 00-2 2v1.161l8.441 4.221a1.25 1.25 0 001.118 0L19 7.162V6a2 2 0 00-2-2H3z"/>
                  <path d="M19 8.839l-7.77 3.885a2.75 2.75 0 01-2.46 0L1 8.839V14a2 2 0 002 2h14a2 2 0 002-2V8.839z"/>
                </svg>
              </label>
            </div>
          </div>

          <%# Study reminders (email) %>
          <div class="settings-info-row">
            <div class="settings-info-row__label" style="font-weight: 400; color: var(--color-text-secondary);">
              <%= t("accounts.notif_study_reminders_email") %>
            </div>
            <div class="settings-info-row__right">
              <label class="notif-channel-btn" aria-label="<%= t("accounts.notif_email_label") %>">
                <%= hidden_field_tag "notification_preference[email_study_reminders]", "0" %>
                <%= check_box_tag "notification_preference[email_study_reminders]", "1",
                      pref.email_study_reminders?, class: "sr-only" %>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="14" height="14" aria-hidden="true">
                  <path d="M3 4a2 2 0 00-2 2v1.161l8.441 4.221a1.25 1.25 0 001.118 0L19 7.162V6a2 2 0 00-2-2H3z"/>
                  <path d="M19 8.839l-7.77 3.885a2.75 2.75 0 01-2.46 0L1 8.839V14a2 2 0 002 2h14a2 2 0 002-2V8.839z"/>
                </svg>
              </label>
            </div>
          </div>

          <%# Reminder time %>
          <div class="settings-info-row">
            <div class="settings-info-row__label" style="font-weight: 400; color: var(--color-text-secondary);">
              <%= t("accounts.notif_choose_reminder_time") %>
            </div>
            <div class="settings-info-row__right">
              <%= f.select "notification_preference[reminder_time]",
                    (0..23).map { |h| v = format("%02d:00", h); [v, v] },
                    { selected: pref.reminder_time },
                    { class: "form-control form-control--sm" } %>
            </div>
          </div>

          <%# Time zone %>
          <div class="settings-info-row">
            <div class="settings-info-row__label" style="font-weight: 400; color: var(--color-text-secondary);">
              <%= t("accounts.notif_time_zone") %>
            </div>
            <div class="settings-info-row__right">
              <%= f.select "notification_preference[time_zone]",
                    ActiveSupport::TimeZone.all.map { |tz| [tz.to_s, tz.name] },
                    { selected: pref.time_zone },
                    { class: "form-control form-control--sm" } %>
            </div>
          </div>

        </div>
      </details>

      <div class="settings-card__footer">
        <%= f.submit t("shared.save"), class: "btn btn--primary btn--sm" %>
      </div>

    <% end %>
  </div>

  <%# Appearance %>
  <p class="settings-section-label"><%= t("accounts.appearance_section") %></p>
  <div class="settings-info-card">

    <div class="settings-info-row">
      <div class="settings-info-row__label"><%= t("accounts.theme_label") %></div>
      <div class="settings-info-row__right">
        <div class="theme-dropdown"
             data-theme-target="dropdownWrapper"
             data-theme-auto-label="<%= t("accounts.theme_auto") %>"
             data-theme-light-label="<%= t("accounts.theme_light") %>"
             data-theme-dark-label="<%= t("accounts.theme_dark") %>"
             data-action="click@document->theme#closeIfOutside keydown.esc@document->theme#closeDropdown">
          <button class="theme-dropdown__trigger" type="button"
                  data-action="click->theme#toggleDropdown"
                  aria-haspopup="true">
            <span data-theme-target="triggerLabel"><%= t("accounts.theme_auto") %></span>
            <%= render "shared/icons/chevron_down", css_class: "theme-dropdown__chevron" %>
          </button>
          <div class="theme-dropdown__menu" data-theme-target="menu" data-open="false" role="menu">
            <button class="theme-dropdown__item" type="button"
                    data-theme-target="option"
                    data-action="click->theme#set"
                    data-theme-value-param="auto" role="menuitem"><%= t("accounts.theme_auto") %></button>
            <button class="theme-dropdown__item" type="button"
                    data-theme-target="option"
                    data-action="click->theme#set"
                    data-theme-value-param="light" role="menuitem"><%= t("accounts.theme_light") %></button>
            <button class="theme-dropdown__item" type="button"
                    data-theme-target="option"
                    data-action="click->theme#set"
                    data-theme-value-param="dark" role="menuitem"><%= t("accounts.theme_dark") %></button>
          </div>
        </div>
      </div>
    </div>

    <div class="settings-info-row" id="language">
      <div class="settings-info-row__label"><%= t("accounts.language_label") %></div>
      <div class="settings-info-row__right">
        <%= render "shared/language_selector",
              languages:   Language::LANGUAGES,
              selected:    Current.user.locale,
              input_name:  "locale",
              placeholder: Language::LANGUAGES[Current.user.locale],
              autosubmit:  true,
              form_url:    account_path,
              form_method: :patch,
              form_extras: { section: "language" } %>
      </div>
    </div>

  </div>

  <%# Achievements %>
  <p class="settings-section-label"><%= t("accounts.achievements_section") %></p>
  <% if @all_badges.any? %>
    <div class="badges-grid">
      <% @all_badges.each do |badge| %>
        <% earned = @earned_badge_ids.include?(badge.id) %>
        <div class="badge-card <%= earned ? "badge-card--earned" : "badge-card--locked" %>">
          <div class="badge-card__icon"><%= badge.icon %></div>
          <div class="badge-card__name"><%= badge.name %></div>
          <div class="badge-card__desc"><%= badge.description %></div>
          <% if earned %>
            <div class="badge-card__earned">
              <%= t("accounts.badge_earned_on", date: @user_badges_by_badge_id[badge.id].earned_at.strftime("%-d %b %Y")) %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="badges-empty"><%= t("accounts.no_badges") %></p>
  <% end %>

  <%# Danger zone %>
  <div class="settings-danger-zone" data-controller="modal">
    <div class="settings-danger-zone__row">
      <div class="settings-danger-zone__text">
        <h2 class="settings-danger-zone__title"><%= t("accounts.delete_title") %></h2>
        <p class="settings-danger-zone__description"><%= t("accounts.delete_description") %></p>
      </div>
      <div>
        <button type="button" class="btn btn--danger"
                data-action="click->modal#open">
          <%= t("accounts.delete_button") %>
        </button>
      </div>
    </div>

    <% account_modal_body = capture do %>
      <p><%= t("accounts.delete_modal_warning") %></p>
    <% end %>
    <%= render "shared/destructive_modal",
          modal_id: "delete-account-modal",
          title: t("accounts.delete_title"),
          body_html: account_modal_body,
          confirm_label: t("accounts.delete_modal_confirm"),
          form_url: account_path,
          form_method: :delete,
          require_confirmation: "DELETE" %>
  </div>

</div>
