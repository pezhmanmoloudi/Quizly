<% content_for :title, "Account Settings" %>

<div class="container">
  <div class="page-header">
    <h1>Account Settings</h1>
  </div>

  <div class="settings-layout"
       data-controller="settings-tabs"
       data-settings-tabs-initial-tab-value="<%= @active_section %>">

    <nav class="settings-sidebar" role="tablist" aria-label="Settings navigation">
      <button class="settings-tab"
              role="tab"
              data-settings-tabs-target="tab"
              data-tab="profile"
              data-action="click->settings-tabs#switch keydown->settings-tabs#navigate"
              aria-selected="false">
        Profile
      </button>
      <button class="settings-tab"
              role="tab"
              data-settings-tabs-target="tab"
              data-tab="email"
              data-action="click->settings-tabs#switch keydown->settings-tabs#navigate"
              aria-selected="false">
        Email
      </button>
      <button class="settings-tab"
              role="tab"
              data-settings-tabs-target="tab"
              data-tab="password"
              data-action="click->settings-tabs#switch keydown->settings-tabs#navigate"
              aria-selected="false">
        Password
      </button>
    </nav>

    <div class="settings-content">

      <%# Profile — visible by default (no hidden class) %>
      <section class="settings-section"
               data-settings-tabs-target="section"
               data-section="profile"
               aria-label="Profile">
        <h2>Profile</h2>
        <div class="settings-profile-row">
          <span class="settings-profile-label">Display name</span>
          <span class="settings-profile-value"><%= Current.user.display_name %></span>
        </div>
        <div class="settings-profile-row">
          <span class="settings-profile-label">Email address</span>
          <span class="settings-profile-value"><%= Current.user.email_address %></span>
        </div>
        <div class="settings-profile-row">
          <span class="settings-profile-label">Member since</span>
          <span class="settings-profile-value"><%= Current.user.created_at.strftime("%B %Y") %></span>
        </div>
      </section>

      <%# Email — hidden until tab activated %>
      <section class="settings-section settings-section--hidden"
               data-settings-tabs-target="section"
               data-section="email"
               aria-label="Email settings">
        <h2>Change Email</h2>
        <%= form_with url: account_path, method: :patch do |f| %>
          <div class="form-group">
            <%= f.label :email_address, "New email address" %>
            <%= f.email_field :email_address, value: Current.user.email_address,
                  required: true, autocomplete: "username", class: "form-control" %>
          </div>
          <div class="form-group">
            <%= f.label :current_password, "Current password" %>
            <%= f.password_field :current_password, required: true,
                  autocomplete: "current-password", class: "form-control" %>
          </div>
          <%= f.submit "Update email", class: "btn btn--primary" %>
        <% end %>
      </section>

      <%# Password — hidden until tab activated %>
      <section class="settings-section settings-section--hidden"
               data-settings-tabs-target="section"
               data-section="password"
               aria-label="Password settings">
        <h2>Change Password</h2>
        <%= form_with url: account_path, method: :patch do |f| %>
          <div class="form-group">
            <%= f.label :current_password, "Current password" %>
            <%= f.password_field :current_password, required: true,
                  autocomplete: "current-password", class: "form-control" %>
          </div>
          <div class="form-group">
            <%= f.label :password, "New password" %>
            <%= f.password_field :password, required: true,
                  autocomplete: "new-password", minlength: 8, maxlength: 72,
                  class: "form-control" %>
            <small class="form-hint">Minimum 8 characters</small>
          </div>
          <div class="form-group">
            <%= f.label :password_confirmation, "Confirm new password" %>
            <%= f.password_field :password_confirmation, required: true,
                  autocomplete: "new-password", maxlength: 72, class: "form-control" %>
          </div>
          <%= f.submit "Update password", class: "btn btn--primary" %>
        <% end %>
      </section>

    </div>
  </div>

  <div class="back-link">
    <%= link_to "← Back to Dashboard", root_path %>
  </div>
</div>
