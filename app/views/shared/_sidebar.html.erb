<aside class="sidebar" data-sidebar-target="sidebar">

  <%# Brand %>
  <div class="sidebar__header">
    <%= link_to "Quizly", root_path, class: "sidebar__brand" %>
    <button class="sidebar__close" data-action="click->sidebar#closeMobile"
            aria-label="Close navigation">
      <%= render "shared/icons/x_mark" %>
    </button>
  </div>

  <%# Global search %>
  <%= form_with url: explore_path, method: :get, class: "sidebar__search" do |f| %>
    <div class="sidebar__search-wrap">
      <%= render "shared/icons/magnifying_glass", css_class: "sidebar__search-icon" %>
      <%= f.search_field :q,
            placeholder: "Search decks…",
            class: "sidebar__search-input",
            data: { sidebar_target: "searchInput" },
            aria: { label: "Search decks" },
            autocomplete: "off" %>
      <kbd class="sidebar__search-kbd">Ctrl K</kbd>
    </div>
  <% end %>

  <%# Primary nav %>
  <nav class="sidebar__nav" aria-label="Main navigation">

    <%= link_to dashboard_path,
          class: "sidebar__item #{"is-active" if request.path == dashboard_path}" do %>
      <%= render "shared/icons/home" %> <span>Dashboard</span>
    <% end %>

    <div class="sidebar__section"
         data-sidebar-target="section"
         data-section-key="decks">

      <button class="sidebar__section-trigger"
              data-action="click->sidebar#toggleSection"
              aria-expanded="true">
        <span class="sidebar__section-trigger-label">
          <%= render "shared/icons/rectangle_stack" %> <span>Decks</span>
        </span>
        <span class="sidebar__chevron"><%= render "shared/icons/chevron_down" %></span>
      </button>

      <div class="sidebar__section-body" data-sidebar-target="sectionBody">
        <div>
          <%= link_to new_deck_path, class: "sidebar__create-btn btn-with-icon" do %>
            <%= render "shared/icons/plus", css_class: "icon--sm" %> New Deck
          <% end %>

          <%= turbo_frame_tag "sidebar-decks" do %>
            <%= render "decks/sidebar_list", decks: @sidebar_decks %>
          <% end %>
        </div>
      </div>
    </div>

    <%= link_to explore_path,
          class: "sidebar__item #{"is-active" if request.path.start_with?(explore_path)}" do %>
      <%= render "shared/icons/globe" %> <span>Explore</span>
    <% end %>

    <%= link_to account_path,
          class: "sidebar__item #{"is-active" if request.path.start_with?(account_path)}" do %>
      <%= render "shared/icons/cog" %> <span>Account</span>
    <% end %>

  </nav>

  <%# User footer %>
  <div class="sidebar__footer"
       data-controller="avatar-dropdown"
       data-action="click@document->avatar-dropdown#closeIfOutside keydown.esc@document->avatar-dropdown#close">

    <button class="sidebar__user-btn"
            data-avatar-dropdown-target="button"
            data-action="click->avatar-dropdown#toggle"
            aria-haspopup="true"
            aria-expanded="false">
      <div class="user-avatar user-avatar--sm">
        <% if Current.user.show_avatar? %>
          <%= image_tag Current.user.avatar, alt: "" %>
        <% else %>
          <%= Current.user.display_name.first.upcase %>
        <% end %>
      </div>
      <span class="sidebar__user-name"><%= Current.user.display_name %></span>
    </button>

    <div class="avatar-dropdown__menu avatar-dropdown__menu--up"
         data-avatar-dropdown-target="menu"
         data-open="false"
         role="menu">
      <div class="avatar-dropdown__items">
        <%= link_to "Account Settings", account_path,
              class: "avatar-dropdown__item", role: "menuitem" %>
        <hr class="avatar-dropdown__divider">
        <%= button_to "Logout", logout_path, method: :delete,
              class: "avatar-dropdown__item avatar-dropdown__item--danger",
              role: "menuitem" %>
      </div>
    </div>

  </div>

</aside>
