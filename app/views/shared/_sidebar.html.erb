<aside class="sidebar" data-sidebar-target="sidebar">

  <%# Header: brand + mobile close %>
  <div class="sidebar__header">
    <%= link_to root_path, class: "sidebar__brand" do %>
      <span class="sidebar__brand-mark">Q</span>
      <span class="sidebar__brand-text">uizly</span>
    <% end %>
    <button class="sidebar__close" data-action="click->sidebar#closeMobile"
            aria-label="Close navigation">
      <%= render "shared/icons/x_mark" %>
    </button>
  </div>

  <%# Search: full input (expanded), icon button (collapsed) %>
  <%= form_with url: explore_path, method: :get, class: "sidebar__search" do |f| %>
    <div class="sidebar__search-wrap">
      <%= render "shared/icons/magnifying_glass", css_class: "sidebar__search-icon" %>
      <%= f.search_field :q,
            placeholder: "Search decks…",
            class: "sidebar__search-input",
            data: { sidebar_target: "searchInput" },
            aria: { label: "Search decks" },
            autocomplete: "off" %>
      <kbd class="sidebar__search-kbd">Ctrl K</kbd>
    </div>
  <% end %>

  <button class="sidebar__search-icon-btn"
          data-action="click->sidebar#expandAndFocusSearch"
          aria-label="Search"
          data-tooltip="Search (Ctrl K)">
    <%= render "shared/icons/magnifying_glass" %>
  </button>

  <%# Primary nav %>
  <nav class="sidebar__nav" aria-label="Main navigation">

    <%= link_to dashboard_path,
          class: "sidebar__item #{"is-active" if request.path == dashboard_path}",
          data: { tooltip: "Dashboard" } do %>
      <%= render "shared/icons/home" %>
      <span class="sidebar__label">Dashboard</span>
    <% end %>

    <%# Decks: collapsed → link to /decks; expanded → collapsible section %>
    <div class="sidebar__section"
         data-sidebar-target="section"
         data-section-key="decks">

      <%# Collapsed mode only: simple link to /decks %>
      <%= link_to decks_path,
            class: "sidebar__item sidebar__decks-link",
            data: { tooltip: "Decks" },
            aria: { label: "Decks" } do %>
        <%= render "shared/icons/rectangle_stack" %>
      <% end %>

      <%# Expanded mode only: collapsible trigger %>
      <button class="sidebar__section-trigger"
              data-action="click->sidebar#toggleSection"
              aria-expanded="true">
        <span class="sidebar__section-trigger-label">
          <%= render "shared/icons/rectangle_stack" %>
          <span class="sidebar__label">Decks</span>
        </span>
        <span class="sidebar__chevron"><%= render "shared/icons/chevron_down" %></span>
      </button>

      <div class="sidebar__section-body" data-sidebar-target="sectionBody">
        <div>
          <%= link_to new_deck_path, class: "sidebar__create-btn" do %>
            <%= render "shared/icons/plus", css_class: "icon--sm" %>
            <span class="sidebar__label">New Deck</span>
          <% end %>

          <%= turbo_frame_tag "sidebar-decks" do %>
            <%= render "decks/sidebar_list", decks: @sidebar_decks %>
          <% end %>
        </div>
      </div>
    </div>

    <%= link_to explore_path,
          class: "sidebar__item #{"is-active" if request.path.start_with?(explore_path)}",
          data: { tooltip: "Explore" } do %>
      <%= render "shared/icons/globe" %>
      <span class="sidebar__label">Explore</span>
    <% end %>

    <%= link_to account_path,
          class: "sidebar__item #{"is-active" if request.path.start_with?(account_path)}",
          data: { tooltip: "Account" } do %>
      <%= render "shared/icons/cog" %>
      <span class="sidebar__label">Account</span>
    <% end %>

  </nav>

  <%# Footer: collapse toggle only %>
  <div class="sidebar__footer">
    <button class="sidebar__collapse-btn"
            data-action="click->sidebar#toggleCollapse"
            aria-label="Toggle sidebar width">
      <%= render "shared/icons/chevron_down", css_class: "sidebar__collapse-icon" %>
    </button>
  </div>

</aside>
