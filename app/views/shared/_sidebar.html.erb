<aside class="sidebar">

  <%# Header %>
  <div class="sidebar__header">
    <%= link_to root_path, class: "sidebar__brand", dir: "ltr" do %>
      <span class="sidebar__brand-mark">Q</span>
      <span class="sidebar__brand-text">uizly</span>
    <% end %>

    <label for="app-drawer" class="sidebar__close"
           aria-label="<%= t("topbar.close_navigation") %>">
      <%= render "shared/icons/x_mark" %>
    </label>
  </div>

  <%# Primary nav %>
  <nav class="sidebar__nav" aria-label="Main navigation">

    <%= link_to dashboard_path,
          class: "sidebar__item #{"is-active" if request.path == dashboard_path}",
          data: { tooltip: t("nav.home") } do %>
      <%= render "shared/icons/home" %>
      <span class="sidebar__label"><%= t("nav.home") %></span>
    <% end %>

    <%= link_to explore_path,
          class: "sidebar__item #{"is-active" if request.path.start_with?(explore_path)}",
          data: { tooltip: t("nav.explore") } do %>
      <%= render "shared/icons/globe" %>
      <span class="sidebar__label"><%= t("nav.explore") %></span>
    <% end %>

    <hr class="sidebar__divider">

    <div class="sidebar__section-header">
      <%= link_to decks_path,
            class: "sidebar__section-title #{"is-active" if request.path.start_with?(decks_path)}",
            data: { tooltip: t("nav.my_library") } do %>
        <%= render "shared/icons/book_open", css_class: "icon--sm" %>
        <span><%= t("nav.my_library") %></span>
      <% end %>
    </div>

    <div class="sidebar__deck-section">
      <%= turbo_frame_tag "sidebar-decks" do %>
        <%= render "decks/sidebar_list", decks: @sidebar_decks %>
      <% end %>
    </div>

  </nav>

</aside>
