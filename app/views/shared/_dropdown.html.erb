<%
  _options            = local_assigns.fetch(:options)
  _selected           = local_assigns.fetch(:selected, "").to_s
  _input_name         = local_assigns.fetch(:input_name)
  _placeholder        = local_assigns.fetch(:placeholder)
  _searchable         = local_assigns.fetch(:searchable, false)
  _search_placeholder = local_assigns.fetch(:search_placeholder, "")
  _scrollable         = local_assigns.fetch(:scrollable, false)
  _autosubmit         = local_assigns.fetch(:autosubmit, false)
  _form_url           = local_assigns.fetch(:form_url, nil)
  _form_method        = local_assigns.fetch(:form_method, :patch)
  _form_extras        = local_assigns.fetch(:form_extras, {})
  _input_data         = local_assigns.fetch(:input_data, {})
  _form_id            = local_assigns.fetch(:form_id, nil)
  _wrapper_class      = local_assigns.fetch(:wrapper_class, nil)
  _compact            = local_assigns.fetch(:compact, false)
  _size               = local_assigns.fetch(:size, :default)

  _classes = ["ui-dropdown"]
  _classes << "ui-dropdown--compact" if _compact
  _classes << _wrapper_class if _wrapper_class

  _label_text    = _options.find { |_lbl, val| val.to_s == _selected }&.first || _placeholder
  _trigger_class = ["ui-dropdown__trigger"]
  _trigger_class << "ui-dropdown__trigger--sm" if _size == :sm
  _menu_class    = ["ui-dropdown__menu"]
  _menu_class    << "ui-dropdown__menu--scrollable" if _scrollable
%>
<div class="<%= _classes.join(" ") %>"
     data-controller="dropdown"
     data-dropdown-searchable-value="<%= _searchable %>"
     data-dropdown-autosubmit-value="<%= _autosubmit %>"
     data-action="click@document->dropdown#closeIfOutside keydown@window->dropdown#onKeydown">

  <% if _form_url %>
    <%= form_with url: _form_url, method: _form_method,
          data: { dropdown_target: "form" } do %>
      <% _form_extras.each do |k, v| %>
        <%= hidden_field_tag k, v %>
      <% end %>
      <%= hidden_field_tag _input_name, _selected,
            id: nil,
            data: { dropdown_target: "input" }.merge(_input_data) %>
    <% end %>
  <% else %>
    <%= hidden_field_tag _input_name, _selected,
          id: nil,
          form: _form_id,
          data: { dropdown_target: "input" }.merge(_input_data) %>
  <% end %>

  <button type="button"
          class="<%= _trigger_class.join(" ") %>"
          aria-haspopup="listbox"
          aria-expanded="false"
          data-dropdown-target="trigger"
          data-action="click->dropdown#toggle">
    <span data-dropdown-target="label"><%= _label_text %></span>
    <%= render "shared/icons/chevron_down", css_class: "ui-dropdown__chevron" %>
  </button>

  <div class="<%= _menu_class.join(" ") %>"
       data-dropdown-target="menu"
       data-open="false"
       role="listbox">
    <% if _searchable %>
      <div class="ui-dropdown__search-wrap">
        <input type="text"
               class="ui-dropdown__search"
               placeholder="<%= _search_placeholder %>"
               data-dropdown-target="search"
               data-action="input->dropdown#filter"
               autocomplete="off">
      </div>
    <% end %>
    <div class="ui-dropdown__list">
      <% _options.each do |label, value| %>
        <button type="button"
                class="ui-dropdown__option"
                role="option"
                aria-selected="<%= value.to_s == _selected %>"
                data-dropdown-target="option"
                data-value="<%= value %>"
                data-name="<%= label.to_s.downcase %>"
                data-action="click->dropdown#select">
          <%= label %>
        </button>
      <% end %>
    </div>
  </div>
</div>
