<%
  _languages     = local_assigns.fetch(:languages)
  _selected      = local_assigns.fetch(:selected, "").to_s
  _input_name    = local_assigns.fetch(:input_name)
  _placeholder   = local_assigns.fetch(:placeholder)
  _autosubmit    = local_assigns.fetch(:autosubmit, false)
  _form_url      = local_assigns.fetch(:form_url, nil)
  _form_method   = local_assigns.fetch(:form_method, :patch)
  _form_extras   = local_assigns.fetch(:form_extras, {})
  _input_data    = local_assigns.fetch(:input_data, {})
  _wrapper_class = local_assigns.fetch(:wrapper_class, nil)
  _label_text    = _languages[_selected] || _placeholder
%>
<div class="lang-dropdown <%= _wrapper_class %>"
     data-controller="language"
     data-language-current-value="<%= _selected %>"
     data-language-autosubmit-value="<%= _autosubmit %>"
     data-action="click@document->language#closeIfOutside keydown.esc@document->language#close">

  <% if _form_url %>
    <%= form_with url: _form_url, method: _form_method,
          data: { language_target: "form" } do %>
      <% _form_extras.each do |k, v| %>
        <%= hidden_field_tag k, v %>
      <% end %>
      <%= hidden_field_tag _input_name, _selected,
            id: nil,
            data: { language_target: "input" }.merge(_input_data) %>
    <% end %>
  <% else %>
    <%= hidden_field_tag _input_name, _selected,
          id: nil,
          data: { language_target: "input" }.merge(_input_data) %>
  <% end %>

  <button class="lang-dropdown__trigger" type="button"
          data-action="click->language#toggle"
          aria-haspopup="listbox"
          aria-expanded="false">
    <span data-language-target="triggerLabel"><%= _label_text %></span>
    <%= render "shared/icons/chevron_down", css_class: "lang-dropdown__chevron" %>
  </button>

  <div class="lang-dropdown__menu" data-language-target="menu"
       data-open="false" role="listbox">
    <div class="lang-dropdown__search-wrap">
      <input type="text" class="lang-dropdown__search"
             placeholder="<%= t("accounts.search_languages") %>"
             data-language-target="search"
             data-action="input->language#filter"
             autocomplete="off">
    </div>
    <div class="lang-dropdown__list">
      <% _languages.each do |code, name| %>
        <button class="lang-dropdown__item <%= "is-active" if code == _selected %>"
                type="button"
                role="option"
                aria-selected="<%= code == _selected %>"
                data-language-target="option"
                data-code="<%= code %>"
                data-name="<%= name.downcase %>"
                data-action="click->language#select">
          <%= name %>
        </button>
      <% end %>
    </div>
  </div>
</div>
