<% content_for :title, t("sessions.title") %>

<div class="auth-split">
  <div class="auth-split__form">
    <%= link_to root_path, class: "auth-close", aria: { label: t("auth.back_to_home") } do %>
      <%= render "shared/icons/x_mark", css_class: "auth-close__icon" %>
    <% end %>

    <%= link_to root_path, class: "auth-split__logo", dir: "ltr" do %>
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="28" height="28" rx="7" fill="currentColor" opacity="0.15"/>
        <text x="14" y="19" text-anchor="middle" font-size="14" font-weight="700" fill="currentColor">Q</text>
      </svg>
      Quizly
    <% end %>

    <% if flash[:alert] %>
      <div class="form-errors"><%= flash[:alert] %></div>
    <% end %>

    <h1 class="auth-split__heading"><%= t("sessions.heading") %></h1>
    <p class="auth-split__sub"><%= t("sessions.subheading") %></p>

    <%= form_with url: login_path do |f| %>
      <div class="form-group">
        <%= f.label :email_address, t("sessions.email_label") %>
        <div class="auth-input">
          <svg class="auth-input__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/>
            <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/>
          </svg>
          <%= f.email_field :email_address, required: true, autofocus: true,
                autocomplete: "username", class: "form-control",
                placeholder: t("sessions.email_placeholder"),
                value: params[:email_address] %>
        </div>
      </div>

      <div class="form-group" data-controller="password-toggle">
        <%= f.label :password, t("sessions.password_label") %>
        <div class="auth-input">
          <svg class="auth-input__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
          </svg>
          <%= f.password_field :password, required: true,
                autocomplete: "current-password", maxlength: 72,
                class: "form-control", placeholder: t("sessions.password_placeholder"),
                data: { password_toggle_target: "field" } %>
          <button type="button" class="auth-input__toggle"
                  data-action="password-toggle#toggle"
                  aria-label="<%= t("sessions.toggle_password") %>">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 20 20" fill="currentColor">
              <path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/>
              <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/>
            </svg>
          </button>
        </div>
      </div>

      <div class="auth-split__forgot">
        <%= link_to t("sessions.forgot_password"), forgot_password_path %>
      </div>

      <%= f.submit t("sessions.submit"), class: "btn btn--primary btn--block" %>
    <% end %>

    <p class="auth-split__footer">
      <%= t("sessions.no_account") %> <%= link_to t("sessions.sign_up"), signup_path %>
    </p>
  </div>

  <%= render "auth_panel" %>
</div>
