<% content_for :title, "Study: #{@deck.name}" %>

<div class="study-island"
     data-controller="study-mode"
     tabindex="-1"
     aria-label="Study session">

  <div class="study-island__header">
    <div class="study-hdr__left">
      <%= link_to t("study_modes.exit"), @deck, class: "study-island__exit",
            data: { study_mode_target: "exitLink" } %>
    </div>

    <div class="study-hdr__center">
      <h2 class="study-hdr__title"><%= @deck.name %></h2>
    </div>

    <div class="study-hdr__right">
      <button class="study-hdr__btn"
              type="button"
              aria-label="<%= t("study_modes.study.settings_btn_label") %>"
              data-action="click->study-mode#openSettings"
              data-study-mode-target="settingsBtn">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="16" height="16" aria-hidden="true">
          <path fill-rule="evenodd" d="M7.84 1.804A1 1 0 0 1 8.82 1h2.36a1 1 0 0 1 .98.804l.331 1.652a6.993 6.993 0 0 1 1.929 1.115l1.598-.54a1 1 0 0 1 1.186.447l1.18 2.044a1 1 0 0 1-.205 1.251l-1.267 1.113a7.047 7.047 0 0 1 0 2.228l1.267 1.113a1 1 0 0 1 .206 1.25l-1.18 2.045a1 1 0 0 1-1.187.447l-1.598-.54a6.993 6.993 0 0 1-1.929 1.115l-.33 1.652a1 1 0 0 1-.98.804H8.82a1 1 0 0 1-.98-.804l-.331-1.652a6.993 6.993 0 0 1-1.929-1.115l-1.598.54a1 1 0 0 1-1.186-.447l-1.18-2.044a1 1 0 0 1 .205-1.251l1.267-1.114a7.05 7.05 0 0 1 0-2.227L1.821 7.773a1 1 0 0 1-.206-1.25l1.18-2.045a1 1 0 0 1 1.187-.447l1.598.54A6.993 6.993 0 0 1 7.51 3.456l.33-1.652ZM10 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" clip-rule="evenodd"/>
        </svg>
      </button>

      <% if @card_progress.present? %>
        <div class="study-hdr__chip study-hdr__chip--remaining">
          <span><%= @cards_remaining %></span>
          <span class="study-hdr__chip-label"><%= t("study_modes.study.remaining_label") %></span>
        </div>
      <% end %>

      <div class="study-hdr__chip study-hdr__chip--streak">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="14" height="14" aria-hidden="true">
          <path d="M12.395 2.553a1 1 0 0 0-1.45-.385c-.345.23-.614.558-.822.88-.214.33-.403.713-.57 1.116-.334.804-.614 1.768-.84 2.734a31.365 31.365 0 0 0-.613 3.58 2.64 2.64 0 0 1-.945-1.067c-.328-.68-.398-1.534-.398-2.654A1 1 0 0 0 5.05 6.05 6.981 6.981 0 0 0 3 11a7 7 0 1 0 11.95-4.95c-.592-.591-.98-.985-1.348-1.467-.363-.476-.724-1.063-1.207-2.03ZM12.12 15.12A3 3 0 0 1 7 13s.879.5 2.5.5c0-1 .5-4 1.25-4.5.5 1 .786 1.293 1.371 1.879A2.99 2.99 0 0 1 13 13a2.99 2.99 0 0 1-.879 2.121Z"/>
        </svg>
        <span data-study-mode-target="streak"><%= @streak || 0 %></span>
      </div>
    </div>
  </div>

  <div class="study-island__mode-bar">
    <%= link_to t("study_modes.study.all_cards_tab"),
          study_deck_path(@deck, new_limit: @new_limit, priority: (@priority if @priority != "due")),
          class: "study-mode-tab #{"study-mode-tab--active" if @study_mode == "all"}" %>
    <%= link_to t("study_modes.study.starred_tab"),
          study_deck_path(@deck, mode: "starred", new_limit: @new_limit, priority: (@priority if @priority != "due")),
          class: "study-mode-tab #{"study-mode-tab--active" if @study_mode == "starred"}" %>
  </div>

  <%= turbo_frame_tag "study_card",
        data: { action: "turbo:frame-load->study-mode#resetSubmitLock" } do %>
    <%# Progress lives inside the frame so it re-renders with each rating (frame-scoped swap). %>
    <% if @card_progress.present? && @cards_total.to_i > 0 %>
      <% cards_done = (@cards_total - @cards_remaining).clamp(0, @cards_total) %>
      <% progress_pct = (cards_done.to_f / @cards_total * 100).round %>
      <div class="study-island__progress-wrap">
        <div class="study-island__progress">
          <div class="study-island__progress-fill" style="width: <%= progress_pct %>%"></div>
        </div>
        <span class="study-island__progress-label">
          <%= progress_pct %>% · <%= t("study_modes.study.progress_remaining", count: @cards_remaining) %>
        </span>
      </div>
    <% end %>

    <% if @card_progress.nil? %>
      <% if flash[:study_summary].present? %>
        <% summary = flash[:study_summary] %>
        <div class="study-empty">
          <div class="session-summary">
            <div class="session-summary__icon">🎉</div>
            <h3 class="session-summary__title"><%= t("study_modes.study.summary_title") %></h3>
            <div class="session-summary__stats">
              <div class="session-summary__stat">
                <span class="session-summary__value"><%= summary[:reviewed] || summary["reviewed"] %></span>
                <span class="session-summary__label"><%= t("study_modes.study.reviewed") %></span>
              </div>
              <div class="session-summary__stat">
                <% reviewed = summary[:reviewed] || summary["reviewed"] || 1 %>
                <% correct  = summary[:correct]  || summary["correct"]  || 0 %>
                <span class="session-summary__value"><%= ((correct.to_f / reviewed) * 100).round %>%</span>
                <span class="session-summary__label"><%= t("study_modes.study.accuracy") %></span>
              </div>
              <% elapsed = summary[:elapsed] || summary["elapsed"] %>
              <% if elapsed.present? %>
                <div class="session-summary__stat">
                  <span class="session-summary__value"><%= format_study_time(elapsed.to_i) %></span>
                  <span class="session-summary__label"><%= t("study_modes.study.time_spent") %></span>
                </div>
              <% end %>
            </div>
            <p class="session-summary__sub"><%= t("study_modes.study.summary_sub") %></p>
          </div>
        </div>
      <% else %>
        <%= render "shared/empty_state",
              icon: "academic_cap",
              title: t("study_modes.study.empty_title"),
              description: t("study_modes.study.empty_description"),
              variant: :default %>
      <% end %>
    <% else %>
      <div class="study-card"
           data-controller="flashcard"
           data-flashcard-flipped-class="is-flipped">

        <div class="study-card__content">
          <div class="study-card__front">
            <% flashcard = @card_progress.flashcard %>
            <% if flashcard.image.attached? %>
              <div class="study-card__img-wrap">
                <%= image_tag rails_blob_path(flashcard.image, disposition: "inline"),
                      class: "study-card__img", alt: "" %>
              </div>
            <% end %>
            <span class="<%= 'study-card__term' if flashcard.image.attached? %>"><%= flashcard.front_content %></span>
          </div>

          <div class="study-card__back" data-flashcard-target="back" hidden>
            <div class="study-card__divider"></div>
            <%= @card_progress.flashcard.back_content %>
          </div>
        </div>

        <div class="study-card__footer">
          <button class="study-reveal-btn"
                  data-flashcard-target="showButton"
                  data-study-mode-target="showButton"
                  data-action="click->flashcard#reveal"
                  aria-keyshortcuts="Space">
            <%= t("study_modes.study.show_answer") %>
            <kbd class="study-kbd">Space</kbd>
          </button>

          <%= form_with url: card_reviews_path,
                        data: { flashcard_target: "ratingForm" },
                        style: "display:none" do |f| %>
            <%= hidden_field_tag :card_progress_id, @card_progress.id %>
            <%= hidden_field_tag :study_mode, @study_mode %>
            <%= hidden_field_tag :new_limit, @new_limit %>
            <%= hidden_field_tag :priority, @priority %>
            <div class="rating-buttons">
              <%= f.submit t("study_modes.study.again"), name: :rating, value: "again",
                    class: "rating-btn rating-btn--again",
                    data: { study_mode_target: "againBtn", action: "click->study-mode#trackRating" },
                    aria: { keyshortcuts: "1" } %>
              <%= f.submit t("study_modes.study.hard"),  name: :rating, value: "hard",
                    class: "rating-btn rating-btn--hard",
                    data: { study_mode_target: "hardBtn", action: "click->study-mode#trackRating" },
                    aria: { keyshortcuts: "2" } %>
              <%= f.submit t("study_modes.study.good"),  name: :rating, value: "good",
                    class: "rating-btn rating-btn--good",
                    data: { study_mode_target: "goodBtn", action: "click->study-mode#trackRating" },
                    aria: { keyshortcuts: "3" } %>
              <%= f.submit t("study_modes.study.easy"),  name: :rating, value: "easy",
                    class: "rating-btn rating-btn--easy",
                    data: { study_mode_target: "easyBtn", action: "click->study-mode#trackRating" },
                    aria: { keyshortcuts: "4" } %>
            </div>
          <% end %>

          <div class="study-card__star-row" data-flashcard-target="ratingForm" style="display:none">
            <%= render "starred_cards/toggle", card_progress: @card_progress %>
          </div>

          <p class="keyboard-hint" aria-hidden="true"><%= t("study_modes.study.keyboard_hint") %></p>
        </div>
      </div>
    <% end %>
  <% end %>

  <div class="study-options"
       data-study-mode-target="settingsDrawer"
       aria-hidden="true">
    <div class="study-options__header">
      <h3 class="study-options__title"><%= t("study_modes.study.settings_btn_label") %></h3>
      <button class="study-options__close"
              data-action="click->study-mode#closeSettings"
              aria-label="<%= t("shared.close") %>">
        <%= render "shared/icons/x_mark" %>
      </button>
    </div>
    <div class="study-options__body">
      <%= form_with url: study_deck_path(@deck), method: :get, class: "study-options__form",
                    data: { action: "submit->study-mode#saveSettings" } do |f| %>
        <%= hidden_field_tag :mode, @study_mode %>
        <div class="study-options__row">
          <label class="study-options__label" for="study_new_limit">
            <%= t("study_modes.study.new_cards_label") %>
          </label>
          <select id="study_new_limit" name="new_limit" class="study-options__select"
                  data-study-mode-target="newLimitSelect">
            <option value="5"  <%= "selected" if @new_limit == 5  %>>5</option>
            <option value="10" <%= "selected" if @new_limit == 10 %>>10</option>
            <option value="20" <%= "selected" if @new_limit == 20 %>>20</option>
            <option value="0"  <%= "selected" if @new_limit == 0  %>><%= t("study_modes.study.new_cards_all") %></option>
          </select>
        </div>
        <div class="study-options__row">
          <label class="study-options__label" for="study_priority">
            <%= t("study_modes.study.priority_label") %>
          </label>
          <select id="study_priority" name="priority" class="study-options__select"
                  data-study-mode-target="prioritySelect">
            <option value="due"     <%= "selected" if @priority == "due"     %>><%= t("study_modes.study.priority_due") %></option>
            <option value="hardest" <%= "selected" if @priority == "hardest" %>><%= t("study_modes.study.priority_hardest") %></option>
          </select>
        </div>
        <%= f.submit t("study_modes.study.apply_settings"), class: "study-options__apply-btn" %>
      <% end %>
    </div>
  </div>

  <div class="study-options__overlay"
       data-study-mode-target="settingsOverlay"
       data-action="click->study-mode#closeSettings"
       hidden></div>
</div>
