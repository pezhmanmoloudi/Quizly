<% content_for :title, t("study_sessions.title") %>

<div class="container" style="padding-top: 2rem; padding-bottom: 3rem;">
  <div class="section-header">
    <h1><%= t("study_sessions.title") %></h1>
    <%= link_to t("study_sessions.back"), dashboard_path, class: "section-header__link" %>
  </div>

  <% if @study_sessions.empty? %>
    <%= render "shared/empty_state",
          icon: "academic_cap",
          title: t("study_sessions.empty_title"),
          description: t("study_sessions.empty_description"),
          cta_text: t("study_sessions.go_to_decks"),
          cta_path: decks_path,
          variant: :dashboard %>
  <% else %>
    <div class="study-history-table-wrap">
      <table class="study-history-table">
        <thead>
          <tr>
            <th><%= t("study_sessions.deck_header") %></th>
            <th><%= t("study_sessions.date_header") %></th>
            <th><%= t("study_sessions.reviewed_header") %></th>
            <th><%= t("study_sessions.accuracy_header") %></th>
            <th><%= t("study_sessions.time_header") %></th>
          </tr>
        </thead>
        <tbody>
          <% @study_sessions.each do |session| %>
            <tr>
              <td>
                <%= link_to session.deck.name, session.deck, class: "study-history-table__deck-link" %>
              </td>
              <td class="study-history-table__date">
                <%= session.started_at.strftime("%-d %b %Y") %>
              </td>
              <td><%= session.cards_reviewed %></td>
              <td>
                <span class="study-history-table__accuracy" data-accuracy="<%= session.accuracy %>">
                  <%= localized_number(session.accuracy) %>%
                </span>
              </td>
              <td><%= format_study_time(session.elapsed_seconds) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
