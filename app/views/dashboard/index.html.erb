<div class="dashboard-hero">
  <div class="container">
    <h1 class="dashboard-hero__heading">Welcome back, <%= Current.user.display_name %></h1>
    <p class="dashboard-hero__sub">Keep the momentum going — your decks are waiting.</p>
  </div>
</div>

<% if @continue_deck %>
  <div class="container" style="padding-top: 1.5rem; padding-bottom: 0;">
    <%= render "continue_studying", deck: @continue_deck, due: @continue_due %>
  </div>
<% end %>

<div class="container">
  <div class="stats-grid">
    <div class="stat-card">
      <div id="total-decks-count" class="stat-card__value"><%= @total_decks %></div>
      <div class="stat-card__label">Total Decks</div>
    </div>
    <div class="stat-card">
      <div id="total-cards-count" class="stat-card__value"><%= @total_cards %></div>
      <div class="stat-card__label">Total Cards</div>
    </div>
    <div class="stat-card">
      <div id="cards-due-count" class="stat-card__value stat-card__value--due"><%= @total_due %></div>
      <div class="stat-card__label">Cards Due</div>
    </div>
  </div>

  <div class="section-header" style="margin-top: 2.5rem;">
    <h2>Study History</h2>
    <%= link_to "See all", study_sessions_path, class: "section-header__link" %>
  </div>
  <% recent_sessions = Current.user.study_sessions.completed.includes(:deck).recent.limit(3) %>
  <% if recent_sessions.any? %>
    <div class="study-history-mini">
      <% recent_sessions.each do |s| %>
        <div class="study-history-mini__item">
          <span class="study-history-mini__deck"><%= s.deck.name %></span>
          <span class="study-history-mini__stats"><%= s.cards_reviewed %> cards &middot; <%= s.accuracy %>% accuracy</span>
          <span class="study-history-mini__date"><%= s.started_at.strftime("%-d %b") %></span>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="study-history-mini__empty">Complete a study session to see your history here.</p>
  <% end %>

  <% if @decks.any? %>
    <div class="section-header" style="margin-top: 2.5rem;">
      <h2>My Decks</h2>
      <%= link_to "See all", decks_path, class: "section-header__link" %>
    </div>
    <div class="deck-grid">
      <%= render partial: "decks/deck_card", collection: @decks, as: :deck,
                 locals: { due_counts: @due_counts } %>
    </div>
  <% else %>
    <div style="margin-top: 2.5rem;">
      <%= render "shared/empty_state",
            icon: "rectangle_stack",
            title: "No decks yet",
            description: "Create your first deck to start studying.",
            cta_text: "Create Deck",
            cta_path: new_deck_path,
            variant: :dashboard %>
    </div>
  <% end %>
</div>
