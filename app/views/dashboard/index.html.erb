<% if @continue_deck %>
  <div class="container" style="padding-top: 1.5rem; padding-bottom: 0;">
    <%= render "continue_studying", deck: @continue_deck, due: @continue_due %>
  </div>
<% end %>

<div class="container">
  <div class="stats-grid">
    <div class="stat-card">
      <div id="total-decks-count" class="stat-card__value"><%= localized_number(@total_decks) %></div>
      <div class="stat-card__label"><%= t("dashboard.total_decks") %></div>
    </div>
    <div class="stat-card">
      <div id="total-cards-count" class="stat-card__value"><%= localized_number(@total_cards) %></div>
      <div class="stat-card__label"><%= t("dashboard.total_cards") %></div>
    </div>
    <div class="stat-card">
      <div id="cards-due-count" class="stat-card__value stat-card__value--due"><%= localized_number(@total_due) %></div>
      <div class="stat-card__label"><%= t("dashboard.cards_due") %></div>
    </div>
    <div class="stat-card">
      <div class="stat-card__value stat-card__value--streak">🔥 <%= localized_number(Current.user.current_streak) %></div>
      <div class="stat-card__label"><%= t("dashboard.current_streak") %></div>
    </div>
    <div class="stat-card">
      <div class="stat-card__value stat-card__value--streak"><%= localized_number(Current.user.longest_streak) %></div>
      <div class="stat-card__label"><%= t("dashboard.longest_streak") %></div>
    </div>
  </div>

  <div class="section-header" style="margin-top: 2.5rem;">
    <h2><%= t("dashboard.achievements_title") %></h2>
    <%= link_to t("dashboard.achievements_view_all"), achievements_path, class: "section-header__link" %>
  </div>
  <% if @badges_preview.any? %>
    <div class="badges-grid-preview">
      <% @badges_preview.each do |badge| %>
        <div class="badge-card badge-card--earned">
          <div class="badge-card__icon"><%= badge.icon %></div>
          <div class="badge-card__name"><%= badge.name %></div>
        </div>
      <% end %>
    </div>
    <p class="achievements-preview-count"><%= t("dashboard.achievements_earned_count", earned: localized_number(@badges_earned), total: localized_number(@badges_total)) %></p>
  <% else %>
    <p class="achievements-preview-empty"><%= t("dashboard.achievements_none_yet") %></p>
  <% end %>

  <div class="section-header" style="margin-top: 2.5rem;">
    <h2><%= t("dashboard.study_history") %></h2>
    <%= link_to t("dashboard.see_all"), study_sessions_path, class: "section-header__link" %>
  </div>
  <% recent_sessions = Current.user.study_sessions.completed.includes(:deck).recent.limit(3) %>
  <% if recent_sessions.any? %>
    <div class="study-history-mini">
      <% recent_sessions.each do |s| %>
        <div class="study-history-mini__item">
          <span class="study-history-mini__deck"><%= s.deck.name %></span>
          <span class="study-history-mini__stats"><%= t("dashboard.history_stats", cards: localized_number(s.cards_reviewed), accuracy: localized_number(s.accuracy)) %></span>
          <span class="study-history-mini__date"><%= s.started_at.strftime("%-d %b") %></span>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="study-history-mini__empty"><%= t("dashboard.empty_history") %></p>
  <% end %>

  <% if @decks.any? %>
    <div class="section-header" style="margin-top: 2.5rem;">
      <h2><%= t("dashboard.my_decks") %></h2>
      <%= link_to t("dashboard.see_all"), decks_path, class: "section-header__link" %>
    </div>
    <div class="deck-list">
      <%= render partial: "decks/deck_card", collection: @decks, as: :deck,
                 locals: { due_counts: @due_counts, last_studied_dates: @last_studied_dates } %>
    </div>
  <% else %>
    <div style="margin-top: 2.5rem;">
      <%= render "shared/empty_state",
            icon: "rectangle_stack",
            title: t("dashboard.no_decks_title"),
            description: t("dashboard.no_decks_description"),
            variant: :dashboard %>
    </div>
  <% end %>
</div>
