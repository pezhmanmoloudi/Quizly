<div class="dashboard-hero">
  <div class="container">
    <h1 class="dashboard-hero__heading">Welcome back, <%= Current.user.display_name %></h1>
    <p class="dashboard-hero__sub">Keep the momentum going — your decks are waiting.</p>
  </div>
</div>

<div class="container">
  <div class="stats-grid">
    <div class="stat-card">
      <div id="total-decks-count" class="stat-card__value"><%= @total_decks %></div>
      <div class="stat-card__label">Total Decks</div>
    </div>
    <div class="stat-card">
      <div id="total-cards-count" class="stat-card__value"><%= @total_cards %></div>
      <div class="stat-card__label">Total Cards</div>
    </div>
    <div class="stat-card">
      <div id="cards-due-count" class="stat-card__value stat-card__value--due"><%= @total_due %></div>
      <div class="stat-card__label">Cards Due</div>
    </div>
  </div>

  <div class="section-header" style="margin-top: 2rem;">
    <h2>My Library</h2>
  </div>

  <div id="decks-section">
    <% if @decks.empty? %>
      <div class="empty-state--centered">
        <div class="empty-state__icon">📚</div>
        <h3 class="empty-state__title">Create your first deck</h3>
        <p class="empty-state__description">Start building flashcards and track your learning progress.</p>
        <%= link_to "Create a Deck", new_deck_path, class: "btn btn--primary" %>
      </div>
    <% else %>
      <div id="decks-grid" class="deck-grid">
        <% @decks.each do |deck| %>
          <%= render "decks/deck_card", deck: deck, due_counts: @due_counts %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @popular_decks.any? %>
    <div class="section-header" style="margin-top: 2.5rem;">
      <h2>Explore Popular Decks</h2>
      <%= link_to "See all", explore_path, class: "section-header__link" %>
    </div>
    <div class="deck-grid">
      <%= render partial: "explore/deck_card", collection: @popular_decks, as: :deck %>
    </div>
  <% end %>
</div>
