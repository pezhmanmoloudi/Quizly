<% is_owner = Current.user&.id == deck.user_id %>
<% deck_unlocked = is_owner || Decks::AccessService.unlocked?(deck: deck, session: session) %>

<div id="<%= dom_id(deck) %>" class="explore-deck-card-wrap deck-row deck-row--with-cover">
  <div class="deck-row__cover">
    <%= render "decks/deck_cover", deck: deck, size: :md %>
  </div>
  <div class="deck-row__identity">
    <h3 class="deck-row__title-link-wrap">
      <a class="deck-row__title-link"
         href="<%= deck_path(deck) %>"
         data-turbo-frame="_top">
        <%= deck.name %>
      </a>
    </h3>
    <div class="deck-row__meta">
      <%= link_to user_path(deck.user),
            class: "deck-row__author-link",
            data: { turbo_frame: "_top" } do %>
        <div class="deck-row__avatar">
          <% if deck.user.show_avatar? %>
            <%= image_tag deck.user.avatar.variant(resize_to_fill: [22, 22]), alt: "" %>
          <% else %>
            <span class="deck-row__avatar-initials"><%= deck.user.display_name.first&.upcase %></span>
          <% end %>
        </div>
        <span class="deck-row__author"><%= deck.user.display_name %></span>
      <% end %>
      <span class="deck-row__meta-sep" aria-hidden="true">·</span>
      <span class="deck-row__time"><%= t("decks.deck_card.studied_time", time: localized_time_ago(deck.created_at)) %></span>
    </div>
    <% if deck.tag_list.any? %>
      <div class="deck-row__tags">
        <% deck.tag_list.first(3).each do |tag| %>
          <span class="deck-row__tag">#<%= tag %></span>
        <% end %>
        <% if deck.tag_list.size > 3 %>
          <span class="deck-row__tag"><%= t("decks.deck_card.more_tags", count: deck.tag_list.size - 3) %></span>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="deck-row__col deck-row__col--cards">
    <%= render "shared/icons/rectangle_stack", css_class: "deck-row__col-icon deck-row__col-icon--cards" %>
    <span class="deck-row__col-value"><%= localized_number(deck.flashcards_count) %></span>
    <span class="deck-row__col-label"><%= t("decks.deck_card.cards_label") %></span>
  </div>

  <div class="deck-row__col deck-row__col--due">
    <%= render "shared/icons/globe", css_class: "deck-row__col-icon deck-row__col-icon--lang" %>
    <span class="deck-row__col-value"><%= deck.language_code.present? ? deck.language_code.upcase : "—" %></span>
    <span class="deck-row__col-label"><%= t("explore.language_label") %></span>
  </div>

  <div class="deck-row__col deck-row__col--studied">
    <%= render "shared/icons/calendar_days", css_class: "deck-row__col-icon deck-row__col-icon--created" %>
    <span class="deck-row__col-value"><%= localized_time_ago(deck.created_at) %></span>
    <span class="deck-row__col-label"><%= t("explore.created_label") %></span>
  </div>

  <div class="deck-row__col deck-row__col--visibility">
    <% if deck.password_protected? %>
      <span class="deck-row__lock-icon deck-row__lock-icon--<%= deck_unlocked ? 'open' : 'closed' %>">
        <%= render "shared/icons/#{deck_unlocked ? 'lock_open' : 'lock'}", css_class: "deck-row__badge-icon" %>
      </span>
    <% end %>
    <span class="deck-row__visibility-badge deck-row__visibility-badge--public">
      <%= render "shared/icons/globe", css_class: "deck-row__badge-icon" %>
      <%= t("decks.show.public_badge") %>
    </span>
  </div>
</div>
