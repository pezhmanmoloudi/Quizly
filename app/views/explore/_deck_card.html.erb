<% locked = deck.password_protected? %>
<a class="deck-tile deck-tile--<%= locked ? "locked" : "public" %>"
   href="<%= deck_path(deck) %>"
   data-turbo-frame="_top">

  <div class="deck-tile__header">
    <h3 class="deck-tile__name"><%= deck.name %></h3>
    <% if locked %>
      <span class="deck-tile__protected-chip">
        <%= render "shared/icons/lock", css_class: "icon--xs" %>
        <%= t("explore.protected_badge") %>
      </span>
    <% else %>
      <span class="deck-tile__forks">
        <%= render "shared/icons/fork", css_class: "icon--sm" %>
        <%= deck.forks_count %>
      </span>
    <% end %>
  </div>

  <div class="deck-tile__body">
    <% if deck.description.present? %>
      <p class="deck-tile__description"><%= deck.description %></p>
    <% end %>
    <p class="deck-tile__meta">
      <%= t("decks.deck_card.count", count: deck.flashcards.size) %>
      <% if deck.language_code.present? %>
        · <span class="deck-tile__lang"><%= deck.language_code.upcase %></span>
      <% end %>
    </p>
    <% if deck.tag_list.any? %>
      <div class="deck-tile__tags">
        <% deck.tag_list.first(3).each do |tag| %>
          <span class="tag-badge"><%= tag %></span>
        <% end %>
      </div>
    <% end %>
    <% if locked && deck.flashcards.any? %>
      <ul class="deck-tile__preview-list">
        <% deck.flashcards.first(3).each do |card| %>
          <li class="deck-tile__preview-term"><%= card.front_content.truncate(60) %></li>
        <% end %>
      </ul>
    <% end %>
  </div>

  <div class="deck-tile__footer deck-tile__footer--<%= locked ? "locked" : "public" %>">
    <span class="deck-tile__author"><%= t("explore.by") %> <%= deck.user.display_name %></span>
    <% if locked %>
      <span class="deck-tile__unlock-cta"><%= t("explore.unlock_cta_inline") %> →</span>
    <% end %>
  </div>
</a>
