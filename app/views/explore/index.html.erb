<% content_for :title, t("explore.title") %>

<div class="page-container">
  <div class="page-header">
    <h1 class="page-title"><%= t("explore.title") %></h1>
    <p class="page-subtitle"><%= t("explore.subtitle") %></p>
  </div>

  <%= form_with url: explore_path, method: :get,
        data: { turbo_frame: "explore-results" },
        class: "explore-search" do |f| %>
    <%= f.search_field :q, value: @query,
          placeholder: t("explore.search_placeholder"),
          class: "form-control explore-search__input",
          aria: { label: t("explore.search_aria") } %>
  <% end %>

  <%= turbo_frame_tag "explore-results" do %>
    <% if @decks.any? %>
      <div class="deck-list">
        <%= render partial: "explore/deck_card", collection: @decks, as: :deck %>
      </div>
    <% elsif @query.present? %>
      <%= render "shared/empty_state",
            icon: "magnifying_glass",
            title: t("explore.empty_search_title", query: @query),
            description: t("explore.empty_search_description"),
            variant: :centered %>
    <% else %>
      <%= render "shared/empty_state",
            icon: "globe",
            title: t("explore.empty_title"),
            description: t("explore.empty_description"),
            variant: :centered %>
    <% end %>
  <% end %>
</div>
