<% content_for :title, "Explore" %>

<div class="page-container">
  <div class="page-header">
    <h1 class="page-title">Explore</h1>
    <p class="page-subtitle">Discover and fork public decks shared by the community.</p>
  </div>

  <%= form_with url: explore_path, method: :get,
        data: { turbo_frame: "explore-results" },
        class: "explore-search" do |f| %>
    <%= f.search_field :q, value: @query,
          placeholder: "Search decks…",
          class: "form-control explore-search__input",
          aria: { label: "Search public decks" } %>
  <% end %>

  <%= turbo_frame_tag "explore-results" do %>
    <% if @decks.any? %>
      <div class="deck-grid">
        <%= render partial: "explore/deck_card", collection: @decks, as: :deck %>
      </div>
    <% elsif @query.present? %>
      <div class="empty-state">
        <p>No decks found for "<%= @query %>".</p>
      </div>
    <% else %>
      <div class="empty-state">
        <p>No public decks yet. Be the first to share one.</p>
      </div>
    <% end %>
  <% end %>
</div>
