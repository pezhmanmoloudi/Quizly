<% content_for :title, t("decks.unlock.title") %>

<div class="container">
  <%= link_to deck_path(@deck), class: "unlock-back-link" do %>
    <%= t("decks.unlock.back_to_preview") %>
  <% end %>

  <div class="unlock-card">
    <div class="unlock-card__header">
      <%= render "shared/icons/lock", css_class: "icon--lg" %>
      <div>
        <h1 class="unlock-card__heading"><%= t("decks.unlock.title") %></h1>
        <p class="unlock-card__deck-name"><%= @deck.name %></p>
        <p class="unlock-card__meta">
          <%= t("explore.by") %> <%= @deck.user.display_name %>
          <% if @deck.flashcards.any? %>
            · <%= t("decks.deck_card.count", count: @deck.flashcards.count) %>
          <% end %>
          <% if @deck.language_code.present? %>
            · <%= @deck.language_code.upcase %>
          <% end %>
        </p>
      </div>
    </div>

    <%= form_with url: unlock_deck_path(@deck), method: :post do |f| %>
      <div class="form-group" data-controller="password-toggle">
        <%= f.label :password, t("decks.unlock.password_label") %>
        <div class="auth-input field-with-toggle">
          <%= f.password_field :password,
                class: "form-control #{"form-control--error" if flash[:alert]}",
                autofocus: true,
                autocomplete: "current-password",
                "aria-invalid": flash[:alert] ? "true" : nil,
                data: { password_toggle_target: "field" } %>
          <button type="button"
                  class="auth-input__toggle"
                  data-action="password-toggle#toggle"
                  aria-label="<%= t("sessions.toggle_password") %>">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 20 20" fill="currentColor">
              <path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/>
              <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/>
            </svg>
          </button>
        </div>
        <% if flash[:alert] %>
          <span class="field-error"><%= flash[:alert] %></span>
        <% end %>
      </div>

      <%= f.submit t("decks.unlock.submit"),
            class: "btn btn--primary btn--block",
            data: { turbo_submits_with: t("decks.unlock.submitting") } %>
    <% end %>

    <p class="unlock-card__help"><%= t("decks.unlock.help_text") %></p>
  </div>
</div>
