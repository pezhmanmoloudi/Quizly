<%= turbo_frame_tag "modal" do %>
  <div data-modal-target="dialog"
       class="modal-wrapper"
       role="dialog"
       aria-modal="true"
       aria-labelledby="delete-tag-title"
       hidden>
    <div class="modal-overlay" data-action="click->modal#closeOnBackdrop">
      <div class="modal-dialog modal-dialog--narrow">
        <div class="modal-dialog__header">
          <h2 id="delete-tag-title" class="modal-title">
            <%= t("folders.tags_modal.delete_title") %>
          </h2>
          <%= link_to tags_modal_folder_path(@folder),
                class: "modal-icon-close",
                aria: { label: t("shared.close") },
                data: { turbo_frame: "modal" } do %>
            <%= render "shared/icons/x_mark" %>
          <% end %>
        </div>

        <div class="modal-body">
          <p><%= t("folders.tags_modal.delete_body_html",
                   name: content_tag(:span, "\"#{@folder_tag.name}\"", class: "modal-tag-name")) %></p>
        </div>

        <%= form_with url: folder_tag_path(@folder, @folder_tag), method: :delete do %>
          <div class="modal-actions modal-actions--end">
            <%= link_to t("shared.cancel"),
                  tags_modal_folder_path(@folder),
                  class: "btn btn--secondary",
                  data: { turbo_frame: "modal" } %>
            <button type="submit" class="btn btn--danger">
              <%= t("folders.tags_modal.delete") %>
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
