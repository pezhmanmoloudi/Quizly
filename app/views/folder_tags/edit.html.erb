<%= turbo_frame_tag "modal" do %>
  <div data-modal-target="dialog"
       class="modal-wrapper"
       role="dialog"
       aria-modal="true"
       aria-labelledby="edit-tag-title"
       hidden>
    <div class="modal-overlay" data-action="click->modal#closeOnBackdrop">
      <div class="modal-dialog modal-dialog--narrow">
        <div class="modal-dialog__header">
          <h2 id="edit-tag-title" class="modal-title">
            <%= t("folders.tags_modal.edit_title") %>
          </h2>
          <%= link_to tags_modal_folder_path(@folder),
                class: "modal-icon-close",
                aria: { label: t("shared.close") },
                data: { turbo_frame: "modal" } do %>
            <%= render "shared/icons/x_mark" %>
          <% end %>
        </div>

        <% if @folder_tag.errors.any? %>
          <p class="form-error"><%= @folder_tag.errors.full_messages.first %></p>
        <% end %>

        <%= form_with model: @folder_tag, url: folder_tag_path(@folder, @folder_tag), method: :patch do |f| %>
          <div class="new-tag-modal__field">
            <label class="new-tag-modal__label" for="edit-tag-name">
              <%= t("folders.tags_modal.name_label") %>
            </label>
            <%= f.text_field :name,
                  id: "edit-tag-name",
                  class: "form-control",
                  maxlength: 60,
                  autofocus: true,
                  data: {
                    action: "input->modal#enableIfChanged",
                    original_value: @folder_tag.name_was || @folder_tag.name
                  } %>
          </div>

          <div class="modal-actions modal-actions--end">
            <%= link_to t("shared.cancel"),
                  tags_modal_folder_path(@folder),
                  class: "btn btn--secondary",
                  data: { turbo_frame: "modal" } %>
            <button type="submit" class="btn btn--primary"
                    disabled data-modal-target="submitButton">
              <%= t("folders.tags_modal.rename_save") %>
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
