<% content_for :title, "Edit Card — #{@flashcard.deck.name}" %>

<div class="card-editor-page">
  <header class="card-editor-header">
    <%= link_to deck_path(@flashcard.deck), class: "card-editor-header__back",
          aria: { label: "Back to #{@flashcard.deck.name}" } do %>
      ← <span class="card-editor-header__deck-name"><%= @flashcard.deck.name %></span>
    <% end %>
    <%= submit_tag "Save Card →", form: "flashcard-form", class: "btn btn--primary" %>
  </header>

  <div class="card-editor-body">
    <%= render "form", flashcard: @flashcard, url: flashcard_path(@flashcard) %>
  </div>
</div>
