<%= form_with model: flashcard, url: url, id: "flashcard-form" do |f| %>
  <div class="card-editor-card">
    <div class="card-editor-panels">
      <div class="card-editor-panel">
        <span class="card-editor-panel__label">Term</span>
        <%= f.text_area :front_content,
              placeholder: "Enter term",
              class: "card-editor-field",
              rows: 7,
              aria: { label: "Term" } %>
      </div>
      <div class="card-editor-panel">
        <span class="card-editor-panel__label">Definition</span>
        <%= f.text_area :back_content,
              placeholder: "Enter definition",
              class: "card-editor-field",
              rows: 7,
              aria: { label: "Definition" } %>
      </div>
    </div>

    <div class="card-editor-footer">
      <% if flashcard.errors.any? %>
        <div class="form-errors" role="alert">
          <% flashcard.errors.full_messages.each do |msg| %>
            <p><%= msg %></p>
          <% end %>
        </div>
      <% end %>
      <%= f.submit "Save Card →", class: "btn btn--primary btn--lg" %>
    </div>
  </div>
<% end %>
