<%= form_with model: flashcard, url: url, id: "flashcard-form", multipart: true do |f| %>

  <div class="cards-editor-body">
    <div class="card-rows-list">
      <div class="card-row">

        <div class="card-row__header">
          <span class="card-row__number">1</span>
        </div>

        <div class="card-row__panels">

          <%# ── Term panel ── %>
          <div class="card-row__panel">
            <span class="card-editor-panel__label"><%= t("flashcards.form.term_label") %></span>
            <%= f.text_area :front_content,
                  placeholder: t("flashcards.form.term_placeholder"),
                  class: "card-editor-field",
                  rows: 3,
                  aria: { label: t("flashcards.form.term_label") } %>
            <%= render "shared/language_selector",
                  languages:     Language::ALL_LANGUAGES,
                  selected:      flashcard.front_language.to_s,
                  input_name:    "flashcard[front_language]",
                  placeholder:   t("decks.card_row.select_language"),
                  autosubmit:    false,
                  wrapper_class: "lang-dropdown--compact" %>
          </div>

          <%# ── Definition panel ── %>
          <div class="card-row__panel">
            <span class="card-editor-panel__label"><%= t("flashcards.form.definition_label") %></span>
            <%= f.text_area :back_content,
                  placeholder: t("flashcards.form.definition_placeholder"),
                  class: "card-editor-field",
                  rows: 3,
                  aria: { label: t("flashcards.form.definition_label") } %>
            <%= render "shared/language_selector",
                  languages:     Language::ALL_LANGUAGES,
                  selected:      flashcard.back_language.to_s,
                  input_name:    "flashcard[back_language]",
                  placeholder:   t("decks.card_row.select_language"),
                  autosubmit:    false,
                  wrapper_class: "lang-dropdown--compact" %>
          </div>

          <%# ── Image panel ── %>
          <div class="card-row__panel card-row__image-panel">
            <% has_image = flashcard.image&.attached? %>
            <img class="card-row__image-preview"
                 src="<%= has_image ? rails_blob_path(flashcard.image, disposition: "inline") : "" %>"
                 alt=""
                 <%= "hidden" unless has_image %>>
            <label class="card-row__image-btn"
                   aria-label="<%= t("decks.card_row.image") %>">
              <%= t("decks.card_row.image") %>
              <%= f.file_field :image, accept: "image/*",
                    class: "card-row__image-input", hidden: true %>
            </label>
          </div>

        </div><%# card-row__panels %>
      </div><%# card-row %>
    </div><%# card-rows-list %>
  </div><%# cards-editor-body %>

  <% if flashcard.errors.any? %>
    <div class="cards-editor-footer">
      <div class="form-errors" role="alert">
        <% flashcard.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="cards-editor-footer">
    <%= f.submit t("flashcards.form.save"), class: "btn btn--primary" %>
  </div>

<% end %>
