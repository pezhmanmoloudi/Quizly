<%= form_with model: flashcard, url: url, id: "flashcard-form" do |f| %>
  <div class="card-editor-card">
    <div class="card-editor-panels">
      <div class="card-editor-panel">
        <span class="card-editor-panel__label"><%= t("flashcards.form.term_label") %></span>
        <%= f.text_area :front_content,
              placeholder: t("flashcards.form.term_placeholder"),
              class: "card-editor-field",
              rows: 7,
              aria: { label: t("flashcards.form.term_label") } %>
      </div>
      <div class="card-editor-panel">
        <span class="card-editor-panel__label"><%= t("flashcards.form.definition_label") %></span>
        <%= f.text_area :back_content,
              placeholder: t("flashcards.form.definition_placeholder"),
              class: "card-editor-field",
              rows: 7,
              aria: { label: t("flashcards.form.definition_label") } %>
      </div>
    </div>

    <div class="card-editor-footer">
      <% if flashcard.errors.any? %>
        <div class="form-errors" role="alert">
          <% flashcard.errors.full_messages.each do |msg| %>
            <p><%= msg %></p>
          <% end %>
        </div>
      <% end %>
      <%= f.submit t("flashcards.form.save"), class: "btn btn--primary btn--lg" %>
    </div>
  </div>
<% end %>
