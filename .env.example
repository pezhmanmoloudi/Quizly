# Copy this file to .env and fill in values.
# .env is gitignored and never committed.
# docker-compose.yml reads .env automatically from the project root.

# Rails master key — decrypts config/credentials.yml.enc
# NOT required for local development. In development, a secret key is
# auto-generated in tmp/development_secret.txt on first boot.
# Required for production deployment only (set via Kamal secrets or CI).
# RAILS_MASTER_KEY=
