# Copy this file to .env and fill in the values marked REQUIRED.
# .env is gitignored and must never be committed to version control.
# docker-compose.yml reads .env automatically from the project root.

# ─── REQUIRED ───────────────────────────────────────────────────────
# Rails master key — decrypts config/credentials.yml.enc
# Get this value from config/master.key (ask a teammate or use your secrets manager).
RAILS_MASTER_KEY=your_master_key_here

# ─── GOOGLE OAUTH ───────────────────────────────────────────────────
# Enables the "Continue with Google" button on the login page.
# Create credentials at console.cloud.google.com → APIs & Services → Credentials.
#
# Docker (port 3001 on host):   http://localhost:3001/auth/google_oauth2/callback
# Direct (non-Docker, port 3000): http://localhost:3000/auth/google_oauth2/callback
#
# Add the matching URL as an Authorized Redirect URI in Google Console.
# GOOGLE_REDIRECT_URI must match exactly one of those registered URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google_oauth2/callback

# ─── OPTIONAL TUNING ────────────────────────────────────────────────
# Run the Solid Queue job processor inside Puma (no separate worker process needed).
SOLID_QUEUE_IN_PUMA=true

# Thread pool size. Match to available database connections.
RAILS_MAX_THREADS=5

# Log verbosity: debug | info | warn | error | fatal
# RAILS_LOG_LEVEL=debug

# ─── DOCKER ONLY (optional overrides) ───────────────────────────────
# These default values match docker-compose.yml and work out of the box.
# Override only if you need to connect to a different PostgreSQL instance.
# POSTGRES_USER=quizly
# POSTGRES_PASSWORD=quizly_dev_password
# POSTGRES_DB=quizly_development
# DATABASE_URL=postgresql://quizly:quizly_dev_password@db:5432/quizly_development

# ─── PRODUCTION ONLY ────────────────────────────────────────────────
# Hostname used in Action Mailer URL generation (e.g. password reset links).
# REQUIRED in production — app will refuse to boot without this.
MAILER_HOST=quizly.app

# REQUIRED before launch — set to your domain for DNS rebinding protection.
# Used in config/environments/production.rb config.hosts.
APP_HOST=quizly.app
