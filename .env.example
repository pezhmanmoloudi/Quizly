# Copy this file to .env and fill in the values marked REQUIRED.
# .env is gitignored and must never be committed to version control.
# docker-compose.yml reads .env automatically from the project root.

# ─── REQUIRED ───────────────────────────────────────────────────────
# Rails master key — decrypts config/credentials.yml.enc
# Get this value from config/master.key (ask a teammate or use your secrets manager).
RAILS_MASTER_KEY=your_master_key_here

# ─── DOCKER DEVELOPMENT ─────────────────────────────────────────────
# PostgreSQL credentials used by docker compose.
# Safe defaults are built into docker-compose.yml; only set these to override.
POSTGRES_USER=quizly
POSTGRES_PASSWORD=quizly_dev_password
POSTGRES_DB=quizly_development

# Redis connection — used by Solid Queue and Solid Cache inside Docker.
# Not required for local non-Docker development (SQLite, no Redis needed).
REDIS_URL=redis://redis:6379/0

# ─── OPTIONAL TUNING ────────────────────────────────────────────────
# Run the Solid Queue job processor inside Puma (no separate worker process needed).
SOLID_QUEUE_IN_PUMA=true

# Thread pool size. Match to available database connections.
RAILS_MAX_THREADS=5

# Log verbosity: debug | info | warn | error | fatal
# RAILS_LOG_LEVEL=debug

# ─── PRODUCTION ONLY ────────────────────────────────────────────────
# Hostname used in Action Mailer URL generation (e.g. password reset links).
# REQUIRED in production — app will refuse to boot without this.
MAILER_HOST=quizly.app
