#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# Ensure all gems from Gemfile.lock are installed into the bundle_cache volume.
# Needed because the volume mount shadows the gems baked into the image layer.
bundle check || bundle install

# If running the rails server then create or migrate existing database.
# Match any invocation that contains "rails server" regardless of surrounding
# flags (e.g. `bin/rails server -b 0.0.0.0` used in development).
if echo "$*" | grep -q "rails server"; then
  ./bin/rails db:prepare
fi

exec "${@}"
